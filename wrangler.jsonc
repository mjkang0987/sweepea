{
  "name": "sweepea",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 화면(Astro) + 매일 정리 예약 작업(src/jobs/cleanup.ts)
  "main": "./src/worker.ts",
  // 매일 18:17 UTC = 서울 새벽 3:17
  "triggers": { "crons": ["17 18 * * *"] },
  // 사진·영상 파일. 키: <가족방 id>/<사진 id>/<view|thumb|poster>
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sweepea-media" }],
  // 대표 주소 sweepea.co.kr(가비아 등록, DNS Cloudflare). www는 미들웨어가 같은 경로로 넘긴다. workers.dev 주소도 계속 열림(이미 보낸 링크)
  "routes": [
    { "pattern": "sweepea.co.kr", "custom_domain": true },
    { "pattern": "www.sweepea.co.kr", "custom_domain": true }
  ],
  // 가족 공유 링크는 늘 대표 주소로(workers.dev로 열어도). 대시보드에 둔 다른 값은 배포 때 지우지 않는다
  "vars": { "SITE_ORIGIN": "https://sweepea.co.kr" },
  "keep_vars": true
}
