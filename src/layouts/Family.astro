---
import Base from './Base.astro';
import '../styles/family.css';
import { readTextSize } from '../lib/pass';

interface Props {
  title: string;
  /** 쿠키 대신 이 크기로(이름으로 정한 크기를 아직 저장하지 않았을 때) */
  size?: 'base' | 'large' | 'xlarge';
  /** 넓은 화면에서 넓게 쓸 화면(앨범·크게 보기) */
  wide?: boolean;
}

const { title, wide } = Astro.props;
const size = Astro.props.size ?? readTextSize(Astro.cookies);
---

<Base title={title} size={size}>
  <main class:list={['sp-f', wide && 'sp-f--wide']}>
    <slot />
  </main>
</Base>
