---
import Base from './Base.astro';
import '../styles/parent.css';

interface Props {
  title: string;
  /** 아래 탭(앨범·설정)을 보일 화면이면 지금 탭 */
  tab?: 'home' | 'settings';
}
const { title, tab } = Astro.props;
---

<Base title={title}>
  <main class:list={['sp-p', tab && 'sp-p--tabbed']}>
    <slot />
  </main>
  {
    tab && (
      <nav class="sp-p__tabs" aria-label="메뉴">
        <a class="sp-p__tab" href="/home" aria-current={tab === 'home' ? 'page' : undefined}>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M4 17l5-4 4 3 3-2 4 3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
          앨범
        </a>
        <a class="sp-p__tab" href="/settings" aria-current={tab === 'settings' ? 'page' : undefined}>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          설정
        </a>
      </nav>
    )
  }
</Base>
