---
// 내 캐릭터 고르기 칸(110, 디자인 AvatarPick·AvatarPickParent): 네이티브 라디오(고르지 않음 + 45개), 그림이 라벨(이름 '캐릭터 N')
import { AVATARS, avatarSrc } from '../lib/avatar';

interface Props {
  /** '고르지 않음' 칸에 보일 이름 첫 글자 */
  initial: string;
  current: number | null;
  /** 엄빠 화면(5칸, 56px) */
  small?: boolean;
}
const { initial, current, small } = Astro.props;
const px = small ? 56 : 72;
---

<fieldset class="sp-av">
  <legend class="sp-vh">내 캐릭터</legend>
  <div class:list={['sp-av__grid', small && 'sp-av__grid--small']}>
    <label class="sp-av__item">
      <input class="sp-av__input" type="radio" name="avatar" value="" checked={current === null} />
      <span class="sp-av__face sp-av__face--none" aria-hidden="true">{initial}</span>
      <span class="sp-av__check" aria-hidden="true"><svg class="sp-av__check-icon" width="18" height="18" viewBox="0 0 24 24" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
      <span class="sp-av__none">고르지 않음</span>
    </label>
    {
      AVATARS.map((n) => (
        <label class="sp-av__item">
          <input class="sp-av__input" type="radio" name="avatar" value={n} checked={current === n} />
          <img class="sp-av__face" src={avatarSrc(n)} alt={`캐릭터 ${n}`} width={px} height={px} loading={n > 24 ? 'lazy' : undefined} decoding="async" />
          <span class="sp-av__check" aria-hidden="true"><svg class="sp-av__check-icon" width="18" height="18" viewBox="0 0 24 24" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
        </label>
      ))
    }
  </div>
</fieldset>
