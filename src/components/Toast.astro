---
// 화면 아래에 떠서 잠시 뒤 사라지는 안내 카드(디자인 GrandHome·ToastSent·ToastError). 아이콘 없이 글자만(사용자 2026-10-27)
interface Props {
  text: string;
  tone?: 'ok' | 'error';
  /** 글자 칸 id(시트 설명 연결용) */
  id?: string;
  /** 페이지가 열릴 때 초점을 옮겨 바로 읽히게(스크립트 없는 폼 결과) */
  focus?: boolean;
}
const { text, tone = 'ok', id, focus } = Astro.props;
---

<p class:list={['sp-toast', tone === 'error' && 'sp-toast--error']} role={tone === 'error' ? 'alert' : 'status'} tabindex={focus ? -1 : undefined} autofocus={focus}>
  <span class="sp-toast__text" id={id}>{text}</span>
</p>
