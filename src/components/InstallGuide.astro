---
// 가족 앨범 위 '홈 화면에 두세요' 안내(페이지 흐름 안의 판, 앨범을 가리지 않는다). 기기마다 단계가 다르고,
// 앱 안 브라우저(카톡 등)에서는 엄마아빠에게 부탁한다. 홈 화면 아이콘으로 열었으면 CSS(display-mode: standalone)로 숨긴다.
// 버튼은 스크립트가 그 자리에서 보내고 판만 치운다(스크립트 없으면 폼으로 보내고 앨범을 다시 그림)
import { installPlatform } from '../lib/install';

interface Props {
  /** 아이를 부르는 꼴(하린이) */
  kid: string;
  /** 안내 쿠키 값(알겠어요·다음에·부탁함). 있으면 안내를 보이지 않는다 */
  state: string | undefined;
  /** 방금 부탁했으면 알림 */
  asked: boolean;
}
const { kid, state, asked } = Astro.props;
const platform = installPlatform(Astro.request.headers.get('user-agent') ?? '');
const back = Astro.url.pathname + Astro.url.search;
const steps =
  platform === 'ios' ? [['아래', '공유', '누르기'], ['', '홈 화면에 추가', '누르기'], ['오른쪽 위', '추가', '누르기']] :
  platform === 'android' ? [['오른쪽 위', '⋮', '누르기'], ['', '홈 화면에 추가', '누르기'], ['', '추가', '누르기']] :
  [];
---

{(asked || (!state && platform === 'inapp')) && <p class="sp-f__box sp-f__box--pea sp-f__install-done" id="install-done" role="status" tabindex="-1" autofocus={asked} hidden={!asked}>엄마아빠에게 부탁했어요. 엄마아빠가 스위피를 열면 보여요.</p>}
{
  !state && platform !== 'other' && (
    <aside class="sp-f__install" id="install" aria-labelledby="install-title">
      <h2 class="sp-f__install-title" id="install-title">홈 화면에 두세요</h2>
      <p class="sp-f__install-lead">다음부터 아이콘만 누르면 {kid} 사진이 바로 열려요.</p>
      <form class="sp-f__form" method="post" action="/install">
        <input type="hidden" name="back" value={back} />
        {
          platform === 'inapp' ? (
            <>
              <p class="sp-f__text">카톡 같은 앱 안에서는 홈 화면에 둘 수 없어요. 엄마아빠에게 부탁하면 문자로 바로 둘 수 있게 보내 드려요.</p>
              <button class="sp-f__btn" type="submit" name="do" value="ask">엄마아빠에게 부탁하기</button>
            </>
          ) : (
            <>
              <ol class="sp-f__install-steps">
                {steps.map(([pre, key, post], i) => (
                  <li class="sp-f__install-step">
                    <span class="sp-f__install-num" aria-hidden="true">{i + 1}</span>
                    <span>{pre && `${pre} `}<strong>{key}</strong> {post}</span>
                  </li>
                ))}
              </ol>
              <button class="sp-f__btn" type="submit" name="do" value="ok">알겠어요</button>
            </>
          )
        }
        <button class="sp-f__btn sp-f__btn--quiet" type="submit" name="do" value="later">다음에 할게요</button>
      </form>
    </aside>
  )
}

<script>
  const box = document.getElementById('install');
  const form = box?.querySelector('form');
  let busy = false;
  form?.addEventListener('submit', async (e) => {
    const by = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    e.preventDefault();
    if (busy || !box) return;
    busy = true;
    const body = new FormData(form);
    if (by) body.append(by.name, by.value);
    try {
      const r = await fetch(form.action, { method: 'POST', body, credentials: 'same-origin', headers: { 'x-sp-inplace': '1' } });
      // 로그인이 풀렸으면 다시 들어오기로, 부탁할 곳이 없으면(409) 폼으로 보낼 때처럼 판을 그대로 둔다
      if (r.status === 401) return location.assign('/');
      if (r.status === 409) return;
      if (!r.ok) throw new Error(String(r.status));
      // 판 바로 뒤에서 처음 누를 수 있는 것(스크립트 태그 같은 건 건너뜀)
      let el = box.nextElementSibling;
      let next: HTMLElement | null = null;
      while (el && !(next = el.matches('a, button') ? (el as HTMLElement) : el.querySelector<HTMLElement>('a, button'))) el = el.nextElementSibling;
      box.remove();
      const done = document.getElementById('install-done');
      if (by?.value === 'ask' && done) {
        done.hidden = false;
        done.focus();
      } else next?.focus();
    } catch {
      // 연결이 끊기거나 서버 오류면 폼으로 다시 보낸다(누른 버튼 값을 붙여서)
      if (by) form.appendChild(Object.assign(document.createElement('input'), { type: 'hidden', name: by.name, value: by.value }));
      form.submit();
    } finally {
      busy = false;
    }
  });
</script>
