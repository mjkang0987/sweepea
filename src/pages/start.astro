---
// 부모 소개 3장(처음 한 번). 링크로 넘김(?p=1~3), 건너뛰기·시작하기는 로그인으로
import Parent from '../layouts/Parent.astro';
import { INTRO_COOKIE } from '../lib/parent';
import { currentParent } from '../lib/pass';

if (await currentParent(Astro.cookies)) return Astro.redirect('/home');
const p = Math.min(3, Math.max(1, Number(Astro.url.searchParams.get('p')) || 1));
// 소개를 한 번 보면 다음부턴 로그인 화면으로 바로
Astro.cookies.set(INTRO_COOKIE, '1', { path: '/', maxAge: 400 * 24 * 3600, sameSite: 'lax', secure: import.meta.env.PROD });
const pages = [
  { title: '카톡으로 보내면 끝', text: ['가족은 앱 설치도, 가입도 없이', '링크만 누르면 바로 보세요'] },
  { title: '누가 볼지는 내가 정해요', text: ['외가·친가처럼 나눠 보낼 수 있고,', '처음 들어오는 사람은 내가 승인해요'] },
  { title: '하트와 한마디가 나에게 와요', text: ['사진은 사라지지 않고 쌓이고,', '콩이도 아이 나이에 맞춰 함께 자라요'] },
];
const cur = pages[p - 1];
---

<Parent title={`${cur.title} · 스위피`} savebar>
  <div class="sp-p__skip-row">{p < 3 && <a class="sp-p__skip" href="/login">건너뛰기</a>}</div>
  <section class="sp-p__intro" aria-labelledby="intro-title">
    <div class="sp-p__intro-art" aria-hidden="true">
      {
        p === 1 ? (
          <div class="sp-p__mock">
            <div class="sp-p__mock-photo" />
            <p class="sp-p__mock-title">하린이 새 사진 12장</p>
            <p class="sp-p__mock-sub">설치 없이 바로 볼 수 있어요</p>
            <span class="sp-p__mock-btn">앨범 보기</span>
          </div>
        ) : p === 2 ? (
          <div class="sp-p__mock">
            <p class="sp-p__mock-sub">보낼 가족</p>
            <p class="sp-p__mock-chips"><span class="sp-p__mock-chip sp-p__mock-chip--on">✓ 외가</span><span class="sp-p__mock-chip">친가</span></p>
            <p class="sp-p__mock-row"><span class="sp-p__mock-av">큰</span><span class="sp-p__mock-who"><b>큰이모</b><br />들어오려고 해요</span><span class="sp-p__mock-ok">승인</span></p>
          </div>
        ) : (
          <div class="sp-p__mock">
            <img src="/kongi.svg" width="96" height="96" alt="" class="sp-p__mock-kongi" />
            <p class="sp-p__mock-line"><b>외할머니</b> 하트를 보냈어요</p>
            <p class="sp-p__mock-line"><b>외할아버지</b> "아이고 많이 컸네"</p>
          </div>
        )
      }
    </div>
    <h1 class="sp-p__intro-title" id="intro-title">{cur.title}</h1>
    <p class="sp-p__intro-text">{cur.text[0]}<br />{cur.text[1]}</p>
  </section>
  <p class="sp-p__dots sp-p__dots--end">
    <span class="sp-vh">{p} / 3</span>
    {[1, 2, 3].map((n) => <span class:list={['sp-p__dot', n === p && 'sp-p__dot--on']} aria-hidden="true" />)}
  </p>
  <div class="sp-p__bottom sp-p__savebar">
    <a class="sp-p__btn" href={p < 3 ? `/start?p=${p + 1}` : '/login'}>{p < 3 ? '다음' : '시작하기'}</a>
  </div>
</Parent>
