---
// 가족 비밀번호: GET으로 이름을 받아 보여 주고, POST로 입장 함수를 부른다
import Family from '../../../layouts/Family.astro';
import Notice from '../../../components/Notice.astro';
import { getBackend } from '../../../lib/backend';
import { chosenTextSize, currentPass, ensurePass, sizeForName, writeTextSize, type TextSize } from '../../../lib/pass';
import { NOTICES, type NoticeKey } from '../../../lib/notices';

const code = Astro.params.code ?? '';
if (!/^[A-Za-z0-9]{8}$/.test(code)) return Astro.redirect('/');
const backend = getBackend();
const isPost = Astro.request.method === 'POST';
let src: FormData | URLSearchParams = Astro.url.searchParams;
if (isPost) {
  try {
    src = await Astro.request.formData();
  } catch {
    return Astro.redirect(`/i/${code}`, 303);
  }
}
// 익명 출입증은 비밀번호를 낼 때(아래 enter 직전)만 만든다. 여기선 있으면 쓴다
const pass = await currentPass(Astro.cookies);
const memberId = String(src.get('m') ?? '') || undefined;
const newName = memberId ? undefined : String(src.get('name') ?? '').trim() || undefined;
const groupId = memberId ? undefined : String(src.get('g') ?? '') || undefined;
const back = `/i/${code}`;
if (!memberId && (!newName || newName.length > 12)) return Astro.redirect(`${back}?e=name`);

const info = await backend.entryInfo(pass, code);
if (info.result !== 'ok') return Astro.redirect(back);
const group = info.groups.find((g) => (memberId ? g.members.some((m) => m.id === memberId) : g.id === groupId));
const member = group?.members.find((m) => m.id === memberId);
if (!group || (memberId && !member)) return Astro.redirect(back);
const name = member?.name ?? newName!;
const pickedNow = String(src.get('size') ?? '');
const size = sizeForName(name, ['base', 'large', 'xlarge'].includes(pickedNow) ? (pickedNow as TextSize) : chosenTextSize(Astro.cookies), info.text_size_mode);

let notice: NoticeKey | null = null;
let error: string | null = null;
if (isPost) {
  const password = String(src.get('password') ?? '').replace(/\D/g, '');
  if (password.length !== 4) {
    error = '숫자 4자리를 눌러 주세요.';
  } else {
    const r = await backend.enter(await ensurePass(Astro.cookies), { code, password, memberId, newName, groupId });
    switch (r.result) {
      case 'ok':
      case 'pending':
      case 'needs_approval':
        // 들어온 뒤에는 이 크기로 고정(앨범에서 바꿀 수 있다)
        writeTextSize(Astro.cookies, size);
        return Astro.redirect(r.result === 'ok' ? '/album' : '/wait', 303);
      case 'wrong_password':
        error = r.attempts % 3 === 0 ? '비밀번호가 맞지 않아요. 30초 쉬었다가 다시 눌러 주세요.' : '비밀번호가 맞지 않아요. 힌트를 보고 다시 눌러 주세요.';
        break;
      case 'locked':
        error = `조금 쉬었다가 ${r.retry_after}초 뒤에 다시 눌러 주세요.`;
        break;
      case 'name_taken':
        error = `'${name}' 이름은 이미 있어요. 다른 이름을 써 주세요.`;
        break;
      case 'expired':
      case 'closed':
      case 'revoked':
      case 'not_found':
        notice = r.result;
        break;
      default:
        // bad_request: 이 주소로 고를 수 없는 이름
        error = '이 주소로는 들어갈 수 없어요. 엄마아빠에게 물어봐 주세요.';
    }
  }
} else {
  // 라디오로 직접 고른 크기만 저장한다(이름으로 정한 크기는 저장하지 않아야 다음에 다른 이름을 고를 때 다시 정해진다)
  // 가족방 설정으로 미리 골라져 온 값을 그대로 낸 것이면 저장하지 않는다(나중에 설정이 바뀌면 따라가게)
  const picked = String(src.get('size') ?? '');
  const preset = chosenTextSize(Astro.cookies) === undefined && info.text_size_mode !== 'relation' && picked === info.text_size_mode;
  if (['base', 'large', 'xlarge'].includes(picked) && !preset) writeTextSize(Astro.cookies, picked as TextSize);
}
---

<Family size={size} title={notice ? NOTICES[notice].title : error ? `다시 눌러 주세요 · ${name} 맞으세요?` : `${name} 맞으세요?`}>
  {
    notice ? (
      <Notice {...NOTICES[notice]} />
    ) : (
      <>
        <div class="sp-f__head">
          <h1 class="sp-f__title">{name} 맞으세요?</h1>
          <p class="sp-f__lead">가족 비밀번호 4자리를 눌러 주세요</p>
        </div>
        <form class="sp-f__form" method="post">
          {memberId && <input type="hidden" name="m" value={memberId} />}
          {newName && <input type="hidden" name="name" value={newName} />}
          {groupId && <input type="hidden" name="g" value={groupId} />}
          {group.hint && <p class="sp-f__box sp-f__box--pea">힌트 · {group.hint}</p>}
          <div class="sp-f__group">
            <label class="sp-f__label" for="pw">
              가족 비밀번호
            </label>
            <input
              class="sp-f__input sp-f__input--pin"
              id="pw"
              name="password"
              type="password"
              inputmode="numeric"
              pattern="[0-9]{4}"
              maxlength="4"
              autocomplete="off"
              autofocus
              required
              aria-describedby={error ? 'pw-error' : undefined}
              aria-invalid={error ? 'true' : undefined}
            />
            <p class="sp-f__box sp-f__box--danger" id="pw-error" role="alert" hidden={!error}>
              {error}
            </p>
          </div>
          <div class="sp-f__bottom">
            <button class="sp-f__btn" type="submit">
              들어가기
            </button>
            <a class="sp-f__btn sp-f__btn--quiet" href={back}>
              다른 이름 고르기
            </a>
          </div>
        </form>
      </>
    )
  }
</Family>
