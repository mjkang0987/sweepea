---
// 가족 비밀번호: GET으로 이름을 받아 보여 주고, POST로 입장 함수를 부른다
import Family from '../../../layouts/Family.astro';
import Notice from '../../../components/Notice.astro';
import { getBackend } from '../../../lib/backend';
import { ensurePass, sizeForName, writeTextSize, type TextSize } from '../../../lib/pass';
import { NOTICES, type NoticeKey } from '../../../lib/notices';

const code = Astro.params.code ?? '';
if (!/^[A-Za-z0-9]{8}$/.test(code)) return Astro.redirect('/');
const backend = getBackend();
const pass = await ensurePass(Astro.cookies);

const isPost = Astro.request.method === 'POST';
const src = isPost ? await Astro.request.formData() : Astro.url.searchParams;
const memberId = String(src.get('m') ?? '') || undefined;
const newName = memberId ? undefined : String(src.get('name') ?? '').trim() || undefined;
const groupId = memberId ? undefined : String(src.get('g') ?? '') || undefined;
const back = `/i/${code}`;
if (!memberId && !newName) return Astro.redirect(back);

const info = await backend.entryInfo(pass, code);
if (info.result !== 'ok') return Astro.redirect(back);
const group = info.groups.find((g) => (memberId ? g.members.some((m) => m.id === memberId) : g.id === groupId));
const member = group?.members.find((m) => m.id === memberId);
if (!group || (memberId && !member)) return Astro.redirect(back);
const name = member?.name ?? newName!;

let notice: NoticeKey | null = null;
let error: string | null = null;
if (isPost) {
  const password = String(src.get('password') ?? '').replace(/\D/g, '');
  if (password.length !== 4) {
    error = '숫자 4자리를 눌러 주세요.';
  } else {
    const r = await backend.enter(pass, { code, password, memberId, newName, groupId });
    switch (r.result) {
      case 'ok':
        return Astro.redirect('/album', 303);
      case 'pending':
      case 'needs_approval':
        return Astro.redirect('/wait', 303);
      case 'wrong_password':
        error = r.attempts % 3 === 0 ? '비밀번호가 맞지 않아요. 30초 쉬었다가 다시 눌러 주세요.' : '비밀번호가 맞지 않아요. 힌트를 보고 다시 눌러 주세요.';
        break;
      case 'locked':
        error = `조금 쉬었다가 ${r.retry_after}초 뒤에 다시 눌러 주세요.`;
        break;
      case 'name_taken':
        error = `'${name}' 이름은 이미 있어요. 다른 이름을 써 주세요.`;
        break;
      case 'expired':
      case 'closed':
      case 'revoked':
      case 'not_found':
        notice = r.result;
        break;
      default:
        return Astro.redirect(back);
    }
  }
} else {
  const size = String(src.get('size') ?? 'base') as TextSize;
  writeTextSize(Astro.cookies, sizeForName(name, ['base', 'large', 'xlarge'].includes(size) ? size : 'base', false));
}
---

<Family title={notice ? NOTICES[notice].title : `${name} 맞으세요?`}>
  {
    notice ? (
      <Notice {...NOTICES[notice]} />
    ) : (
      <>
        <div class="sp-f__head">
          <h1 class="sp-f__title">{name} 맞으세요?</h1>
          <p class="sp-f__lead">가족 비밀번호 4자리를 눌러 주세요</p>
        </div>
        <form class="sp-f__form" method="post">
          {memberId && <input type="hidden" name="m" value={memberId} />}
          {newName && <input type="hidden" name="name" value={newName} />}
          {groupId && <input type="hidden" name="g" value={groupId} />}
          {group.hint && <p class="sp-f__box sp-f__box--pea">힌트 · {group.hint}</p>}
          <div class="sp-f__group">
            <label class="sp-f__label" for="pw">
              가족 비밀번호
            </label>
            <input
              class="sp-f__input sp-f__input--pin"
              id="pw"
              name="password"
              type="password"
              inputmode="numeric"
              pattern="[0-9]{4}"
              maxlength="4"
              autocomplete="off"
              required
              aria-describedby={error ? 'pw-error' : undefined}
              aria-invalid={error ? 'true' : undefined}
            />
            <p class="sp-f__box sp-f__box--danger" id="pw-error" role="alert" hidden={!error}>
              {error}
            </p>
          </div>
          <div class="sp-f__bottom">
            <button class="sp-f__btn" type="submit">
              들어가기
            </button>
            <a class="sp-f__btn sp-f__btn--quiet" href={back}>
              다른 이름 고르기
            </a>
          </div>
        </form>
      </>
    )
  }
</Family>
