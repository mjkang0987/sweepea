---
// 운영자 가족방 상세(164, 디자인 OpsFamily): 이 집 숫자만. 사람·그룹은 이름 없이 들어온 순서 번호, 사진·한마디 내용 없음
import Ops from '../../../layouts/Ops.astro';
import OpsBars from '../../../components/OpsBars.astro';
import OpsPeriod from '../../../components/OpsPeriod.astro';
import { getBackend } from '../../../lib/backend';
import { sizeLabel } from '../../../lib/familyAdmin';
import { dayLabel, nf, parsePeriod, periodQuery, shortId, withPeriod } from '../../../lib/ops';
import { opsGate } from '../../../lib/opsgate';
import { seoulDate, seoulToday } from '../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
if (!(await opsGate(Astro.request, Astro.cookies))) return Astro.rewrite('/404');
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.rewrite('/404');
const today = seoulToday();
const period = parsePeriod(Astro.url.searchParams, today);
const f = await getBackend().opsFamily(id, period.from, period.to);
if (!f) return Astro.rewrite('/404');
const pct = f.quota ? Math.min(100, Math.round((f.bytes / f.quota) * 100)) : 0;
const people = [
  ...f.parents.map((p) => ({ who: `엄빠 ${p.no}`, group: '엄빠', status: '—', warn: false, visits: p.visits, last: p.last })),
  ...f.devices.map((d) => ({ who: `가족 기기 ${d.no}`, group: d.group ? `그룹 ${d.group}` : '—', status: d.status === 'active' ? '승인' : '승인 대기', warn: d.status === 'pending', visits: d.visits, last: d.last })),
];
---

<Ops title={`가족방 ${shortId(f.id)}`} current="families" query={periodQuery(period)}>
  <a class="sp-o__back" href={withPeriod('/ops/families', period)}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>가족방
  </a>
  <header class="sp-o__head sp-o__head--row">
    <h1 class="sp-o__title">가족방 {shortId(f.id)}</h1>
    {f.delete_after ? <span class="sp-o__badge sp-o__badge--warn">탈퇴 예정 · {dayLabel(seoulDate(f.delete_after), today)} 지워짐</span> : <span class="sp-o__badge">정상</span>}
    <p class="sp-o__lead">{dayLabel(seoulDate(f.created_at), today)}에 만듦 · 마지막 올림 {f.last_upload ? dayLabel(seoulDate(f.last_upload), today) : '없음'} · 사진·이름·한마디는 안 보여요</p>
  </header>
  <OpsPeriod period={period} path={`/ops/families/${f.id}`} />

  <div class="sp-o__cols sp-o__cols--narrow">
    <div class="sp-o__col">
      <dl class="sp-o__stats sp-o__stats--4">
        <div class="sp-o__stat"><dt class="sp-o__stat-label">엄빠</dt><dd class="sp-o__stat-num">{nf(f.parents.length)}</dd></div>
        <div class="sp-o__stat"><dt class="sp-o__stat-label">가족 기기</dt><dd class="sp-o__stat-num">{nf(f.devices.length)}</dd><dd class="sp-o__sub">승인 {nf(f.devices.filter((d) => d.status === 'active').length)} · 대기 {nf(f.devices.filter((d) => d.status === 'pending').length)}</dd></div>
        <div class="sp-o__stat"><dt class="sp-o__stat-label">사진·영상</dt><dd class="sp-o__stat-num">{nf(f.photos + f.videos)}</dd><dd class="sp-o__sub">사진 {nf(f.photos)} · 영상 {nf(f.videos)}</dd></div>
        <div class="sp-o__stat"><dt class="sp-o__stat-label">아이</dt><dd class="sp-o__stat-num">{nf(f.children)}</dd></div>
      </dl>
      <section class="sp-p__card" aria-labelledby="sp-o-up">
        <h2 class="sp-p__card-title" id="sp-o-up">올린 사진·영상</h2>
        <OpsBars label="기간 안 날짜별 올린 사진·영상 수" names={['올림']} unit="개" today={today} rows={f.uploads.map((d) => ({ day: d.day, v: [d.n] }))} />
      </section>
      <section class="sp-p__card" aria-labelledby="sp-o-vis">
        <h2 class="sp-p__card-title" id="sp-o-vis">방문</h2>
        <OpsBars label="기간 안 날짜별 방문 수" names={['가족', '엄빠']} unit="회" today={today} rows={f.visits.map((d) => ({ day: d.day, v: [d.device, d.parent] }))} />
      </section>
      <section class="sp-p__card" aria-labelledby="sp-o-people">
        <div><h2 class="sp-p__card-title" id="sp-o-people">사람별 방문</h2><p class="sp-o__sub">이름은 안 보여요. 번호는 들어온 순서예요</p></div>
        <div class="sp-o__table-wrap" tabindex="0" role="region" aria-label="사람별 방문, 옆으로 밀기">
          <table class="sp-o__table">
            <caption class="sp-vh">사람별 방문, 방문은 고른 기간</caption>
            <thead>
              <tr>
                <th scope="col" class="sp-o__cell sp-o__cell--head">누구</th>
                <th scope="col" class="sp-o__cell sp-o__cell--head">그룹</th>
                <th scope="col" class="sp-o__cell sp-o__cell--head">상태</th>
                <th scope="col" class="sp-o__cell sp-o__cell--head sp-o__num">방문</th>
                <th scope="col" class="sp-o__cell sp-o__cell--head sp-o__num">마지막 방문</th>
              </tr>
            </thead>
            <tbody>
              {people.map((p) => (
                <tr class="sp-o__tr">
                  <th scope="row" class="sp-o__cell sp-o__cell--row">{p.who}</th>
                  <td class="sp-o__cell">{p.group}</td>
                  <td class:list={['sp-o__cell', p.warn && 'sp-o__warn']}>{p.status}</td>
                  <td class="sp-o__cell sp-o__num">{nf(p.visits)}회</td>
                  <td class="sp-o__cell sp-o__num">{dayLabel(p.last, today)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <div class="sp-o__col">
      <section class="sp-p__card" aria-labelledby="sp-o-st">
        <h2 class="sp-p__card-title" id="sp-o-st">저장 용량</h2>
        <p class="sp-o__kv-val sp-o__start">{sizeLabel(f.bytes)}{f.quota && ` / ${sizeLabel(f.quota)}`}</p>
        {f.quota && <meter class="sp-p__meter" min="0" max="100" low="80" high="95" optimum="0" value={pct} aria-label={`${sizeLabel(f.quota)} 중 ${pct}% 사용`}>{pct}%</meter>}
      </section>
      <section class="sp-p__card" aria-labelledby="sp-o-gr">
        <h2 class="sp-p__card-title" id="sp-o-gr">그룹</h2>
        <dl class="sp-o__kv">{f.groups.map((g) => (<><dt class="sp-o__kv-name">그룹 {g.no}</dt><dd class="sp-o__kv-val">{nf(g.members)}명</dd></>))}</dl>
      </section>
      <section class="sp-p__card" aria-labelledby="sp-o-in">
        <div><h2 class="sp-p__card-title" id="sp-o-in">들어오기</h2><p class="sp-o__sub">링크 수는 지금, 나머지는 고른 기간</p></div>
        <dl class="sp-o__kv">
          <dt class="sp-o__kv-name">공유 링크</dt><dd class="sp-o__kv-val">{nf(f.shares)}개</dd>
          <dt class="sp-o__kv-name">링크로 들어온 방문</dt><dd class="sp-o__kv-val">{nf(f.entry.link)}</dd>
          <dt class="sp-o__kv-name">비밀번호 틀림(최근 7일만 남음)</dt><dd class="sp-o__kv-val">{nf(f.entry.failures)}번</dd>
        </dl>
      </section>
      {
        f.parents.length > 1 && (
          <section class="sp-p__card" aria-labelledby="sp-o-co">
            <h2 class="sp-p__card-title" id="sp-o-co">함께 관리</h2>
            <p class="sp-o__lead">엄빠 둘 · {dayLabel(seoulDate(f.parents[1].since), today)}부터</p>
          </section>
        )
      }
    </div>
  </div>
</Ops>
