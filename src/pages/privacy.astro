---
// 개인정보 처리방침(138, 사용자 2026-11-02: 운영 PIKAWORKS·pikaworks.help@gmail.com·Supabase 서울 리전). 로그인 없이 누구나 본다.
// 내용은 코드에서 확인한 실제 처리(모으는 것·보관·지우기·맡기는 곳)대로. 법률 검토 전 초안 — 바뀌면 시행일과 함께 고친다
import Parent from '../layouts/Parent.astro';
import { backHref, docHref } from '../lib/back';

// 시행일: 바꿀 때 이 한 줄만
const EFFECTIVE = '2026년 11월 3일';
const CONTACT = 'pikaworks.help@gmail.com';
