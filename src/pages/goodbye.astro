---
// 탈퇴 뒤 작별 화면. 로그아웃된 상태라 지울 날만 주소로 받는다. 함께 관리하던 앨범에서 나왔으면 ?left=1(가족방은 그대로)
import Parent from '../layouts/Parent.astro';

const on = Astro.url.searchParams.get('on') ?? '';
// 있는 날짜만(2026-13-45 같은 값은 버린다)
const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(on);
const d = new Date(`${on}T00:00:00Z`);
const ok = m && !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === on;
const left = Astro.url.searchParams.get('left') === '1';
const day = ok ? `${Number(m[2])}월 ${Number(m[3])}일` : '3일 뒤';
---

<Parent title={left ? '앨범에서 나왔어요 · 스위피' : '그동안 고마웠어요 · 스위피'}>
  <section class="sp-p__farewell" aria-labelledby="bye-title">
    <h1 class="sp-p__title" id="bye-title">{left ? '앨범에서 나왔어요' : '그동안 고마웠어요'}</h1>
    {
      left ? (
        <p class="sp-p__lead">사진과 가족은 그대로 있어요.<br />다시 함께하려면 초대 링크를 받아 주세요.</p>
      ) : (
        <p class="sp-p__lead">{ok ? `${day}에` : day} 사진과 가족 정보가 모두 지워져요.<br />그 전에 다시 로그인하면 그대로 되살릴 수 있어요.</p>
      )
    }
  </section>
  <div class="sp-p__bottom">
    <a class="sp-p__btn sp-p__btn--quiet" href="/start">처음으로</a>
  </div>
</Parent>
