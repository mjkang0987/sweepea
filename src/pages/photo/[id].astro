---
// 부모 사진 정보: 큰 사진·최근 한마디, 찍은 날·아이·보여줄 그룹 고치기, 사진 지우기(한 번 더 확인)
import Parent from '../../layouts/Parent.astro';
import { BackendError, getBackend } from '../../lib/backend';
import { loadParent, seoulToday } from '../../lib/parent';
import { signedMediaUrl } from '../../lib/signed';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const b = getBackend();
const id = Astro.params.id ?? '';
const info = /^[0-9a-f-]{36}$/.test(id) ? await b.mediaInfo(a.pass, id) : null;
if (!info) return Astro.redirect('/home');
const groups = (await b.familyAdmin(a.pass)).groups;
const kids = a.home.children ?? [];
// 넘겨보기: 앨범 화면과 같은 순서(아이를 골랐으면 그 아이 사진만)
const k = kids.length > 1 ? kids.find((x) => x.id === Astro.url.searchParams.get('k'))?.id : undefined;
const kq = k ? `?k=${encodeURIComponent(k)}` : '';
// shortcut: 앨범과 같이 최근 200장 안에서만 넘김, 더 많아지면 앞뒤 한 장씩 조회로
const list = await b.listMedia(a.pass, { limit: 200, childId: k });
const at = list.findIndex((m) => m.id === id);
const prev = at > 0 ? list[at - 1] : undefined;
const next = at >= 0 ? list[at + 1] : undefined;
const seoul = (iso: string) => {
  const p = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(iso)).map((x) => [x.type, x.value]));
  return { date: `${p.year}-${p.month}-${p.day}`, time: `${p.hour}:${p.minute}:${p.second}` };
};
const taken = seoul(info.item.taken_at);
let date = taken.date;
let groupIds = info.group_ids;
let childIds = info.child_ids;
let error: { field: 'date' | 'group' | 'save'; text: string } | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('do') === 'delete') {
    try {
      await b.deleteMedia(a.pass, id);
      return Astro.redirect(`/home${kq ? `${kq}&` : '?'}done=deleted`, 303);
    } catch (e) {
      if (!(e instanceof BackendError)) throw e;
      return Astro.redirect(`/photo/${id}${kq ? `${kq}&` : '?'}done=error`, 303);
    }
  }
  date = String(form.get('date') ?? '');
  groupIds = form.getAll('group').map(String).filter((g) => groups.some((x) => x.id === g));
  childIds = form.getAll('child').map(String).filter((c) => kids.some((k) => k.id === c));
  const validDate = /^\d{4}-\d{2}-\d{2}$/.test(date) && date >= '2000-01-01' && date <= seoulToday();
  if (!validDate) error = { field: 'date', text: '찍은 날을 골라 주세요.' };
  else if (groupIds.length === 0) error = { field: 'group', text: '보여줄 그룹을 하나 이상 골라 주세요.' };
  else {
    try {
      // 날짜만 바꾸고 시각(서울)은 그대로. 오늘로 바꿔 미래 시각이 되면 지금으로
      const at = new Date(Math.min(Date.parse(`${date}T${taken.time}+09:00`), Date.now())).toISOString();
      await b.updateMedia(a.pass, id, { takenAt: at, childIds, groupIds });
      return Astro.redirect(`/photo/${id}${kq ? `${kq}&` : '?'}done=saved`, 303);
    } catch (e) {
      if (!(e instanceof BackendError)) throw e;
      error = { field: 'save', text: '저장하지 못했어요. 다시 눌러 주세요.' };
    }
  }
}
const isVideo = info.item.kind === 'video';
const src = await signedMediaUrl(info.item.view_key);
const poster = info.item.poster_key ? await signedMediaUrl(info.item.poster_key) : undefined;
const label = `${new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' }).format(new Date(info.item.taken_at))} ${isVideo ? '영상' : '사진'}`;
const q = Astro.url.searchParams;
const confirmDelete = q.get('confirm') === 'delete';
// 스와이퍼: 앞뒤 20장씩 주소를 미리 서명해 넘긴다(한 시간 동안 같은 주소라 브라우저 캐시를 탄다). 지우기 확인 중엔 넘기지 않는다
// shortcut: 앞뒤 20장 밖은 끝에서 화살표 링크로 페이지를 새로 연다
const slides =
  at < 0 || confirmDelete
    ? []
    : await Promise.all(
        list.slice(Math.max(0, at - 20), at + 21).map(async (m) => ({
          id: m.id,
          video: m.kind === 'video',
          ratio: m.width && m.height ? m.height / m.width : undefined,
          src: await signedMediaUrl(m.view_key),
          poster: m.poster_key ? await signedMediaUrl(m.poster_key) : undefined,
          label: `${new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' }).format(new Date(m.taken_at))} ${m.kind === 'video' ? '영상' : '사진'}`,
        })),
      );
const done = q.get('done');
const doneText: Record<string, string> = { saved: '저장했어요.', error: '처리하지 못했어요. 다시 눌러 주세요.' };
---

<Parent title={error ? '다시 확인해 주세요 · 사진 정보' : '사진 정보 · 스위피'} tab="home" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <nav class="sp-p__bar" aria-label="뒤로">
    <a class="sp-p__back" href={`/home${kq}`}>앨범</a>
  </nav>
  <h1 class="sp-p__title">사진 정보</h1>
  {done && doneText[done] && <p class:list={['sp-p__toast', done === 'error' && 'sp-p__toast--error']} role={done === 'error' ? 'alert' : undefined} tabindex="-1" autofocus>{doneText[done]}</p>}
  <div class="sp-p__field">
    <div class="sp-p__stage" data-stage data-slides={slides.length > 1 ? JSON.stringify({ k: kq, before: list[Math.max(0, at - 20) - 1]?.id, after: list[at + 21]?.id, slides }) : undefined}>
      {isVideo ? <video class="sp-p__photo" src={src} poster={poster} controls playsinline preload="metadata" aria-label={label} /> : <img class="sp-p__photo" src={src} alt={label} draggable="false" />}
      {(prev || slides.length > 1) && (
        <a class="sp-p__arrow sp-p__arrow--prev" href={`/photo/${prev?.id ?? id}${kq}`} rel="prev" hidden={!prev} aria-label="이전">
          <svg class="sp-p__arrow-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
        </a>
      )}
      {(next || slides.length > 1) && (
        <a class="sp-p__arrow sp-p__arrow--next" href={`/photo/${next?.id ?? id}${kq}`} rel="next" hidden={!next} aria-label="다음">
          <svg class="sp-p__arrow-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
        </a>
      )}
    </div>
    <div data-swap="say">
      {
        info.latest && (
          <p class="sp-p__card sp-p__say">
            <span class="sp-p__say-who"><span class="sp-vh">최근 한마디, </span>{info.latest.name}</span>
            {info.latest.body}
          </p>
        )
      }
    </div>
  </div>
  <div data-swap="info">

  {
    confirmDelete ? (
      <section class="sp-p__card sp-p__card--warn" id="confirm" aria-labelledby="confirm-title">
        <h2 class="sp-p__card-title" id="confirm-title" tabindex="-1" autofocus>이 {isVideo ? '영상' : '사진'}을 지울까요?</h2>
        <p class="sp-p__lead">가족 화면에서도 바로 사라지고, 남긴 반응과 한마디도 같이 지워져요. 되돌릴 수 없어요.</p>
        <form class="sp-p__pair" method="post">
          <a class="sp-p__btn sp-p__btn--quiet" href={`/photo/${id}${kq}`}>취소</a>
          <button class="sp-p__btn sp-p__btn--danger-strong" type="submit" name="do" value="delete">지우기</button>
        </form>
      </section>
    ) : (
      <>
        <form class="sp-p__form" method="post" action={`/photo/${id}${kq}`}>
          {error && <p class="sp-p__error" role="alert" id="p-err">{error.text}</p>}
          <div class="sp-p__field">
            <label class="sp-p__label" for="date">찍은 날</label>
            <input class="sp-p__input" id="date" name="date" type="date" required min="2000-01-01" max={seoulToday()} value={date} aria-invalid={error?.field === 'date' ? 'true' : undefined} aria-describedby={error?.field === 'date' ? 'p-err' : undefined} />
          </div>
          {
            kids.length > 0 && (
              <fieldset class="sp-p__fieldset sp-p__field">
                <legend class="sp-p__label">아이</legend>
                <div class="sp-p__checks">
                  {kids.map((k) => (
                    <label class="sp-p__check">
                      <input class="sp-p__checkbox" type="checkbox" name="child" value={k.id} checked={childIds.includes(k.id)} />
                      {k.name}
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          <fieldset class="sp-p__fieldset sp-p__field" aria-describedby={error?.field === 'group' ? 'group-note p-err' : 'group-note'}>
            <legend class="sp-p__label">보여줄 그룹</legend>
            <div class="sp-p__checks">
              {groups.map((g) => (
                <label class="sp-p__check">
                  <input class="sp-p__checkbox" type="checkbox" name="group" value={g.id} checked={groupIds.includes(g.id)} />
                  {g.name}
                </label>
              ))}
            </div>
            <p class="sp-p__hint" id="group-note">그룹을 빼면 그 가족 화면에서 바로 사라져요.</p>
          </fieldset>
          <button class="sp-p__btn" type="submit" name="do" value="save">저장</button>
        </form>
        <a class="sp-p__btn sp-p__btn--text sp-p__btn--danger-text sp-p__add" href={`/photo/${id}${kq ? `${kq}&` : '?'}confirm=delete#confirm`}>{isVideo ? '영상' : '사진'} 지우기</a>
      </>
    )
  }
  </div>
</Parent>

<script>
  // 진짜 스와이퍼: 손가락을 따라 옆 사진이 움직이고(CSS 스크롤 스냅), 멈추면 주소를 바꾸고 아래 정보 칸만 새로 받아 바꾼다.
  // 스크립트가 없으면 사진 한 장 + ‹ › 링크로 페이지를 넘긴다
  type Slide = { id: string; video: boolean; ratio?: number; src: string; poster?: string; label: string };
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const data = stage?.dataset.slides ? (JSON.parse(stage.dataset.slides) as { k: string; before?: string; after?: string; slides: Slide[] }) : null;
  if (stage && data) {
    const here = location.pathname.split('/').pop();
    let at = data.slides.findIndex((x) => x.id === here);
    const prev = stage.querySelector<HTMLAnchorElement>('a[rel="prev"]');
    const next = stage.querySelector<HTMLAnchorElement>('a[rel="next"]');
    const track = document.createElement('ul');
    track.className = 'sp-p__track';
    track.setAttribute('aria-label', '사진 넘겨보기');
    track.tabIndex = 0;
    data.slides.forEach((x, i) => {
      const li = document.createElement('li');
      li.className = 'sp-p__slide';
      const near = Math.abs(i - at) <= 1;
      if (x.video) {
        const v = Object.assign(document.createElement('video'), { src: x.src, controls: true, playsInline: true, preload: near ? 'metadata' : 'none' });
        if (x.poster) v.poster = x.poster;
        v.className = 'sp-p__photo';
        v.setAttribute('aria-label', x.label);
        li.appendChild(v);
      } else {
        const img = Object.assign(document.createElement('img'), { src: x.src, alt: x.label, draggable: false, decoding: 'async', loading: near ? 'eager' : 'lazy' });
        img.className = 'sp-p__photo';
        li.appendChild(img);
      }
      track.appendChild(li);
    });
    stage.querySelector('.sp-p__photo')?.replaceWith(track);
    track.scrollLeft = at * track.clientWidth;
    // 화살표는 밀고 있는 동안 바로 바꾼다(멈출 때까지 기다리면 늦게 사라진다). 창 끝에서는 창 밖 사진 페이지 링크로 남는다
    // 칸 높이를 지금 사진 비율에 맞춘다(화면 60%까지). 고정 높이면 가로 사진 위아래가 빈 칸으로 남는다
    const fit = (i: number) => {
      const r = data.slides[i]?.ratio;
      track.style.height = r ? `${Math.min(track.clientWidth * r, innerHeight * 0.6)}px` : '';
    };
    const arrows = (i: number) => {
      fit(i);
      const p = data.slides[i - 1]?.id ?? data.before;
      const n = data.slides[i + 1]?.id ?? data.after;
      if (prev) [prev.hidden, prev.href] = [!p, `/photo/${p}${data.k}`];
      if (next) [next.hidden, next.href] = [!n, `/photo/${n}${data.k}`];
    };
    fit(at);
    let load = 0;
    const settle = async () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i === at || !data.slides[i]) return;
      at = i;
      const id = data.slides[i].id;
      track.querySelectorAll('video').forEach((v) => v.pause());
      const url = `/photo/${id}${data.k}`;
      history.replaceState(null, '', url);
      document.querySelector('.sp-p__toast')?.remove();
      // 아래 날짜·아이·그룹·한마디는 그 사진 화면을 받아 그 칸만 바꾼다. 늦게 온 응답은 버린다
      const mine = ++load;
      const info = document.querySelector<HTMLElement>('[data-swap="info"]');
      info?.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch(url, { credentials: 'same-origin' });
        if (!r.ok || r.redirected) throw new Error(String(r.status));
        const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
        if (mine !== load) return;
        for (const k of ['say', 'info']) {
          const to = doc.querySelector(`[data-swap="${k}"]`);
          if (to) document.querySelector(`[data-swap="${k}"]`)?.replaceWith(to);
        }
      } catch {
        if (mine === load) location.href = url;
      }
    };
    let t: ReturnType<typeof setTimeout> | undefined;
    track.addEventListener('scroll', () => {
      arrows(Math.round(track.scrollLeft / track.clientWidth));
      clearTimeout(t);
      t = setTimeout(settle, 120);
    });
    // 멈춤을 알려 주는 브라우저면 기다리지 않고 바로
    track.addEventListener('scrollend', () => {
      clearTimeout(t);
      settle();
    });
    const go = (d: number) => (e: Event) => {
      const i = at + d;
      if (!data.slides[i]) return; // 창 끝: 링크대로 페이지를 연다
      e.preventDefault();
      track.scrollTo({ left: i * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    prev?.addEventListener('click', go(-1));
    next?.addEventListener('click', go(1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1)(e);
      if (e.key === 'ArrowRight') go(1)(e);
    });
    addEventListener('resize', () => {
      track.scrollLeft = at * track.clientWidth;
      fit(at);
    });
  }
</script>
