---
// 처음 설정 2/2: 가족 비밀번호. 1단계 값을 확인하고, POST로 가족방을 만든다
import Parent from '../../layouts/Parent.astro';
import { BackendError, getBackend } from '../../lib/backend';
import { callName } from '../../lib/ko';
import { loadParent } from '../../lib/parent';

const a = await loadParent(Astro.cookies, { needFamily: false });
if ('redirect' in a) return Astro.redirect(a.redirect);
const isPost = Astro.request.method === 'POST';
let src: URLSearchParams | FormData = Astro.url.searchParams;
if (isPost) {
  try {
    src = await Astro.request.formData();
  } catch {
    return Astro.redirect('/setup', 303);
  }
}
const child = String(src.get('child') ?? '').trim();
const birth = String(src.get('birth') ?? '');
const role = src.get('role') === 'dad' ? 'dad' : 'mom';
const back = (e: string) => `/setup?${new URLSearchParams({ child, birth, role, e })}`;
if (child.length < 1 || child.length > 12) return Astro.redirect(back('name'), 303);
const d = new Date(`${birth}T00:00:00Z`);
if (!/^\d{4}-\d{2}-\d{2}$/.test(birth) || Number.isNaN(d.getTime()) || d > new Date()) return Astro.redirect(back('birth'), 303);

let error: string | null = null;
const password = String(src.get('password') ?? '').replace(/\D/g, '');
const hint = String(src.get('hint') ?? '').trim().slice(0, 30);
if (isPost) {
  if (password.length !== 4) error = '숫자 4자리를 써 주세요.';
  else {
    try {
      await getBackend().createFamily(a.pass, { role, childName: child, birthDate: birth, password, hint: hint || undefined });
      return Astro.redirect('/home', 303);
    } catch (e) {
      if (!(e instanceof BackendError)) throw e;
      if (e.code === '23505') return Astro.redirect('/home', 303);
      error = '만들지 못했어요. 다시 눌러 주세요.';
    }
  }
}
const kid = callName(child);
---

<Parent title={error ? `다시 눌러 주세요 · 가족 비밀번호` : '가족 비밀번호를 정해 주세요'}>
  <form class="sp-p__form" method="post" action="/setup/password">
    <input type="hidden" name="child" value={child} />
    <input type="hidden" name="birth" value={birth} />
    <input type="hidden" name="role" value={role} />
    <header class="sp-p__head">
      <p class="sp-p__step">2 / 2</p>
      <h1 class="sp-p__title">가족 비밀번호를 정해 주세요</h1>
      <p class="sp-p__lead">조부모님이 새 휴대폰에서 들어올 때 한 번 물어봐요. 가족이면 다 아는 숫자가 좋아요.</p>
    </header>
    {error && <p class="sp-p__error" role="alert" id="pw-err">{error}</p>}
    <div class="sp-p__field">
      <label class="sp-p__label" for="pw">숫자 4자리</label>
      <input class="sp-p__input sp-p__input--pin" id="pw" name="password" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required autocomplete="off" aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'pw-err' : undefined} />
    </div>
    <div class="sp-p__field">
      <label class="sp-p__label" for="hint">힌트</label>
      <input class="sp-p__input" id="hint" name="hint" type="text" maxlength="30" autocomplete="off" placeholder={`예: ${kid} 생일 4자리`} value={hint} aria-describedby="hint-note" />
      <p class="sp-p__hint" id="hint-note">비밀번호 화면에 같이 보여요. 숫자를 그대로 쓰지는 마세요.</p>
    </div>
    <div class="sp-p__bottom">
      <button class="sp-p__btn" type="submit">시작하기</button>
    </div>
  </form>
</Parent>
