---
// 앨범: 넘겨 보기(기본)·모아 보기. 여러 가족방이면 모두 섞어 보는 게 기본, 집 고르기는 링크.
// 작은 스크립트는 60장씩 더 불러오기·닫고 돌아온 자리 맞추기만(없으면 '사진 더 보기' 링크와 #앵커)
import Family from '../../layouts/Family.astro';
import ReactRow from '../../components/ReactRow.astro';
import SayForm from '../../components/SayForm.astro';
import Toast from '../../components/Toast.astro';
import { sayNote } from '../../lib/say';
import InstallGuide from '../../components/InstallGuide.astro';
import { callName } from '../../lib/ko';
import { INSTALL_COOKIE } from '../../lib/install';
import { albumHref, dayLabel, loadAlbum, loadPage, loadReacts, monthCursor, ZOOMS } from '../../lib/album';
import { getBackend } from '../../lib/backend';
import { signedMediaUrl } from '../../lib/signed';
import { masonry, ratioOf } from '../../lib/masonry';
import { PHOTOS_SEEN, WAITED, seenAt, setLayerCookie } from '../../lib/layers';

// 서명된 사진 주소가 들어 있는 사람별 페이지: 공유 캐시 금지
Astro.response.headers.set('cache-control', 'private, no-store');
// 가운데 레이어 버튼: '봤음'을 쿠키에 적고 같은 화면으로(PRG). 승인 레이어를 닫을 때 지금 사진까지 본 걸로
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const at = String(form?.get('at') ?? '');
  if (form?.get('do') === 'approved') Astro.cookies.delete(WAITED, { path: '/' });
  if (Number.isFinite(Date.parse(at))) setLayerCookie(Astro.cookies, PHOTOS_SEEN, new Date(at).toISOString());
  const back = String(form?.get('back') ?? '/album');
  return Astro.redirect(back.startsWith('/album') ? back : '/album', 303);
}
const a = await loadAlbum(Astro.cookies, Astro.url);
if ('redirect' in a) return Astro.redirect(a.redirect);
const { pass, open, kids, q } = a;
// 60장씩: ?before=<찍은 날~id>는 다음 쪽(스크립트가 받아 이어 붙임, 스크립트 없으면 그 쪽만), ?to=<id>는 크게 보기에서 닫고 돌아와 그 사진까지
const cont = Astro.url.searchParams.has('before');
// 전체 장 수는 제목·넘겨 보기 'n / 전체'에. 새 사진 레이어는 이 쪽(60장)이 아니라 최근 200장에서 본다(옛날에 찍고 새로 올린 사진도 잡게, 예전과 같은 범위)
const [page, total, recent200] = await Promise.all([
  loadPage(pass, a.base, Astro.url),
  getBackend().countMedia(pass, a.base),
  !cont && !q.f ? getBackend().listMedia(pass, { ...a.base, limit: 200 }) : null,
]);
const { items } = page;
const sep = albumHref(q).includes('?') ? '&' : '?';
// 월별(달 카드)은 다음 쪽이 없다
const nextHref = page.next && !(q.v === 'list' && q.z === 'm') ? `${albumHref(q)}${sep}before=${encodeURIComponent(page.next)}` : null;
// 넘겨 보기 반응·한마디 뒤 돌아올 곳: 그 카드까지 그리게 to=, 가운데로 #p-
const backTo = (id: string) => `${here}${sep}to=${id}#p-${id}`;
// 한마디 결과는 보낸 카드에만(sm=사진 id)
const say = Astro.url.searchParams.get('say');
const sayFor = Astro.url.searchParams.get('sm');
// 한마디 보낸 결과는 카드 아래 상자 대신 화면 아래 토스트로(디자인)
const sayToast = sayFor ? sayNote(say) : null;
// 월별은 달 카드만 그려서 칸 반응 수·사진 주소가 필요 없다
const monthView = q.v === 'list' && q.z === 'm';
const reacts = monthView ? new Map() : await loadReacts(pass, items.map((m) => m.id));
const here = albumHref(q);
const many = open.length > 1;
const kidTitle = q.f ? kids.get(q.f)! : [...kids.values()].join('·');
const title = `${kidTitle} 사진`;
// 가장 최근 사진 날짜(이어지는 쪽·아래부터 그린 쪽은 첫 사진이 최근 것이 아니라 뺀다)
const latest = items[0] && page.offset === 0 ? dayLabel(items[0].taken_at) : null;
const showTag = many && !q.f;

const cards = await Promise.all(
  (monthView ? [] : items).map(async (m, i) => ({
    ...m,
    href: albumHref(q, `/album/${m.id}`),
    // 넘겨 보기는 큰 카드라 보기용(영상은 포스터, 없으면 썸네일), 모아 보기는 썸네일. 넘겨 보기는 앞 2장 말고는 lazy
    src: await signedMediaUrl(q.v === 'swipe' ? (m.kind === 'video' ? (m.poster_key ?? m.thumb_key) : m.view_key) : m.thumb_key),
    day: dayLabel(m.taken_at),
    kid: kids.get(m.family_id) ?? '',
    n: page.offset + i + 1,
    what: m.kind === 'video' ? '영상' : '사진',
  })),
);
const days: { day: string; cards: (typeof cards[number] & { ratio: number; at?: string })[] }[] = [];
for (const c of cards) {
  if (days.at(-1)?.day !== c.day) days.push({ day: c.day, cards: [] });
  days.at(-1)!.cards.push({ ...c, ratio: ratioOf(c.width, c.height) });
}
// 2줄(넓은 화면 4줄)은 엇갈린 배열(디자인 GrandList, 부모 홈과 같은 계산): 날짜 묶음마다 자리를 정해 내보낸다.
// 다음 쪽을 합칠 때 브라우저가 그 묶음만 다시 계산해도 앞 칸은 움직이지 않는다(CSS columns는 줄을 다시 나눠 옮겨감)
if (q.z === 2)
  for (const d of days) {
    const two = masonry(d.cards.map((c) => c.ratio), 2);
    const four = masonry(d.cards.map((c) => c.ratio), 4);
    d.cards.forEach((c, i) => (c.at = `--c2:${two[i].col};--r2:${two[i].row};--s2:${two[i].span};--c4:${four[i].col};--r4:${four[i].row};--s4:${four[i].span}`));
  }
const zi = ZOOMS.indexOf(q.z);
// 홈 화면에 두기 안내 쿠키(쿠키는 페이지 맨 위에서 읽고 지운다: 그려지는 중에는 못 바꾼다)
const installState = Astro.cookies.get(INSTALL_COOKIE)?.value;
// 이어지는 쪽(스크립트가 받아 사진만 씀)은 안내·레이어 쿠키를 건드리지 않는다
const installAsked = !cont && Astro.cookies.get(`${INSTALL_COOKIE}_msg`)?.value === '1';
if (installAsked) Astro.cookies.delete(`${INSTALL_COOKIE}_msg`, { path: '/' });
// 가운데 레이어(한 번 열 때 하나): 승인 뒤 처음 → 새 사진. 처음 온 기기는 지금 사진까지 본 걸로만 적는다
const recent = recent200 ?? items;
const newestAt = recent.reduce((t, m) => Math.max(t, m.created_at ? Date.parse(m.created_at) : 0), 0);
const newestIso = newestAt ? new Date(newestAt).toISOString() : '';
const waited = Astro.cookies.get(WAITED)?.value;
const approved = !cont && waited && open.some((f) => f.family_id === waited) ? kids.get(waited) ?? '아이' : null;
// 한 집만 거른 화면에선 다른 집 사진을 모르니 건드리지 않는다
const allKids = !q.f && !cont;
const photosSeen = seenAt(Astro.cookies, PHOTOS_SEEN);
// 처음 온 기기: 지금까지(사진이 없으면 지금 시각까지) 본 걸로만 적는다
if (photosSeen === null && allKids && !approved) setLayerCookie(Astro.cookies, PHOTOS_SEEN, newestIso || new Date().toISOString());
const fresh = !approved && allKids && photosSeen !== null ? recent.filter((m) => m.created_at && Date.parse(m.created_at) > photosSeen) : [];
const freshThumbs = await Promise.all(fresh.slice(0, 3).map((m) => signedMediaUrl(m.thumb_key)));
const freshKid = fresh.length ? kids.get(fresh[0].family_id) ?? '아이' : '';
const fewer = zi < ZOOMS.length - 1 ? albumHref({ ...q, z: ZOOMS[zi + 1] }) : null;
const more = zi > 0 ? albumHref({ ...q, z: ZOOMS[zi - 1] }) : null;
// 월별(98a): 달 카드(대표 3장 + 'N장'), 누르면 그 달부터 3칸. 이 단계의 본문이라 실패하면 안내 글
const monthRows = q.v === 'list' && q.z === 'm' && items.length ? await getBackend().mediaMonths(pass, { familyId: q.f, reps: 3 }).catch(() => null) : null;
const thisYear = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric' }).format(new Date());
const monthCards = monthRows
  ? await Promise.all(
      monthRows.map(async (mo) => ({
        label: mo.ym.slice(0, 4) === thisYear ? `${Number(mo.ym.slice(5))}월` : `${mo.ym.slice(0, 4)}년 ${Number(mo.ym.slice(5))}월`,
        n: mo.n,
        href: `${albumHref({ ...q, z: 3 })}&before=${encodeURIComponent(monthCursor(mo.ym))}`,
        pics: await Promise.all(mo.reps.map((r) => signedMediaUrl(r.thumb_key))),
      })),
    )
  : null;
---

<Family title={title} wide={q.v !== 'swipe'}>
  {sayToast && <Toast text={sayToast.text} tone={sayToast.tone} />}
  {
    (approved || fresh.length > 0) && (
      <div class="sp-layer">
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box sp-layer__box--senior" open aria-labelledby="layer-t" aria-describedby="layer-d">
          {approved ? (
            <>
              <img class="sp-layer__kongi" src="/kongi.svg" width="96" height="96" alt="" />
              <h2 class="sp-layer__title" id="layer-t">엄마아빠가 확인했어요</h2>
              <p class="sp-layer__text" id="layer-d">이제 {approved} 사진을 모두 볼 수 있어요</p>
            </>
          ) : (
            <>
              <h2 class="sp-layer__title" id="layer-t">{freshKid} 새 사진 {fresh.length}장이 왔어요</h2>
              <ul class="sp-layer__thumbs" aria-hidden="true">
                {freshThumbs.map((src, i) => (
                  <li class="sp-layer__thumb">
                    <img class="sp-layer__thumb-img" src={src} alt="" width="96" height="96" />
                    {i === 2 && fresh.length > 3 && <span class="sp-layer__more">+{fresh.length - 3}</span>}
                  </li>
                ))}
              </ul>
              <p class="sp-layer__text" id="layer-d">{dayLabel(fresh[0].created_at!)}에 올라왔어요</p>
            </>
          )}
          <form class="sp-layer__actions" method="post">
            <input type="hidden" name="at" value={newestIso} />
            <input type="hidden" name="back" value={here} />
            <button class="sp-f__btn" type="submit" name="do" value={approved ? 'approved' : 'photos'} autofocus>{approved ? '사진 보기' : '보기'}</button>
          </form>
        </dialog>
      </div>
    )
  }
  <header class="sp-a__head">
    <div class="sp-a__head-text">
      <h1 class="sp-f__title">{title} {total}장</h1>
      {latest && <p class="sp-f__lead">{latest}에 올라왔어요</p>}
    </div>
    <img class="sp-a__kongi" src="/kongi.svg" width="64" height="64" alt="" />
  </header>

  {
    many && (
      <nav class="sp-a__chips" aria-label="어느 집 사진">
        <a class="sp-a__chip" href={albumHref({ ...q, f: undefined })} aria-current={!q.f ? 'true' : undefined}>모두</a>
        {open.map((f) => (
          <a class="sp-a__chip" href={albumHref({ ...q, f: f.family_id })} aria-current={q.f === f.family_id ? 'true' : undefined}>
            {kids.get(f.family_id)}네
          </a>
        ))}
      </nav>
    )
  }

  <InstallGuide kid={callName([...kids.values()][0] ?? '아이')} state={installState} asked={installAsked} />
  <nav class="sp-a__tabs" aria-label="보기 방식">
    <a class="sp-a__tab" href={albumHref({ ...q, v: 'swipe' })} aria-current={q.v === 'swipe' ? 'page' : undefined}>넘겨 보기</a>
    <a class="sp-a__tab" href={albumHref({ ...q, v: 'list' })} aria-current={q.v === 'list' ? 'page' : undefined}>모아 보기</a>
  </nav>

  {
    items.length === 0 && cont ? null : items.length === 0 ? (
      <p class="sp-f__box">아직 올라온 사진이 없어요. 엄마아빠가 올리면 여기에 보여요.</p>
    ) : q.v === 'swipe' ? (
      <>
        {/* 시안(GrandHome): 가운데 카드 + 양옆 사진이 비스듬히 보임. 손가락으로 밀면 넘어감(scroll-snap), 기울기는 CSS 스크롤 애니메이션 */}
        <ul class="sp-a__swipe" aria-label={`사진 ${total}장, 옆으로 밀어서 넘겨 보기`}>
          {cards.map((c) => (
            <li class="sp-a__slide" id={`p-${c.id}`}>
              <div class="sp-a__card">
                <a class="sp-a__card-link" href={c.href} aria-label={`${c.day} ${showTag ? `${c.kid} ` : ''}${c.what} 크게 보기`}>
                  <img class="sp-a__card-img" src={c.src} alt="" loading={c.n > 3 ? 'lazy' : 'eager'} fetchpriority={c.n === 1 ? 'high' : undefined} decoding="async" />
                </a>
                <div class="sp-a__card-cap">
                  {showTag && <span class="sp-a__tag">{c.kid}</span>}
                  <span class="sp-a__card-day">{c.day}{c.kind === 'video' && ' · 영상'}</span>
                  {/* 스크롤 애니메이션이 없는 브라우저(iOS 26 전·파이어폭스)는 아래 반응 줄이 숨으므로 카드에 하트만 */}
                  <div class="sp-a__card-heart">
                    <ReactRow mediaId={c.id} back={backTo(c.id)} reacts={reacts} kinds={['heart']} untitled />
                  </div>
                </div>
              </div>
              <p class="sp-a__pos">
                <strong class="sp-a__pos-n">{c.n}</strong> / {total}<span aria-hidden="true"> · 옆으로 밀거나 옆 사진을 누르세요</span>
              </p>
              {/* 반응 줄은 카드마다. 가운데 카드 것만 보이게(CSS), JS 없이 그 사진에 보낸다 */}
              <div class="sp-a__slide-react">
                {/* 돌아올 때 같은 카드가 가운데에 오게 #p-<id> */}
                <ReactRow mediaId={c.id} back={backTo(c.id)} reacts={reacts} idSuffix={`-${c.id}`} />
                <SayForm mediaId={c.id} back={backTo(c.id)} child={c.kid || '아이'} idSuffix={`-${c.id}`} />
              </div>
            </li>
          ))}
        </ul>
        {/* 목록 끝(디자인 LoadMoreFamily) */}
        {nextHref ? (
          <div class="sp-more" data-more>
            <a class="sp-more__btn" href={nextHref}>사진 더 보기</a>
          </div>
        ) : (
          page.more && (
            <p class="sp-more__end" data-more>
              <img class="sp-more__kongi" src="/kongi.svg" width="40" height="40" alt="" />처음 사진까지 모두 봤어요
            </p>
          )
        )}
      </>
    ) : (
      <>
        {open.some((f) => f.download_allowed && (!q.f || f.family_id === q.f)) && (
          <a class="sp-a__save" href={albumHref(q, '/album/save')}>
            <svg class="sp-a__save-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
            골라서 저장하기
          </a>
        )}
        <nav class="sp-a__zoom" aria-label="사진 크기">
          {/* 끝 단계는 꺼진 링크(화면 읽기에도 '사용 불가'로 들리게) */}
          <a class="sp-a__zoom-btn" href={fewer ?? undefined} role="link" aria-disabled={fewer ? undefined : 'true'} aria-label={q.z === 3 ? '작게(달마다 대표 사진)' : '작게(한 줄에 더 많이)'}>−</a>
          <a class="sp-a__zoom-btn" href={more ?? undefined} role="link" aria-disabled={more ? undefined : 'true'} aria-label="크게(한 줄에 더 적게)">+</a>
        </nav>
        {q.z === 'm' ? (
          monthCards ? (
            <ul class="sp-a__mcards">
              {monthCards.map((mo) => (
                <li>
                  <a class="sp-a__mcard" href={mo.href}>
                    <span class="sp-a__mcard-pics" aria-hidden="true">
                      {mo.pics.map((src) => <img class="sp-a__mcard-img" src={src} alt="" loading="lazy" decoding="async" />)}
                    </span>
                    <span class="sp-a__mcard-title">{mo.label}</span>
                    <span class="sp-a__mcard-count">{mo.n.toLocaleString('ko-KR')}장</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="sp-a__lead">달마다 모아 보기를 불러오지 못했어요. 잠시 뒤 다시 열어 주세요.</p>
          )
        ) : days.map((d) => (
          <section class="sp-a__day" data-day={d.day} aria-label={`${d.day} ${d.cards.length}장`}>
            <h2 class="sp-a__day-title">
              {d.day} <span class="sp-a__day-count">· {d.cards.length}장</span>
            </h2>
            <ul class={`sp-a__grid sp-a__grid--${q.z}`}>
              {d.cards.map((c) => (
                <li class="sp-a__cell" id={`c-${c.id}`} style={c.at} data-ratio={c.ratio}>
                  <a class="sp-a__cell-link" href={c.href}>
                    <img
                      class="sp-a__cell-img"
                      src={c.src}
                      width={c.width ?? undefined}
                      height={c.height ?? undefined}
                      alt={`${c.day} ${c.what}${showTag ? `, ${c.kid}` : ''} 크게 보기`}
                      loading="lazy"
                      decoding="async"
                    />
                    {showTag && (q.z === 1 || q.z === 2) && <span class="sp-a__tag sp-a__tag--on" aria-hidden="true">{c.kid}</span>}
                    {c.kind === 'video' && <span class="sp-a__play" aria-hidden="true">▶</span>}
                    {(reacts.get(c.id)?.counts.heart || reacts.get(c.id)?.counts.comment) && (
                      <span class="sp-a__badge">
                        {reacts.get(c.id)?.counts.heart ? <span><svg class="sp-a__badge-heart" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.2 5 6.7 5c2.1 0 3.6 1.2 4.3 2.4h2C13.7 6.2 15.2 5 17.3 5c3.5 0 5.5 3.6 4.2 6.8C19.5 16.4 12 21 12 21z"></path></svg><span class="sp-vh">하트 </span>{reacts.get(c.id)?.counts.heart}</span> : null}
                        {reacts.get(c.id)?.counts.comment ? <span><span class="sp-vh">, </span>한마디 {reacts.get(c.id)?.counts.comment}</span> : null}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        {/* 목록 끝(디자인 LoadMoreFamily) */}
        {nextHref ? (
          <div class="sp-more" data-more>
            <a class="sp-more__btn" href={nextHref}>사진 더 보기</a>
          </div>
        ) : (
          page.more && (
            <p class="sp-more__end" data-more>
              <img class="sp-more__kongi" src="/kongi.svg" width="40" height="40" alt="" />처음 사진까지 모두 봤어요
            </p>
          )
        )}
        {/* 떠 있는 칸 크기 버튼 아래로 마지막 줄이 가리지 않게 */}
        <div class="sp-a__zoom-space" aria-hidden="true"></div>
      </>
    )
  }
</Family>

<script>
  import { autoMore, keepSpot, relayout } from '../../lib/more';

  const swipe = document.querySelector<HTMLElement>('.sp-a__swipe');
  if (swipe) {
    // 넘겨 보기: 옆으로 밀다 남은 카드가 다섯 장쯤이면 다음 60장 카드를 뒤에 붙인다(옆 스크롤이라 직접 부름)
    const more = autoMore(
      (doc) => [...doc.querySelectorAll<HTMLElement>('.sp-a__slide')].map((li) => swipe.appendChild(document.importNode(li, true))),
      { observe: false },
    );
    const near = () => {
      if (swipe.scrollLeft + swipe.clientWidth * 6 >= swipe.scrollWidth) more();
    };
    swipe.addEventListener('scroll', near, { passive: true });
    near();
    // 보신 기록(95): 가운데 카드에 1.5초 머물면 그 사진을 남긴다(사진마다 한 번). 실패는 버림(다음에 다시 보면 남음)
    const seen = new Set<string>();
    let dwell: ReturnType<typeof setTimeout> | undefined;
    const centered = () => {
      const mid = swipe.getBoundingClientRect().left + swipe.clientWidth / 2;
      let best: HTMLElement | undefined;
      let gap = Infinity;
      for (const li of swipe.querySelectorAll<HTMLElement>('.sp-a__slide')) {
        const r = li.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < gap) [best, gap] = [li, d];
      }
      return best?.id.slice(2);
    };
    const settle = () => {
      clearTimeout(dwell);
      const id = centered();
      if (!id || seen.has(id)) return;
      dwell = setTimeout(() => {
        if (centered() !== id || seen.has(id)) return;
        seen.add(id);
        fetch('/api/views', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids: [id] }), keepalive: true, credentials: 'same-origin' }).catch(() => seen.delete(id));
      }, 1500);
    };
    let still: ReturnType<typeof setTimeout> | undefined;
    swipe.addEventListener('scroll', () => {
      clearTimeout(dwell);
      // 멈춤 알림(scrollend)이 없는 브라우저만 시간으로
      if ('onscrollend' in window) return;
      clearTimeout(still);
      still = setTimeout(settle, 150);
    }, { passive: true });
    swipe.addEventListener('scrollend', settle);
    settle();
  } else {
    // 모아 보기: 같은 날이 쪽을 넘어 이어지면 그날 묶음에 칸을 합치고 장 수를 고친다
    autoMore((doc) => {
      const added: HTMLElement[] = [];
      for (const sec of doc.querySelectorAll<HTMLElement>('.sp-a__day')) {
        const last = [...document.querySelectorAll<HTMLElement>('.sp-a__day')].at(-1);
        if (!last) break;
        const ul = last.querySelector<HTMLElement>('.sp-a__grid');
        if (last.dataset.day === sec.dataset.day && ul) {
          for (const li of sec.querySelectorAll<HTMLElement>('.sp-a__cell')) added.push(ul.appendChild(document.importNode(li, true)));
          if (ul.classList.contains('sp-a__grid--2')) relayout(ul);
          const n = ul.children.length;
          last.setAttribute('aria-label', `${last.dataset.day} ${n}장`);
          const count = last.querySelector('.sp-a__day-count');
          if (count) count.textContent = `· ${n}장`;
        } else {
          const node = document.importNode(sec, true);
          last.insertAdjacentElement('afterend', node);
          added.push(...node.querySelectorAll<HTMLElement>('.sp-a__cell'));
        }
      }
      return added;
    });
    keepSpot('.sp-a__cell-link');
  }
</script>
