---
// 앨범: 넘겨 보기(기본)·모아 보기. 여러 가족방이면 모두 섞어 보는 게 기본, 집 고르기는 링크(JS 없음)
import Family from '../../layouts/Family.astro';
import ReactRow from '../../components/ReactRow.astro';
import SayForm from '../../components/SayForm.astro';
import InstallGuide from '../../components/InstallGuide.astro';
import { callName } from '../../lib/ko';
import { INSTALL_COOKIE } from '../../lib/install';
import { EMOJI_SPRITE } from '../../lib/emoji';
import { albumHref, dayLabel, loadAlbum, loadReacts, ZOOMS } from '../../lib/album';
import { signedMediaUrl } from '../../lib/signed';
import { PHOTOS_SEEN, WAITED, seenAt, setLayerCookie } from '../../lib/layers';

// 서명된 사진 주소가 들어 있는 사람별 페이지: 공유 캐시 금지
Astro.response.headers.set('cache-control', 'private, no-store');
// 가운데 레이어 버튼: '봤음'을 쿠키에 적고 같은 화면으로(PRG). 승인 레이어를 닫을 때 지금 사진까지 본 걸로
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const at = String(form?.get('at') ?? '');
  if (form?.get('do') === 'approved') Astro.cookies.delete(WAITED, { path: '/' });
  if (Number.isFinite(Date.parse(at))) setLayerCookie(Astro.cookies, PHOTOS_SEEN, new Date(at).toISOString());
  const back = String(form?.get('back') ?? '/album');
  return Astro.redirect(back.startsWith('/album') ? back : '/album', 303);
}
const a = await loadAlbum(Astro.cookies, Astro.url);
if ('redirect' in a) return Astro.redirect(a.redirect);
const { pass, open, kids, q, items } = a;
// 한마디 결과는 보낸 카드에만(sm=사진 id)
const say = Astro.url.searchParams.get('say');
const sayFor = Astro.url.searchParams.get('sm');
const reacts = await loadReacts(pass, items.map((m) => m.id));
const here = albumHref(q);
const many = open.length > 1;
const kidTitle = q.f ? kids.get(q.f)! : [...kids.values()].join('·');
const title = `${kidTitle} 사진`;
const latest = items[0] ? dayLabel(items[0].taken_at) : null;
const showTag = many && !q.f;

const cards = await Promise.all(
  items.map(async (m, i) => ({
    ...m,
    href: albumHref(q, `/album/${m.id}`),
    // 넘겨 보기는 큰 카드라 보기용(영상은 포스터, 없으면 썸네일), 모아 보기는 썸네일. 넘겨 보기는 앞 2장 말고는 lazy
    src: await signedMediaUrl(q.v === 'swipe' ? (m.kind === 'video' ? (m.poster_key ?? m.thumb_key) : m.view_key) : m.thumb_key),
    day: dayLabel(m.taken_at),
    kid: kids.get(m.family_id) ?? '',
    n: i + 1,
    what: m.kind === 'video' ? '영상' : '사진',
  })),
);
const days: { day: string; cards: typeof cards }[] = [];
for (const c of cards) {
  if (days.at(-1)?.day !== c.day) days.push({ day: c.day, cards: [] });
  days.at(-1)!.cards.push(c);
}
const zi = ZOOMS.indexOf(q.z);
// 홈 화면에 두기 안내 쿠키(쿠키는 페이지 맨 위에서 읽고 지운다: 그려지는 중에는 못 바꾼다)
const installState = Astro.cookies.get(INSTALL_COOKIE)?.value;
const installAsked = Astro.cookies.get(`${INSTALL_COOKIE}_msg`)?.value === '1';
if (installAsked) Astro.cookies.delete(`${INSTALL_COOKIE}_msg`, { path: '/' });
// 가운데 레이어(한 번 열 때 하나): 승인 뒤 처음 → 새 사진. 처음 온 기기는 지금 사진까지 본 걸로만 적는다
const newestAt = items.reduce((t, m) => Math.max(t, m.created_at ? Date.parse(m.created_at) : 0), 0);
const newestIso = newestAt ? new Date(newestAt).toISOString() : '';
const waited = Astro.cookies.get(WAITED)?.value;
const approved = waited && open.some((f) => f.family_id === waited) ? kids.get(waited) ?? '아이' : null;
// 한 집만 거른 화면에선 다른 집 사진을 모르니 건드리지 않는다
const allKids = !q.f;
const photosSeen = seenAt(Astro.cookies, PHOTOS_SEEN);
// 처음 온 기기: 지금까지(사진이 없으면 지금 시각까지) 본 걸로만 적는다
if (photosSeen === null && allKids && !approved) setLayerCookie(Astro.cookies, PHOTOS_SEEN, newestIso || new Date().toISOString());
const fresh = !approved && allKids && photosSeen !== null ? items.filter((m) => m.created_at && Date.parse(m.created_at) > photosSeen) : [];
const freshThumbs = await Promise.all(fresh.slice(0, 3).map((m) => signedMediaUrl(m.thumb_key)));
const freshKid = fresh.length ? kids.get(fresh[0].family_id) ?? '아이' : '';
const fewer = zi < ZOOMS.length - 1 ? albumHref({ ...q, z: ZOOMS[zi + 1] }) : null;
const more = zi > 0 ? albumHref({ ...q, z: ZOOMS[zi - 1] }) : null;
---

<Family title={title} wide={q.v !== 'swipe'}>
  <Fragment set:html={EMOJI_SPRITE} />
  {
    (approved || fresh.length > 0) && (
      <div class="sp-layer">
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box sp-layer__box--senior" open aria-labelledby="layer-t" aria-describedby="layer-d">
          {approved ? (
            <>
              <img class="sp-layer__kongi" src="/kongi.svg" width="96" height="96" alt="" />
              <h2 class="sp-layer__title" id="layer-t">엄마아빠가 확인했어요</h2>
              <p class="sp-layer__text" id="layer-d">이제 {approved} 사진을 모두 볼 수 있어요</p>
            </>
          ) : (
            <>
              <h2 class="sp-layer__title" id="layer-t">{freshKid} 새 사진 {fresh.length}장이 왔어요</h2>
              <ul class="sp-layer__thumbs" aria-hidden="true">
                {freshThumbs.map((src, i) => (
                  <li class="sp-layer__thumb">
                    <img class="sp-layer__thumb-img" src={src} alt="" width="96" height="96" />
                    {i === 2 && fresh.length > 3 && <span class="sp-layer__more">+{fresh.length - 3}</span>}
                  </li>
                ))}
              </ul>
              <p class="sp-layer__text" id="layer-d">{dayLabel(fresh[0].created_at!)}에 올라왔어요</p>
            </>
          )}
          <form class="sp-layer__actions" method="post">
            <input type="hidden" name="at" value={newestIso} />
            <input type="hidden" name="back" value={here} />
            <button class="sp-f__btn" type="submit" name="do" value={approved ? 'approved' : 'photos'} autofocus>{approved ? '사진 보기' : '보기'}</button>
          </form>
        </dialog>
      </div>
    )
  }
  <header class="sp-a__head">
    <div class="sp-a__head-text">
      <h1 class="sp-f__title">{title} {items.length >= 200 ? '200장 넘게' : `${items.length}장`}</h1>
      {latest && <p class="sp-f__lead">{latest}에 올라왔어요</p>}
    </div>
    <img class="sp-a__kongi" src="/kongi.svg" width="64" height="64" alt="" />
  </header>

  {
    many && (
      <nav class="sp-a__chips" aria-label="어느 집 사진">
        <a class="sp-a__chip" href={albumHref({ ...q, f: undefined })} aria-current={!q.f ? 'true' : undefined}>모두</a>
        {open.map((f) => (
          <a class="sp-a__chip" href={albumHref({ ...q, f: f.family_id })} aria-current={q.f === f.family_id ? 'true' : undefined}>
            {kids.get(f.family_id)}네
          </a>
        ))}
      </nav>
    )
  }

  <InstallGuide kid={callName([...kids.values()][0] ?? '아이')} state={installState} asked={installAsked} />
  <nav class="sp-a__tabs" aria-label="보기 방식">
    <a class="sp-a__tab" href={albumHref({ ...q, v: 'swipe' })} aria-current={q.v === 'swipe' ? 'page' : undefined}>넘겨 보기</a>
    <a class="sp-a__tab" href={albumHref({ ...q, v: 'list' })} aria-current={q.v === 'list' ? 'page' : undefined}>모아 보기</a>
  </nav>

  {
    items.length === 0 ? (
      <p class="sp-f__box">아직 올라온 사진이 없어요. 엄마아빠가 올리면 여기에 보여요.</p>
    ) : q.v === 'swipe' ? (
      <>
        {/* 시안(GrandHome): 가운데 카드 + 양옆 사진이 비스듬히 보임. 손가락으로 밀면 넘어감(scroll-snap), 기울기는 CSS 스크롤 애니메이션 */}
        <ul class="sp-a__swipe" aria-label={`사진 ${cards.length}장, 옆으로 밀어서 넘겨 보기`}>
          {cards.map((c) => (
            <li class="sp-a__slide" id={`p-${c.id}`}>
              <div class="sp-a__card">
                <a class="sp-a__card-link" href={c.href} aria-label={`${c.day} ${showTag ? `${c.kid} ` : ''}${c.what} 크게 보기`}>
                  <img class="sp-a__card-img" src={c.src} alt="" loading={c.n > 3 ? 'lazy' : 'eager'} fetchpriority={c.n === 1 ? 'high' : undefined} decoding="async" />
                </a>
                <div class="sp-a__card-cap">
                  {showTag && <span class="sp-a__tag">{c.kid}</span>}
                  <span class="sp-a__card-day">{c.day}{c.kind === 'video' && ' · 영상'}</span>
                </div>
              </div>
              <p class="sp-a__pos">
                <strong class="sp-a__pos-n">{c.n}</strong> / {cards.length}<span aria-hidden="true"> · 옆으로 밀거나 옆 사진을 누르세요</span>
              </p>
              {/* 반응 줄은 카드마다. 가운데 카드 것만 보이게(CSS), JS 없이 그 사진에 보낸다 */}
              <div class="sp-a__slide-react">
                {/* 돌아올 때 같은 카드가 가운데에 오게 #p-<id> */}
                <ReactRow mediaId={c.id} back={`${here}#p-${c.id}`} reacts={reacts} idSuffix={`-${c.n}`} />
                <SayForm mediaId={c.id} back={`${here}#p-${c.id}`} child={c.kid || '아이'} say={sayFor === c.id ? say : null} idSuffix={`-${c.n}`} />
              </div>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <>
        {open.some((f) => f.download_allowed && (!q.f || f.family_id === q.f)) && (
          <a class="sp-a__save" href={albumHref(q, '/album/save')}>
            <svg class="sp-a__save-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
            골라서 저장하기
          </a>
        )}
        <nav class="sp-a__zoom" aria-label="사진 크기">
          {fewer ? <a class="sp-a__zoom-btn" href={fewer} aria-label="작게(한 줄에 더 많이)">−</a> : <span class="sp-a__zoom-btn sp-a__zoom-btn--off" aria-hidden="true">−</span>}
          {more ? <a class="sp-a__zoom-btn" href={more} aria-label="크게(한 줄에 더 적게)">+</a> : <span class="sp-a__zoom-btn sp-a__zoom-btn--off" aria-hidden="true">+</span>}
        </nav>
        {days.map((d) => (
          <section class="sp-a__day" aria-label={`${d.day} ${d.cards.length}장`}>
            <h2 class="sp-a__day-title">
              {d.day} <span class="sp-a__day-count">· {d.cards.length}장</span>
            </h2>
            <ul class={`sp-a__grid sp-a__grid--${q.z}`}>
              {d.cards.map((c) => (
                <li class="sp-a__cell">
                  <a class="sp-a__cell-link" href={c.href}>
                    <img
                      class="sp-a__cell-img"
                      src={c.src}
                      width={c.width ?? undefined}
                      height={c.height ?? undefined}
                      alt={`${c.day} ${c.what}${showTag ? `, ${c.kid}` : ''} 크게 보기`}
                      loading="lazy"
                      decoding="async"
                    />
                    {showTag && q.z <= 2 && <span class="sp-a__tag sp-a__tag--on" aria-hidden="true">{c.kid}</span>}
                    {c.kind === 'video' && <span class="sp-a__play" aria-hidden="true">▶</span>}
                    {(reacts.get(c.id)?.counts.heart || reacts.get(c.id)?.counts.comment) && q.z <= 3 && (
                      <span class="sp-a__badge">
                        {reacts.get(c.id)?.counts.heart ? <span><svg class="sp-a__badge-heart" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.2 5 6.7 5c2.1 0 3.6 1.2 4.3 2.4h2C13.7 6.2 15.2 5 17.3 5c3.5 0 5.5 3.6 4.2 6.8C19.5 16.4 12 21 12 21z"></path></svg><span class="sp-vh">하트 </span>{reacts.get(c.id)?.counts.heart}</span> : null}
                        {reacts.get(c.id)?.counts.comment ? <span><span class="sp-vh">, </span>한마디 {reacts.get(c.id)?.counts.comment}</span> : null}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        {/* 떠 있는 칸 크기 버튼 아래로 마지막 줄이 가리지 않게 */}
        <div class="sp-a__zoom-space" aria-hidden="true"></div>
      </>
    )
  }
</Family>
