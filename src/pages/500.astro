---
// 서버 오류(백엔드 응답 없음 등). 백엔드를 다시 부르지 않는다
import Base from '../layouts/Base.astro';
import Notice from '../components/Notice.astro';
import '../styles/family.css';
---

<Base title="잠깐 문제가 생겼어요">
  <main class="sp-f">
    <Notice title="잠깐 문제가 생겼어요" text="조금 뒤에 다시 열어 주세요. 계속 안 되면 엄마아빠에게 알려 주세요." />
    <div class="sp-f__bottom">
      <a class="sp-f__btn sp-f__btn--fill" href="">다시 열기</a>
    </div>
  </main>
</Base>
