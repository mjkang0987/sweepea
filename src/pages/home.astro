---
// 부모 앨범: 사진이 없으면 첫 사진 안내, 있으면 월별 모아 보기. 아래 탭(앨범·설정)
import Parent from '../layouts/Parent.astro';
import LessLink from '../components/LessLink.astro';
import { getBackend } from '../lib/backend';
import { sizeLabel, summarize } from '../lib/familyAdmin';
import { callName, hasBatchim } from '../lib/ko';
import { ageLabel, agoLabel, dayMark, milestone } from '../lib/age';
import { loadParent, seoulToday } from '../lib/parent';
import { signedMediaUrl } from '../lib/signed';
import { dayLabel, loadPage, loadReacts, pickView, pickZoom, ZOOMS, type Zoom } from '../lib/album';
import '../styles/swipe.css';
import { groupYears } from '../lib/months';
import { masonry, ratioOf } from '../lib/masonry';
import { EMOJI } from '../lib/emoji';
import { COPARENT_SEEN, JOIN_SEEN, MILESTONE_SEEN, STORAGE_SEEN, seenAt, setLayerCookie } from '../lib/layers';

Astro.response.headers.set('cache-control', 'private, no-store');
// 가운데 레이어 버튼: 지금 보이는 것까지 '봤음'으로 적고 이동(PRG). 닫기·나중에를 스크립트가 그 자리에서 보내면(x-sp-inplace) 적기만 하고 204
const GO: Record<string, string> = { 'join-check': '/settings/family', 'day-upload': '/upload', 'storage-view': '/settings/storage' };
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const at = String(form?.get('at') ?? '');
  const day = String(form?.get('day') ?? '');
  const level = String(form?.get('level') ?? '');
  const since = String(form?.get('since') ?? '');
  if (Number.isFinite(Date.parse(at))) setLayerCookie(Astro.cookies, JOIN_SEEN, new Date(at).toISOString());
  if (/^[\w-]{1,64}:\d{4}-\d{2}-\d{2}$/.test(day)) setLayerCookie(Astro.cookies, MILESTONE_SEEN, day);
  if (level === '90' || level === '100') setLayerCookie(Astro.cookies, STORAGE_SEEN, level);
  if (Number.isFinite(Date.parse(since))) setLayerCookie(Astro.cookies, COPARENT_SEEN, new Date(since).toISOString());
  const go = GO[String(form?.get('do'))];
  if (!go && Astro.request.headers.get('x-sp-inplace') === '1') return new Response(null, { status: 204 });
  return Astro.redirect(go ?? '/home', 303);
}
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const kid = callName(a.home.children?.[0]?.name ?? '아이');
// 아이 고르기(아이가 둘 이상일 때): ?k=아이id, 모르는 값이면 전체
const kids = a.home.children ?? [];
const picked = kids.length > 1 ? kids.find((k) => k.id === Astro.url.searchParams.get('k')) : undefined;
// 사진·영상 거르기(117c): ?t=photo|video, 없으면 전체
const t0 = Astro.url.searchParams.get('t');
const kind = t0 === 'photo' || t0 === 'video' ? t0 : undefined;
const tq = kind ? `t=${kind}&` : '';
const b = getBackend();
// 그룹 거르기(123, 사용자 "엄빠는 누구네 집에 어떤 사진 보이는지"): ?g=그룹id. 값 모양만 보고 바로 거르고, 아래에서 함께 받는 그룹 목록으로
// 내 가족방 그룹인지 확인해 아니면 g를 뺀 주소로(134: 예전엔 목록을 먼저 따로 기다려 서버 왕복이 한 번 더)
const g1 = Astro.url.searchParams.get('g');
const g0 = g1 && /^[\w-]{1,64}$/.test(g1) ? g1 : undefined;
// 사진 크기(−/+, 98a): 1·2·3칸 = 사진 전부, 월별 = 달마다 대표 3장. 기기 쿠키에 기억
const z = pickZoom(Astro.url, Astro.cookies, 'sp_pz');
// 넘겨 보기·모아 보기(98d): 기기 쿠키 sp_pv에 기억, 처음엔 모아 보기(지금까지와 같게)
const swipe = pickView(Astro.url, Astro.cookies, 'sp_pv', 'list') === 'swipe';
// 60장씩: ?before=<찍은 날~id>는 다음 쪽(스크립트가 받아 이어 붙임, 스크립트 없으면 그 쪽만), ?to=<id>는 크게 보기에서 닫고 돌아와 그 사진까지
// ?after=는 위로 이어 붙이는 쪽(128, 칸 보기)
const cont = Astro.url.searchParams.has('before') || Astro.url.searchParams.has('after');
const today = seoulToday();
// 승인 대기·설치 부탁 띠도 옆 기능이라 실패하면 띠만 뺀다
// 이어지는 쪽은 사진만 쓰므로 띠는 건너뛴다
// 넘겨 보기 'n / 전체'의 전체(고른 아이 기준)
// 월별·연별 카드(옆 기능이 아니라 이 단계의 본문이라 실패하면 안내 글)
const cardView = !swipe && (z === 'm' || z === 'y');
// 서버 왕복을 한 번에(128 속도): 최근 200장(새 사진 판단)·달 카드도 같은 차례에 함께 묻는다(예전엔 쪽을 받은 뒤 차례로)
const [page0, admin, fp, swipeTotal0, recent200, monthCards0] = await Promise.all([
  loadPage(a.pass, { childId: picked?.id, kind, groupId: g0 }, Astro.url, { around: true, count: swipe }).catch((e) => (g0 ? null : Promise.reject(e))),
  // 그룹 목록: 띠·거르기 알약과 g 확인에(이어지는 쪽은 둘 다 안 씀)
  cont ? null : b.familyAdmin(a.pass).catch(() => null),
  cont ? null : b.familyParents(a.pass).catch(() => null),
  // 'n / 전체'의 전체만 빠지는 옆 기능이라 실패하면 그 글자만 뺀다
  // 이어지는 쪽은 loadPage가 이미 셌으니 다시 세지 않는다
  swipe && !cont ? b.countMedia(a.pass, { childId: picked?.id, kind, groupId: g0 }).catch(() => null) : null,
  cont || cardView ? null : b.listMedia(a.pass, { childId: picked?.id, kind, groupId: g0, limit: 200 }).catch(() => null),
  // 달·해 카드도 거르기(사진/영상·그룹)를 따름(132)
  cardView ? b.mediaMonths(a.pass, { childId: picked?.id, kind, groupId: g0, reps: 5 }).catch(() => null) : null,
]);
const group = g0 ? admin?.groups.find((x) => x.id === g0) : undefined;
// 첫 쪽: 내 가족방 그룹이 아니면(또는 그룹 목록을 못 받으면) 그룹 거르기를 뺀 같은 주소로.
// 이어지는 쪽(?before·?after)은 확인하지 않는다: 돌려보내면 받는 스크립트가 거르지 않은 쪽을 이어 붙이므로. 내 가족방 것만 나오는 건 DB 권한이 지킴
if (g0 && !cont && (!group || !page0)) {
  const u = new URL(Astro.url);
  u.searchParams.delete('g');
  return Astro.redirect(u.pathname + u.search);
}
if (!page0) throw new Error('album page');
const page = page0;
const gid = cont ? g0 : group?.id;
const gq = gid ? `g=${encodeURIComponent(gid)}&` : '';
const swipeTotal = page.total ?? swipeTotal0;
// 함께 관리 시작 알림(사용자 2026-10-29 "아빠 접속했다고 알람은 안 뜨네?"): 나보다 나중에 들어온 엄빠가 있고 이 기기에서 아직 안 봤으면 한 번.
// 옆 기능이라 실패하면 레이어만 뺀다. 30일 지난 일은 띄우지 않음
const meP = fp?.parents.find((p) => p.me);
const newP = fp?.parents.find((p) => !p.me && meP && Date.parse(p.since) > Date.parse(meP.since) && Date.now() - Date.parse(p.since) < 30 * 86_400_000);
const coparent = newP && Date.parse(newP.since) > (seenAt(Astro.cookies, COPARENT_SEEN) ?? 0) ? { who: newP.role === 'dad' ? '아빠' : '엄마', since: newP.since } : null;
// 여러 장 고르기(126, 사용자 "사진 수정하기 멀티로"): ?sel=1이면 칸마다 체크 칸, 아래 막대 'N장 · 지우기 · 수정'(스크립트 없어도 폼 GET /photos/edit). 칸 보기에서만
const sel = Astro.url.searchParams.get('sel') === '1' && !swipe && !cardView;
const SEL_MAX = 60;
const Cell = sel ? 'label' : 'a';
const monthCards = page.items.length ? monthCards0 : null;
const { items } = page;
// 새 사진(117e, 사용자 2026-11-01): 상대 엄빠·가족이 올렸고 내가 아직 안 본 사진(서버, 사람마다. 본 것 = 크게 보기). 들어오기 전·내가 올린 사진은 아님.
// 올린 지 3시간 안이면 맨 위 '방금 올라왔어요' 묶음으로 옮기고 제자리(모든 쪽)에서 빼고, 3시간 지났으면 제자리에서 '새 사진' 알약. 못 받으면 표시 없음
const candidates = cardView ? [] : [...new Map([...(recent200 ?? []), ...items].map((m) => [m.id, m])).values()];
const nowMs = Date.now();
// 반응 수도 '안 본 사진'과 함께 묻는다(128): 보일 수 있는 칸 = 이 쪽 + 올린 지 3시간 안(맨 위 묶음 후보)
const reactIds = cardView ? [] : [...new Set([...items, ...(recent200 ?? []).filter((m) => !!m.created_at && nowMs - Date.parse(m.created_at) < 3 * 3600 * 1000)].map((m) => m.id))];
const [unseenList, reacts] = await Promise.all([
  candidates.length ? b.unseenMedia(a.pass, candidates.map((m) => m.id)).catch(() => null) : [],
  cardView ? null : loadReacts(a.pass, reactIds).catch(() => null),
]);
const unseenIds = new Set(unseenList ?? []);
// '방금 올림'(137, 사용자 "내가 올린 사진도 '방금 올림' 표시 따로"): 올린 지 3시간 안인데 나한테 신규가 아닌 사진 = 대부분 내가 올린 것(상대 엄빠가 올려 내가 이미 본 사진도 포함, 문구는 맞음).
// 누가 올렸는지는 목록에 없어(DB가 따로만 줌) 이렇게 가늠. 안 본 사진을 못 받았으면 표시 안 함(모두 '방금 올림'으로 보이지 않게)
const justUp = (m: { id: string; created_at?: string | null }) => unseenList !== null && !unseenIds.has(m.id) && !!m.created_at && nowMs - Date.parse(m.created_at) < 3 * 3600 * 1000;
// 주변만 그린 쪽(위에 더 최근 사진이 있음)과 그 뒤로 이어지는 쪽(nb=1)은 맨 위 묶음을 만들지 않고 제자리에 둔다(132: 묶음이 쪽 가운데 끼면 넘겨 보기 번호·앞에 붙이는 순서가 꼬임)
const noBand = Astro.url.searchParams.get('nb') === '1' || (!cont && !!page.prev);
const nbq = noBand ? '&nb=1' : '';
const isTop = (m: { id: string; created_at?: string | null }) => !noBand && unseenIds.has(m.id) && !!m.created_at && nowMs - Date.parse(m.created_at) < 3 * 3600 * 1000;
const topItems = cont || cardView ? [] : (recent200 ?? items).filter(isTop);
const shown = [...topItems, ...items.filter((m) => !isTop(m))];
const kq = `${picked ? `k=${encodeURIComponent(picked.id)}&` : ''}${tq}${gq}`;
// 거르기 알약 줄(123, 디자인 ParentHomeZoom3): 아이·사진/영상·그룹. 누른 걸 다시 누르면 그 거르기만 풀림, '전체'는 다 풂. 보기(넘겨/칸)는 그대로
const viewQ0 = swipe ? 'v=swipe' : `v=list&z=${z}${sel ? '&sel=1' : ''}`;
const filterHref = (f: { k?: string; t?: string; g?: string }) =>
  `/home?${f.k ? `k=${encodeURIComponent(f.k)}&` : ''}${f.t ? `t=${f.t}&` : ''}${f.g ? `g=${encodeURIComponent(f.g)}&` : ''}${viewQ0}`;
const cur = { k: picked?.id, t: kind, g: group?.id };
// 그룹은 둘 이상일 때만(하나면 다 같은 사진). 달·해 카드도 거르기를 따르므로(132) 카드 보기에도 다 보임
const filterGroups = (admin?.groups.length ?? 0) > 1 ? admin!.groups : [];
// 월별·연별은 카드라 다음 쪽이 없다
// 보기도 주소에 적는다(받은 쪽이 같은 보기로 그려지게)
const nextHref = page.next && !cardView ? `/home?${kq}${swipe ? 'v=swipe' : `v=list&z=${z}`}${sel ? '&sel=1' : ''}${nbq}&before=${encodeURIComponent(page.next)}` : null;
// 위로 이어 붙일 쪽(128): 사진 주변만 그린 쪽이면 맨 위에 '최근 사진 더 보기'(스크립트가 보이기 전에 받아 위에 붙임)
const prevHref = page.prev && !cardView ? `/home?${kq}${swipe ? 'v=swipe' : `v=list&z=${z}${sel ? '&sel=1' : ''}`}${nbq}&after=${encodeURIComponent(page.prev)}` : null;
// 보기(v=list)도 주소에: 다른 창에서 넘겨 보기를 골라 쿠키가 바뀌어도 칸 단계로 그려지게(리뷰 2026-10-31)
const zoomHref = (to: Zoom) => `/home?${kq}v=list&z=${to}`;
const zi = ZOOMS.indexOf(z);
const smaller = zi < ZOOMS.length - 1 ? zoomHref(ZOOMS[zi + 1]) : null;
const bigger = zi > 0 ? zoomHref(ZOOMS[zi - 1]) : null;
// 카드(시안 GrandList): 월별 = 큰 1장 + 2장('10월' · 'N장'), 연별 = 큰 1장 + 4장('2026년' · '1–10월 · N장'). 누르면 그 달(해는 가장 최근 달)부터 3칸
const cardHref = (ym: string) => `/home?${kq}v=list&z=3&at=${ym}#m-${ym}`;
const cards = !monthCards
  ? null
  : await Promise.all(
      (z === 'y'
        ? groupYears(monthCards).map((g) => ({ label: `${g.y}년`, sub: `${g.from === g.to ? `${g.to}월` : `${g.from}–${g.to}월`} · ${g.n.toLocaleString('ko-KR')}장`, n: g.n, href: cardHref(g.last), reps: g.reps }))
        : monthCards.map((mo) => ({
            label: mo.ym.slice(0, 4) === today.slice(0, 4) ? `${Number(mo.ym.slice(5))}월` : `${mo.ym.slice(0, 4)}년 ${Number(mo.ym.slice(5))}월`,
            sub: `${mo.n.toLocaleString('ko-KR')}장`,
            n: mo.n,
            href: cardHref(mo.ym),
            reps: mo.reps,
          }))
      ).map(async (c) => ({ ...c, pics: await Promise.all(c.reps.map((r) => signedMediaUrl(r.thumb_key))) })),
    );
const now = Date.now();
const s = admin && summarize(admin);
const firstWait = s && s.pendingDevices.length === 0 && s.pendingMembers.length === 1 ? s.pendingMembers[0] : null;
const ga = (w: string) => (hasBatchim(w) ? '이' : '가');
// 가운데 레이어: 아직 닫지 않은 들어오기 신청 중 가장 최근 것(새 휴대폰 포함)
const joinSeen = seenAt(Astro.cookies, JOIN_SEEN) ?? 0;
const joins = s
  ? [
      ...s.pendingMembers.map((m) => ({ who: m.display_name, what: `${s.groupName(m.group_id)} 그룹에 들어오려고 해요`, at: m.created_at, expires: true })),
      ...s.pendingDevices.map((d) => ({
        who: admin!.members.find((m) => m.id === (d.member_id ?? d.requested_member_id))?.display_name ?? d.requested_name ?? '가족',
        what: '비밀번호를 여러 번 틀린 휴대폰이 들어오려고 해요',
        at: d.created_at,
        expires: false,
      })),
    ].sort((x, y) => Date.parse(y.at) - Date.parse(x.at))
  : [];
const join = joins[0] && Date.parse(joins[0].at) > joinSeen ? joins[0] : null;
// 백일·돌·생일: 그날 한 번(아이 여럿이면 첫 아이)
// 들어오기 신청이 있으면 숨겨 두었다가(스크립트 없으면 다음에 열 때) 그 레이어를 닫은 뒤 띄운다
const dayKid = (a.home.children ?? []).map((k) => ({ k, what: milestone(k.birth_date, today) })).find((x) => x.what);
const dayKey = dayKid ? `${dayKid.k.id}:${today}` : '';
const birthday = dayKid && Astro.cookies.get(MILESTONE_SEEN)?.value !== dayKey ? { title: `오늘은 ${callName(dayKid.k.name)}`, what: dayKid.what! } : null;
const coparentLater = !!join;
const birthdayLater = !!(join || coparent);
// 저장 공간: 무료 5GB의 90%·100%에서 한 번씩. 90 밑으로 내려가면 기록을 지워 다시 넘을 때 또 뜸
// shortcut: 가족 플랜(plan_until 있음)은 상한이 달라 건너뜀, 결제 이슈에서 플랜별 상한으로
const LIMIT = 5 * 1024 ** 3;
const usedBytes = a.home.storage_used_bytes ?? 0;
const pct = Math.min(100, Math.floor((usedBytes / LIMIT) * 100));
const level = a.home.plan_until ? null : pct >= 100 ? '100' : pct >= 90 ? '90' : null;
const storageSeen = Number(Astro.cookies.get(STORAGE_SEEN)?.value ?? 0);
if (!level && storageSeen) Astro.cookies.delete(STORAGE_SEEN, { path: '/' });
const storage = level && Number(level) > storageSeen ? { level, full: level === '100' } : null;
// 들어오기 신청·백일/생일과 겹치면 숨겨 둔다(위와 같이). 레이어는 한 번에 하나: 들어오기 신청 → 함께 관리 시작 → 백일/생일 → 저장 공간
const storageLater = !!(join || coparent || birthday);
const helpers = admin?.members.filter((m) => m.status === 'active' && m.install_help_at && now - Date.parse(m.install_help_at) < 7 * 86_400_000) ?? [];
const dayFmt = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
// 칸마다 받은 하트·한마디 수(디자인: 칸 왼쪽 아래 알약). 옆 기능이라 실패하면 알약만 뺀다
// 반올림을 먼저 해서 59.6초가 '0:60'이 되지 않게(리뷰 2026-10-31)
const clock = (sec: number) => ((s) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`)(Math.round(sec));
type Cell = { id: string; src: string; video: boolean; day: string; d: string; mark: string | null; ratio: number; hearts: number; says: number; length: string | null; at2?: string; anchor?: string; top?: boolean; fresh?: boolean; up?: boolean };
// 빈칸 없는 앨범(117b): 달마다 끊지 않고 한 격자. 달로 바로 가기(#m-YYYY-MM)는 그 달 첫 칸 안 표식으로
const cells: Cell[] = [];
// 맨 위 '방금 올라왔어요' 묶음(117e)
const topCells: Cell[] = [];
let lastYM = '';
// 달 묶음 이름(화면 읽기용 제목): 올해면 '10월', 아니면 '2025년 10월'
// 기념일(100일·200일·첫돌·생일…) 표시: 고른 아이·아이 하나면 그 아이, 전체면 그날 기념일인 아이 이름과 함께(사용자 "이벤트로", 2026-10-29)
const ageKid = picked ?? (kids.length === 1 ? kids[0] : undefined);
const markOf = (d: string) => {
  if (ageKid) return dayMark(ageKid.birth_date, d);
  // 그날 기념일인 아이 모두(쌍둥이 생일 같은 날), 이름은 그대로('서이'의 '이'를 떼지 않게, 리뷰 2026-10-29)
  const hits = kids.map((k) => ({ k, m: dayMark(k.birth_date, d) })).filter((x) => x.m);
  return hits.length ? hits.map((x) => `${x.k.name} ${x.m}`).join(', ') : null;
};
const seoulDay = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date(iso));
const seoulYM = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit' }).format(new Date(iso));
for (const m of cardView || swipe ? [] : shown) {
  const top = isTop(m);
  const ym = seoulYM(m.taken_at);
  const anchor = !top && ym !== lastYM ? ym : undefined;
  if (!top) lastYM = ym;
  const r = reacts?.get(m.id)?.counts;
  (top ? topCells : cells).push({
    anchor,
    top,
    fresh: unseenIds.has(m.id),
    up: justUp(m),
    id: m.id,
    // 1칸은 한 줄에 한 장을 크게 보여서 작은 그림(480px) 대신 사진(영상은 포스터)
    src: await signedMediaUrl(z === 1 ? (m.kind === 'video' ? (m.poster_key ?? m.thumb_key) : m.view_key) : m.thumb_key),
    video: m.kind === 'video',
    day: dayFmt.format(new Date(m.taken_at)),
    d: seoulDay(m.taken_at),
    mark: markOf(seoulDay(m.taken_at)),
    ratio: ratioOf(m.width, m.height),
    hearts: r?.heart ?? 0,
    says: r?.comment ?? 0,
    length: m.kind === 'video' && m.duration_sec ? clock(Number(m.duration_sec)) : null,
  });
}
// 머리 작은 줄 첫 값(스크립트 없어도): 맨 위 사진의 찍은 날, 올해가 아니면 연도도
const d0 = items[0] ? seoulDay(items[0].taken_at) : '';
const mark0 = d0 && (z === 1 || z === 2) ? markOf(d0) : null;
const whenFirst = d0 && !cardView && !swipe ? `${d0.slice(0, 4) === today.slice(0, 4) ? '' : `${d0.slice(0, 4)}년 `}${dayFmt.format(new Date(items[0].taken_at))}${mark0 ? ` · ${mark0}` : ''}` : null;
// 머리 오른쪽 위 아이 오늘 나이(사용자 2026-10-29 "아기 정보는 항상 노출, N개월 NN일", 디자인 ParentHomeZoom): 고른 아이, 전체면 아이마다
const kidAges = (picked ? [picked] : kids).map((k) => ({ id: k.id, name: k.name, age: ageLabel(k.birth_date, today) })).filter((k) => k.age);
// 넘겨 보기 카드(98d, 가족 넘겨 보기와 같은 카드): 사진(영상은 포스터) 크게, 누르면 크게 보기. 칸 단계(z)는 안 붙인다(닫으면 기억한 넘겨 보기로)
// 거르기(아이·사진/영상·그룹)는 크게 보기로 이어 그 안에서만 넘김(125)
const viewQ = kq ? `?${kq.slice(0, -1)}` : '';
const toAt = shown.findIndex((m) => m.id === Astro.url.searchParams.get('to'));
const slides = !swipe
  ? []
  : await Promise.all(
      shown.map(async (m, i) => {
        const r = reacts?.get(m.id)?.counts;
        const video = m.kind === 'video';
        const mark = markOf(seoulDay(m.taken_at));
        const length = video && m.duration_sec ? clock(Number(m.duration_sec)) : null;
        return {
          id: m.id,
          src: await signedMediaUrl(video ? (m.poster_key ?? m.thumb_key) : m.view_key),
          cap: [dayLabel(m.taken_at), mark, video && `영상${length ? ` ${length}` : ''}`].filter(Boolean).join(' · '),
          // 화면 읽기: 날짜 · 기념일 · 영상 길이, 사진이면 '사진'
          label: [dayLabel(m.taken_at), mark, video ? `영상${length ? ` ${length}` : ''}` : '사진'].filter(Boolean).join(' '),
          hearts: r?.heart ?? 0,
          says: r?.comment ?? 0,
          n: page.offset + i + 1,
          // 처음 보이는 카드와 양옆만 바로 받는다: 크게 보기에서 닫고 돌아오면(?to=) 그 카드, 아니면 앞 3장. 뒤에 이어 붙는 쪽(?before=)은 모두 나중에
          eager: !cont && (toAt >= 0 ? Math.abs(i - toAt) <= 1 : i < 3),
          first: !cont && i === (toAt >= 0 ? toAt : 0),
          href: `/view/${m.id}${viewQ}`,
          fresh: unseenIds.has(m.id),
          up: justUp(m),
          video,
          length,
        };
      }),
    );
// 엇갈린 배열 자리: 휴대폰 2줄, 넓은 화면 5줄(CSS가 화면 폭에 맞는 쪽을 씀). 1칸은 휴대폰 한 줄(원래 모양 --ar), 넓은 화면 2줄. 3·5칸은 정사각이라 자리 없음
if (z !== 3 && z !== 5)
  for (const group of [topCells, cells]) {
    const two = masonry(group.map((c) => c.ratio), 2);
    const five = masonry(group.map((c) => c.ratio), 5);
    group.forEach((c, i) => {
      c.at2 = `--c2:${two[i].col};--r2:${two[i].row};--s2:${two[i].span};--c5:${five[i].col};--r5:${five[i].row};--s5:${five[i].span};--ar:${1 / c.ratio}`;
    });
  }
