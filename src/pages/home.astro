---
// 부모 앨범: 사진이 없으면 첫 사진 안내, 있으면 월별 모아 보기. 아래 탭(앨범·설정)
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { summarize } from '../lib/familyAdmin';
import { callName, hasBatchim } from '../lib/ko';
import { splitSchedule } from '../lib/health';
import { monthsOld } from '../lib/age';
import { loadParent, seoulToday } from '../lib/parent';
import { signedMediaUrl } from '../lib/signed';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const kid = callName(a.home.children?.[0]?.name ?? '아이');
// shortcut: 최근 200장까지만. 다음 쪽 넘기기는 가족 앨범과 같이 커서로
const b = getBackend();
// 접종·검진: 일정 보기를 켠 아이마다 다음 일정 하나. 옆 기능이라 실패하면 줄만 빼고 앨범은 보인다
const today = seoulToday();
// 승인 대기·설치 부탁 띠도 옆 기능이라 실패하면 띠만 뺀다
const [items, admin, healthRows] = await Promise.all([
  b.listMedia(a.pass, { limit: 200 }),
  b.familyAdmin(a.pass).catch(() => null),
  Promise.all(
  (a.home.children ?? [])
    .filter((k) => k.show_health)
    .map(async (k) => {
      const rows = await b.healthDone(a.pass, k.id).catch(() => null);
      if (!rows) return null;
      const done = new Map(rows.map((d) => [d.item_key, d.done_on]));
      const next = splitSchedule(k.birth_date, today, done).upcoming[0];
      const [, m, d] = next?.start.split('-').map(Number) ?? [];
      // 태어난 지 며칠(서울 날짜 기준, 태어난 날이 1일째)
      const days = Math.round((Date.parse(today) - Date.parse(k.birth_date)) / 86_400_000) + 1;
      return { id: k.id, name: k.name, months: monthsOld(k.birth_date, today), days, next: next ? `${next.item.name} · ${next.state.kind === 'soon' ? `${m}월 ${d}일부터` : '지금 가능'}` : '6개월 안에는 없어요' };
    }),
  ).then((r) => r.filter((x) => x !== null)),
]);
const now = Date.now();
const s = admin && summarize(admin);
const firstWait = s && s.pendingDevices.length === 0 && s.pendingMembers.length === 1 ? s.pendingMembers[0] : null;
const ga = (w: string) => (hasBatchim(w) ? '이' : '가');
const helpers = admin?.members.filter((m) => m.status === 'active' && m.install_help_at && now - Date.parse(m.install_help_at) < 7 * 86_400_000) ?? [];
const dayFmt = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const monthFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', timeZone: 'Asia/Seoul' });
const months: { label: string; cells: { id: string; src: string; video: boolean; day: string }[] }[] = [];
for (const m of items) {
  const label = monthFmt.format(new Date(m.taken_at));
  if (months.at(-1)?.label !== label) months.push({ label, cells: [] });
  months.at(-1)!.cells.push({ id: m.id, src: await signedMediaUrl(m.thumb_key), video: m.kind === 'video', day: dayFmt.format(new Date(m.taken_at)) });
}
---

<Parent title="앨범 · 스위피" tab="home" alerts={a.home.new_activity ?? 0} wide>
  <h1 class="sp-p__title sp-p__title--large">앨범</h1>
  {Astro.url.searchParams.get('done') === 'deleted' && <p class="sp-p__toast" tabindex="-1" autofocus>지웠어요.</p>}
  {
    s && s.waiting > 0 && (
      <a class="sp-p__alert" href="/settings/family">
        <span class="sp-p__alert-text">{firstWait ? <><strong>{firstWait.display_name}</strong>{ga(firstWait.display_name)} {s.groupName(firstWait.group_id)} 앨범에 들어오려고 해요</> : s.pendingMembers.length === 0 ? <>새 휴대폰 <strong>{s.waiting}대</strong>가 들어오려고 해요</> : <><strong>{s.waiting}명</strong>이 들어오려고 해요</>}</span>
        <svg class="sp-p__icon-chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
      </a>
    )
  }
  {
    helpers.length > 0 && (
      <a class="sp-p__alert" href="/settings/family/sms">
        <span class="sp-p__alert-text"><strong>{helpers[0].display_name}</strong>{helpers.length > 1 ? ` 외 ${helpers.length - 1}명이` : ga(helpers[0].display_name)} 홈 화면에 두기를 부탁했어요</span>
        <svg class="sp-p__icon-chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
      </a>
    )
  }
  {healthRows.map((h) => (
    <a class="sp-p__kid" href={`/health/${h.id}`}>
      <img class="sp-p__kid-kongi" src="/favicon.svg" width="64" height="64" alt="" />
      <span class="sp-p__kid-text">
        <span class="sp-vh">접종·검진 일정, </span><span class="sp-p__kid-line"><strong class="sp-p__kid-name">{h.name}</strong><span class="sp-p__hint">생후 {h.months}개월 · 태어난 지 {h.days}일</span></span>
        <span class="sp-p__kid-next">{h.next}</span>
      </span>
      <svg class="sp-p__icon-chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
    </a>
  ))}
  {
    items.length === 0 ? (
      <section class="sp-p__empty" aria-labelledby="empty-title">
        <img class="sp-p__empty-kongi" src="/favicon.svg" width="128" height="128" alt="" />
        <h2 class="sp-p__empty-title" id="empty-title">{kid} 첫 사진을 올려 주세요</h2>
        <p class="sp-p__lead">올리고 카톡으로 보내면 조부모님이<br />설치 없이 바로 보실 수 있어요</p>
      </section>
    ) : (
      months.map((mo) => (
        <section class="sp-p__month" aria-label={`${mo.label} ${mo.cells.length}장`}>
          <h2 class="sp-p__month-title">{mo.label} <span class="sp-p__month-count">· {mo.cells.length}장</span></h2>
          <ul class="sp-p__grid">
            {mo.cells.map((c) => (
              <li class="sp-p__cell">
                <a class="sp-p__cell-link" href={`/photo/${c.id}`}>
                  <img class="sp-p__cell-img" src={c.src} alt={`${c.day} ${c.video ? '영상' : '사진'} 정보`} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
  <a class="sp-p__fab" href="/upload">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
    사진 추가하기
  </a>
</Parent>
