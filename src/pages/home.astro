  <div class="sp-p__album" data-album>
  {
    items.length === 0 && cont ? null : items.length === 0 && (picked || kind || group) ? (
      <p class="sp-p__lead">{group ? `${group.name}에 보이는 ` : ''}{picked ? `${callName(picked.name)} ` : ''}{kind === 'video' ? '영상은' : '사진은'} 아직 없어요.</p>
    ) : items.length === 0 ? (
      <section class="sp-p__empty" aria-labelledby="empty-title">
        <img class="sp-p__empty-kongi" src="/kongi.svg" width="128" height="128" alt="" />
        <h2 class="sp-p__empty-title" id="empty-title">{kid} 첫 사진을 올려 주세요</h2>
        <p class="sp-p__lead">올리고 카톡으로 보내면 조부모님이<br />설치 없이 보실 수 있어요</p>
        <p class="sp-p__hint">처음 들어올 때 한 번 가족 비밀번호 4자리를 물어요. 비밀번호도 같이 알려 주세요.</p>
      </section>
    ) : swipe ? (
      /* 가족 넘겨 보기와 같은 카드(swipe.css): 가운데 카드 + 양옆 비스듬히, 손가락으로 밀면 넘어감(scroll-snap). 카드 전체가 크게 보기 링크 */
      <>
      {prevHref && <LessLink href={prevHref} />}
      <ul class="sp-a__swipe sp-p__swipe" aria-label={swipeTotal === null ? '사진, 옆으로 밀어서 넘겨 보기' : `사진 ${swipeTotal.toLocaleString('ko-KR')}장, 옆으로 밀어서 넘겨 보기`}>
        {slides.map((c) => (
          <li class="sp-a__slide" id={`c-${c.id}`}>
            <a class="sp-a__card" href={c.href} aria-label={`${c.fresh ? '신규, ' : c.up ? '방금 올림, ' : ''}${c.label}${c.hearts ? `, 하트 ${c.hearts}개` : ''}${c.says ? `, 한마디 ${c.says}개` : ''} 크게 보기`}>
              {/* 사진과 그 위 표시를 한 상자로: ▶·길이·새 사진이 아래 글자 줄 말고 사진 기준으로 자리 잡게 */}
              <span class="sp-p__card-media">
                <img class="sp-a__card-img" src={c.src} alt="" loading={c.eager ? 'eager' : 'lazy'} fetchpriority={c.first ? 'high' : undefined} decoding="async" />
                {c.fresh && <span class="sp-p__new sp-p__new--card" aria-hidden="true">신규</span>}
                {c.up && <span class="sp-p__new sp-p__new--card sp-p__new--up" aria-hidden="true">방금 올림</span>}
                {/* 영상이면 사진 가운데 큰 ▶ + 길이(118, 사용자 "넘겨 보기에서 영상인지 잘 안 보여서", 가족 카드와 같은 모양) */}
                {c.video && <span class="sp-a__card-play" aria-hidden="true"><svg class="sp-a__card-play-icon" width="32" height="32" viewBox="0 0 24 24" focusable="false"><path d="M7 4.5v15L19.5 12z" /></svg></span>}
                {c.video && c.length && <span class="sp-a__card-length" aria-hidden="true">{c.length}</span>}
              </span>
              <span class="sp-a__card-cap">
                <span class="sp-a__card-day">{c.cap}</span>
                {(c.hearts > 0 || c.says > 0) && (
                  <span class="sp-p__swipe-counts" aria-hidden="true">
                    {c.hearts > 0 && <span class="sp-p__swipe-count"><span class="sp-p__swipe-heart">♥</span>{c.hearts}</span>}
                    {c.says > 0 && (
                      <span class="sp-p__swipe-count">
                        <svg class="sp-p__swipe-say" width="14" height="14" viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v11H9l-5 4z" /></svg>
                        {c.says}
                      </span>
                    )}
                  </span>
                )}
              </span>
            </a>
            <p class="sp-a__pos">
              <strong class="sp-a__pos-n">{c.n.toLocaleString('ko-KR')}</strong>{swipeTotal !== null && ` / ${swipeTotal.toLocaleString('ko-KR')}`}<span aria-hidden="true"> · 옆으로 밀거나 옆 사진을 누르세요</span>
            </p>
          </li>
        ))}
      </ul>
      </>
    ) : cards ? (
      <ul class="sp-p__mcards">
        {cards.map((c) => (
          <li>
            <a class="sp-p__mcard" href={c.href}>
              <span class={`sp-p__mcard-pics sp-p__mcard-pics--${z} sp-p__mcard-pics--n${c.pics.length}`} aria-hidden="true">
                {c.pics.map((src) => <img class="sp-p__mcard-img" src={src} alt="" loading="lazy" decoding="async" />)}
              </span>
              {/* 날짜·장 수는 사진 위(사용자 "날짜가 사진 위에") */}
              <span class="sp-p__mcard-text">
                <span class="sp-p__mcard-title">{c.label}</span>
                <span class="sp-p__mcard-count">{c.sub}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : cardView ? (
      <p class="sp-p__lead">{z === 'y' ? '해마다' : '달마다'} 모아 보기를 불러오지 못했어요. 잠시 뒤 다시 열어 주세요.</p>
    ) : (
      [
        { ym: 'new', list: topCells },
        { ym: 'all', list: cells },
      ].filter((g) => g.list.length > 0).map((g) => (
        <>
        {g.ym === 'all' && prevHref && <LessLink href={prevHref} />}
        <section class="sp-p__month" data-ym={g.ym} aria-label={g.ym === 'new' ? `방금 올라온 사진 ${g.list.length}장` : '사진'}>
          {/* 빈칸 없는 앨범(117b): 날짜는 위 기간 줄, 화면 읽기용 제목만. 맨 위 새 사진 묶음(117e)은 보이는 제목 */}
          {g.ym === 'new' ? <h2 class="sp-p__new-title">방금 올라왔어요 <span class="sp-p__new-count">· {g.list.length}장</span></h2> : <h2 class="sp-vh">사진</h2>}
          <ul class={`sp-p__grid sp-p__grid--z${z}`}>
            {g.list.map((c) => (
              <li class="sp-p__cell" id={`c-${c.id}`} style={c.at2} data-ratio={c.ratio} data-d={c.d} data-mark={c.mark ?? undefined}>
                {c.anchor && <span class="sp-p__anchor" id={`m-${c.anchor}`} aria-hidden="true" />}
                <Cell class:list={['sp-p__cell-link', sel && 'sp-p__cell-pick']} href={sel ? undefined : `/view/${c.id}?${kq}z=${z}`}>
                  {sel && <input class="sp-p__selbox" type="checkbox" name="id" value={c.id} form="sel-form" aria-describedby="sel-help" />}
                  <img
                    class="sp-p__cell-img"
                    src={c.src}
                    alt={`${c.fresh && !c.top ? '신규, ' : c.up ? '방금 올림, ' : ''}${c.day}${c.mark ? ` ${c.mark}` : ''} ${c.video ? `영상${c.length ? ` ${c.length}` : ''}` : '사진'}${c.hearts ? `, 하트 ${c.hearts}개` : ''}${c.says ? `, 한마디 ${c.says}개` : ''}`}
                    loading="lazy"
                    decoding="async"
                  />
                  {z !== 5 && (c.hearts > 0 || c.says > 0) && (
                    <span class="sp-p__cell-meta" aria-hidden="true">
                      {c.hearts > 0 && <span class="sp-p__cell-count"><span class="sp-p__cell-heart">♥</span>{c.hearts}</span>}
                      {c.says > 0 && (
                        <span class="sp-p__cell-count">
                          <svg class="sp-p__cell-say" width="14" height="14" viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v11H9l-5 4z" /></svg>
                          {c.says}
                        </span>
                      )}
                    </span>
                  )}
                  {c.video && <span class="sp-p__cell-play" aria-hidden="true"><svg class="sp-p__cell-play-icon" width="20" height="20" viewBox="0 0 24 24" focusable="false"><path d="M7 4.5v15L19.5 12z" /></svg></span>}
                  {c.video && c.length && <span class="sp-p__cell-length" aria-hidden="true">{c.length}</span>}
                  {/* 왼쪽 위 배지(119): 새 사진(틸)·기념일(분홍, 같은 알약), 둘 다면 위아래로 */}
                  {((c.fresh && !c.top) || c.up || c.mark) && (
                    <span class="sp-p__pills" aria-hidden="true">
                      {c.fresh && !c.top && <span class="sp-p__new">신규</span>}
                      {c.up && <span class="sp-p__new sp-p__new--up">방금 올림</span>}
                      {c.mark && <span class="sp-p__new sp-p__cell-mark">{c.mark.replace(/ 돌/g, '\u00a0돌')}</span>}
                    </span>
                  )}
                </Cell>
              </li>
            ))}
          </ul>
        </section>
        </>
      ))
    )
  }
  {/* 목록 끝(디자인 LoadMore): 다음 쪽 링크(스크립트가 보이기 전에 받아 붙임) 또는 이어 본 뒤 끝 */}
  {nextHref ? (
    <div class="sp-more" data-more>
      <a class="sp-more__btn" href={nextHref}>사진 더 보기</a>
    </div>
  ) : (
    page.more && (
      <p class="sp-more__end" data-more>
        <img class="sp-more__kongi" src="/kongi.svg" width="32" height="32" alt="" />처음 사진까지 모두 봤어요
      </p>
    )
  )}
  </div>
  {/* 사진 크기(디자인 ParentHomeZoom): 오른쪽 아래 떠 있는 유리 −/+. 키보드 순서도 사진 목록 뒤(화면 자리와 맞게) */}
  {items.length > 0 && !swipe && !sel && (
    <nav class="sp-p__zoom" aria-label="사진 크기">
      {/* 끝 단계는 꺼진 링크(화면 읽기에도 '사용 불가'로 들리게) */}
      <a class="sp-p__zoom-btn" href={smaller ?? undefined} role="link" aria-disabled={smaller ? undefined : 'true'} aria-label={z === 5 ? '작게(달마다 대표 사진)' : z === 'm' ? '작게(해마다 대표 사진)' : z === 'y' ? '작게' : '작게(한 줄에 더 많이)'}>−</a>
      <a class="sp-p__zoom-btn" href={bigger ?? undefined} role="link" aria-disabled={bigger ? undefined : 'true'} aria-label="크게(한 줄에 더 적게)">+</a>
    </nav>
  )}
  {/* 크게 보기 미리 받기(131, 사용자 "속도 개선"): 사진을 누르기 시작하면(손가락·마우스를 대는 순간) 브라우저가 크게 보기를 미리 받는다(크롬 계열, 지원 안 하면 무시).
     미리 받은 화면은 서버가 '봤음'을 안 남기고 실제로 열리면 화면이 남긴다 */}
  <script type="speculationrules" is:inline set:html={'{"prefetch":[{"where":{"href_matches":"/view/*"},"eagerness":"conservative"}]}'} />
</Parent>

<script>
  import { autoMore, closeReturn, keepSpot, lessMore, relayout, swipeMore } from '../lib/more';
  closeReturn();
  import { zoomInPlace } from '../lib/zoomswap';

  // 여러 장 고르기(126): 고른 수를 막대에 적고, 없으면 버튼을 끄고, 60장 넘게는 못 고르게. 이어 붙인 칸도(위임)
  const selForm = document.getElementById('sel-form') as HTMLFormElement | null;
  const selN = document.getElementById('sel-n');
  if (selForm && selN) {
    const MAX = 60;
    const btns = document.querySelectorAll<HTMLButtonElement>('button[form="sel-form"][name="do"]');
    const sync = () => {
      const n = document.querySelectorAll('.sp-p__selbox:checked').length;
      selN.textContent = n ? `${n}장 선택됨` : '사진을 골라 주세요 · 60장까지';
      btns.forEach((b) => (b.disabled = n === 0));
    };
    document.addEventListener('change', (e) => {
      const box = e.target as HTMLInputElement;
      if (!box.classList?.contains('sp-p__selbox')) return;
      if (box.checked && document.querySelectorAll('.sp-p__selbox:checked').length > MAX) {
        box.checked = false;
        selN.textContent = `${MAX}장까지 고를 수 있어요`;
        return;
      }
      sync();
    });
    // 뒤로 가기로 돌아와 체크가 남아 있어도 숫자가 맞게
    addEventListener('pageshow', sync);
    sync();
  }

  // 거르기 알약 줄(123): 고른 알약이 줄 밖(오른쪽)이면 줄만 옆으로 밀어 보이게. 크기를 그 자리에서 바꿔 줄을 새로 받은 뒤에도(132)
  const showPick = () => {
    const chipRow = document.querySelector<HTMLElement>('.sp-p__chips-list');
    const picks = chipRow?.querySelectorAll<HTMLElement>('.sp-p__chip[aria-current]');
    const lastPick = picks?.[picks.length - 1];
    if (!chipRow || !lastPick) return;
    const over = lastPick.getBoundingClientRect().right - chipRow.getBoundingClientRect().right;
    if (over > 0) chipRow.scrollLeft += over + 20;
  };
  showPick();
  document.addEventListener('sp:album-swapped', showPick);

  // 앞으로 이어 붙이기(128·129): 사진 주변만 그린 앨범에서 맨 위(넘겨 보기는 맨 앞) '최근 사진 더 보기'
  const swipeList = document.querySelector<HTMLElement>('.sp-a__swipe');
  if (swipeList) lessMore({ list: () => document.querySelector('.sp-a__swipe'), items: '.sp-a__swipe .sp-a__slide', swipe: true });
  else lessMore({ list: () => document.querySelector('.sp-p__month[data-ym="all"] .sp-p__grid'), items: '.sp-p__month[data-ym="all"] .sp-p__cell', anchor: '.sp-p__anchor', after: relayout });

  // 넘겨 보기(98d): 옆으로 밀다 남은 카드가 다섯 장쯤이면 다음 60장 카드를 뒤에 붙인다. 돌아온 카드(#c-<id>)는 브라우저가 가운데로
  const swipe = document.querySelector<HTMLElement>('.sp-a__swipe');
  if (swipe) swipeMore(swipe);
  // 다음 60장: 한 격자(117b)에 칸을 이어 붙이고 엇갈린 배열을 다시 계산
  else autoMore((doc) => {
    const added: HTMLElement[] = [];
    for (const sec of doc.querySelectorAll<HTMLElement>('.sp-p__month')) {
      const last = [...document.querySelectorAll<HTMLElement>('.sp-p__month')].at(-1);
      if (!last) break;
      const ul = last.querySelector<HTMLElement>('.sp-p__grid');
      if (last.dataset.ym === sec.dataset.ym && ul) {
        for (const li of sec.querySelectorAll<HTMLElement>('.sp-p__cell')) {
          // 쪽마다 첫 칸에 그 달 표식이 붙어 오므로, 이미 있는 달 표식은 뺀다(117b: 한 격자)
          const mark = li.querySelector<HTMLElement>('.sp-p__anchor');
          if (mark && document.getElementById(mark.id)) mark.remove();
          added.push(ul.appendChild(document.importNode(li, true)));
        }
        relayout(ul);
      } else {
        const node = document.importNode(sec, true);
        last.insertAdjacentElement('afterend', node);
        added.push(...node.querySelectorAll<HTMLElement>('.sp-p__cell'));
      }
    }
    return added;
  });
  if (!swipe) keepSpot('.sp-p__cell-link');

  // 머리 작은 줄(98c, 모아 보기만): 스크롤 따라 화면 맨 위 사진의 찍은 날, 3·5칸은 보이는 사진들의 기간('10월 1일 ~ 21일'). 한 프레임에 한 번만
  // 줄은 크기를 그 자리에서 바꿀 때 갈아 끼워지므로 그때그때 찾는다
  const head = swipe ? null : document.querySelector<HTMLElement>('.sp-p__albumhead');
  if (head) {
    const label = (d: string, withYear: boolean) => `${withYear ? `${d.slice(0, 4)}년 ` : ''}${Number(d.slice(5, 7))}월 ${Number(d.slice(8))}일`;
    let queued = false;
    const update = () => {
      queued = false;
      const when = document.querySelector<HTMLElement>('[data-when]');
      if (!when) return;
      const year = when.dataset.year;
      const top = head.getBoundingClientRect().bottom;
      const seen: string[] = [];
      for (const li of document.querySelectorAll<HTMLElement>('.sp-p__cell[data-d]')) {
        const r = li.getBoundingClientRect();
        if (r.bottom <= top) continue;
        if (r.top >= innerHeight) break;
        seen.push(li.dataset.d!);
      }
      if (!seen.length) return;
      const topMark = document.querySelector<HTMLElement>(`.sp-p__cell[data-d="${seen[0]}"][data-mark]`)?.dataset.mark;
      // 목록은 최근 것부터: 기간은 '오래된 날 ~ 최근 날'
      const newest = seen[0], oldest = seen.reduce((a, b) => (b < a ? b : a));
      const oy = oldest.slice(0, 4) !== year, ny = newest.slice(0, 4) !== oldest.slice(0, 4);
      const text =
        when.dataset.when === 'range' && oldest !== newest
          ? oldest.slice(0, 7) === newest.slice(0, 7)
            ? `${label(oldest, oy)} ~ ${Number(newest.slice(8))}일`
            : `${label(oldest, oy)} ~ ${label(newest, ny)}`
          : label(newest, newest.slice(0, 4) !== year) + (topMark ? ` · ${topMark}` : '');
      if (when.textContent !== text) when.textContent = text;
    };
    addEventListener('scroll', () => queued || ((queued = true), requestAnimationFrame(update)), { passive: true });
    document.addEventListener('sp:album-swapped', update);
    update();
  }
  // 사진 크기 −/+: 페이지 전환 없이 그 자리에서(98e, 모아 보기만)
  // 거르기 알약 줄·'선택'이 든 보기 줄도 칸 단계(z)를 링크에 들고 있어 함께 바꾼다(132)
  if (!swipe) zoomInPlace({ button: '.sp-p__zoom-btn', cell: '.sp-p__cell', head: '.sp-p__albumhead', also: ['.sp-p__zoom', '.sp-p__albumhead-sub', '.sp-p__albumhead-act', '.sp-p__chips', '.sp-p__viewrow'] });

  // 가운데 레이어(들어오기 신청·백일/생일·저장 공간): 스크립트가 있으면 모달로 올려(Esc·초점 가두기) 닫기·나중에는 그 자리에서 닫고 다음 것을 띄운다.
  // 다른 화면으로 가는 버튼(확인하기·사진 올리기·저장 용량 보기)은 지금처럼 폼으로 이동. 스크립트 없으면 모두 폼
  const LATER = new Set(['join-later', 'cop-ok', 'day-close', 'storage-later']);
  // 보이는 것 하나 → 숨겨 둔 것(백일/생일·저장 공간) 순서로 하나씩
  const all = [...document.querySelectorAll<HTMLElement>('.sp-layer')];
  const layers = all.filter((x) => !x.hidden).concat(all.filter((x) => x.hidden && x.hasAttribute('data-layer-later')));
  // dialog 모달을 모르는 옛 브라우저는 아무것도 건드리지 않는다(서버가 그린 대로 폼)
  const modalOk = typeof HTMLDialogElement !== 'undefined' && 'showModal' in HTMLDialogElement.prototype;
  // 차례가 아닌 레이어는 숨겨 둔다(서버는 열린 채 그림)
  if (modalOk) for (const w of layers) {
    w.hidden = true;
    w.querySelector('dialog')?.close();
  }
  const later = (box: HTMLDialogElement) => [...box.querySelectorAll<HTMLButtonElement>('button[name="do"]')].find((b) => LATER.has(b.value));
  const next = () => {
    const wrap = layers.shift();
    const box = wrap?.querySelector<HTMLDialogElement>('dialog');
    if (!wrap || !box) {
      // 다 닫으면 화면 제목으로(초점이 사라지지 않게)
      const h = document.querySelector<HTMLElement>('.sp-p__title');
      if (h) {
        h.tabIndex = -1;
        h.focus({ preventScroll: true });
      }
      return;
    }
    wrap.hidden = false;
    wrap.querySelector<HTMLElement>('.sp-layer__scrim')?.setAttribute('hidden', '');
    box.classList.add('sp-layer__modal');
    box.showModal();
    // 처음 초점은 레이어 제목(첫 버튼 테두리 없이, 화면 읽기는 레이어 이름부터). showModal은 첫 버튼에 주는 브라우저가 있어 직접
    box.querySelector<HTMLElement>('.sp-layer__title')?.focus();
    // Esc는 닫기·나중에와 같게(봤음을 적는다)
    box.addEventListener('cancel', (e) => {
      e.preventDefault();
      const b = later(box);
      b?.click(); // requestSubmit이 없는 사파리 15.4~15.6도 되게
    });
    box.addEventListener('submit', (e) => {
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!btn || !LATER.has(btn.value)) return;
      e.preventDefault();
      const body = new FormData(e.target as HTMLFormElement);
      body.append(btn.name, btn.value);
      // 바로 닫고 봤음은 뒤에서 적는다(keepalive: 곧바로 다른 화면으로 가도 끝까지 보냄). shortcut: 적기에 실패하면 다음에 열 때 다시 뜸(닫기라서 안내하지 않음)
      // keepalive 빼기(157, 사용자 "아빠가 관리하기 시작했다고 계속 뜨네"): 아이폰 사파리는 keepalive 요청 응답의 쿠키를 안 남기는 것으로 보여 '봤음'이 안 적혔음(재현은 크롬만, 원인 추정)
      fetch(location.pathname, { method: 'POST', body, credentials: 'same-origin', headers: { 'x-sp-inplace': '1' } }).catch(() => {});
      box.close();
      wrap.remove();
      next();
    });
  };
  if (layers.length && modalOk) next();
</script>
