---
// 부모 앨범: 사진이 없으면 첫 사진 안내, 있으면 월별 모아 보기. 아래 탭(앨범·설정)
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { sizeLabel, summarize } from '../lib/familyAdmin';
import { callName, hasBatchim } from '../lib/ko';
import { agoLabel, milestone, monthsOld } from '../lib/age';
import { loadParent, seoulToday } from '../lib/parent';
import { signedMediaUrl } from '../lib/signed';
import { loadPage, loadReacts } from '../lib/album';
import { masonry, ratioOf } from '../lib/masonry';
import { EMOJI } from '../lib/emoji';
import { JOIN_SEEN, MILESTONE_SEEN, STORAGE_SEEN, seenAt, setLayerCookie } from '../lib/layers';

Astro.response.headers.set('cache-control', 'private, no-store');
// 가운데 레이어 버튼: 지금 보이는 것까지 '봤음'으로 적고 이동(PRG). 닫기·나중에를 스크립트가 그 자리에서 보내면(x-sp-inplace) 적기만 하고 204
const GO: Record<string, string> = { 'join-check': '/settings/family', 'day-upload': '/upload', 'storage-view': '/settings/storage' };
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const at = String(form?.get('at') ?? '');
  const day = String(form?.get('day') ?? '');
  const level = String(form?.get('level') ?? '');
  if (Number.isFinite(Date.parse(at))) setLayerCookie(Astro.cookies, JOIN_SEEN, new Date(at).toISOString());
  if (/^[\w-]{1,64}:\d{4}-\d{2}-\d{2}$/.test(day)) setLayerCookie(Astro.cookies, MILESTONE_SEEN, day);
  if (level === '90' || level === '100') setLayerCookie(Astro.cookies, STORAGE_SEEN, level);
  const go = GO[String(form?.get('do'))];
  if (!go && Astro.request.headers.get('x-sp-inplace') === '1') return new Response(null, { status: 204 });
  return Astro.redirect(go ?? '/home', 303);
}
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const kid = callName(a.home.children?.[0]?.name ?? '아이');
// 아이 고르기(아이가 둘 이상일 때): ?k=아이id, 모르는 값이면 전체
const kids = a.home.children ?? [];
const picked = kids.length > 1 ? kids.find((k) => k.id === Astro.url.searchParams.get('k')) : undefined;
const b = getBackend();
// 60장씩: ?before=<찍은 날~id>는 다음 쪽(스크립트가 받아 이어 붙임, 스크립트 없으면 그 쪽만), ?to=<id>는 크게 보기에서 닫고 돌아와 그 사진까지
const cont = Astro.url.searchParams.has('before');
const today = seoulToday();
// 승인 대기·설치 부탁 띠도 옆 기능이라 실패하면 띠만 뺀다
// 이어지는 쪽은 사진만 쓰므로 띠는 건너뛴다
const [page, admin] = await Promise.all([
  loadPage(a.pass, { childId: picked?.id }, Astro.url),
  cont ? null : b.familyAdmin(a.pass).catch(() => null),
]);
const { items } = page;
const kq = picked ? `k=${encodeURIComponent(picked.id)}&` : '';
const nextHref = page.next ? `/home?${kq}before=${encodeURIComponent(page.next)}` : null;
const now = Date.now();
const s = admin && summarize(admin);
const firstWait = s && s.pendingDevices.length === 0 && s.pendingMembers.length === 1 ? s.pendingMembers[0] : null;
const ga = (w: string) => (hasBatchim(w) ? '이' : '가');
// 가운데 레이어: 아직 닫지 않은 들어오기 신청 중 가장 최근 것(새 휴대폰 포함)
const joinSeen = seenAt(Astro.cookies, JOIN_SEEN) ?? 0;
const joins = s
  ? [
      ...s.pendingMembers.map((m) => ({ who: m.display_name, what: `${s.groupName(m.group_id)} 앨범에 들어오려고 해요`, at: m.created_at, expires: true })),
      ...s.pendingDevices.map((d) => ({
        who: admin!.members.find((m) => m.id === (d.member_id ?? d.requested_member_id))?.display_name ?? d.requested_name ?? '가족',
        what: '새 휴대폰으로 들어오려고 해요',
        at: d.created_at,
        expires: false,
      })),
    ].sort((x, y) => Date.parse(y.at) - Date.parse(x.at))
  : [];
const join = joins[0] && Date.parse(joins[0].at) > joinSeen ? joins[0] : null;
// 백일·돌·생일: 그날 한 번(아이 여럿이면 첫 아이)
// 들어오기 신청이 있으면 숨겨 두었다가(스크립트 없으면 다음에 열 때) 그 레이어를 닫은 뒤 띄운다
const dayKid = (a.home.children ?? []).map((k) => ({ k, what: milestone(k.birth_date, today) })).find((x) => x.what);
const dayKey = dayKid ? `${dayKid.k.id}:${today}` : '';
const birthday = dayKid && Astro.cookies.get(MILESTONE_SEEN)?.value !== dayKey ? { title: `오늘은 ${callName(dayKid.k.name)}`, what: dayKid.what! } : null;
const birthdayLater = !!join;
// 저장 공간: 무료 5GB의 90%·100%에서 한 번씩. 90 밑으로 내려가면 기록을 지워 다시 넘을 때 또 뜸
// shortcut: 가족 플랜(plan_until 있음)은 상한이 달라 건너뜀, 결제 이슈에서 플랜별 상한으로
const LIMIT = 5 * 1024 ** 3;
const usedBytes = a.home.storage_used_bytes ?? 0;
const pct = Math.min(100, Math.floor((usedBytes / LIMIT) * 100));
const level = a.home.plan_until ? null : pct >= 100 ? '100' : pct >= 90 ? '90' : null;
const storageSeen = Number(Astro.cookies.get(STORAGE_SEEN)?.value ?? 0);
if (!level && storageSeen) Astro.cookies.delete(STORAGE_SEEN, { path: '/' });
const storage = level && Number(level) > storageSeen ? { level, full: level === '100' } : null;
// 들어오기 신청·백일/생일과 겹치면 숨겨 둔다(위와 같이). 레이어는 한 번에 하나: 들어오기 신청 → 백일/생일 → 저장 공간
const storageLater = !!(join || birthday);
const helpers = admin?.members.filter((m) => m.status === 'active' && m.install_help_at && now - Date.parse(m.install_help_at) < 7 * 86_400_000) ?? [];
const dayFmt = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const monthFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', timeZone: 'Asia/Seoul' });
// 칸마다 받은 하트·한마디 수(디자인: 칸 왼쪽 아래 알약). 옆 기능이라 실패하면 알약만 뺀다
const reacts = await loadReacts(a.pass, items.map((m) => m.id)).catch(() => null);
const clock = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}`;
type Cell = { id: string; src: string; video: boolean; day: string; ratio: number; hearts: number; says: number; length: string | null; at2?: string };
const months: { ym: string; label: string; age: string; count: number; cells: Cell[] }[] = [];
// 달 제목(디자인): 올해면 '10월', 아니면 '2025년 10월'. 오른쪽에 그 달 끝(이번 달이면 오늘) 아이 개월 수 · 사진 수
const ageKid = picked ?? (kids.length === 1 ? kids[0] : undefined);
const seoulYM = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit' }).format(new Date(iso));
for (const m of items) {
  const ym = seoulYM(m.taken_at);
  const label = ym.slice(0, 4) === today.slice(0, 4) ? `${Number(ym.slice(5, 7))}월` : monthFmt.format(new Date(m.taken_at));
  if (months.at(-1)?.label !== label) {
    const end = ym === today.slice(0, 7) ? today : new Date(Date.UTC(Number(ym.slice(0, 4)), Number(ym.slice(5, 7)), 0)).toISOString().slice(0, 10);
    months.push({ ym, label, age: ageKid && end >= ageKid.birth_date ? `${ageKid.name} 생후 ${monthsOld(ageKid.birth_date, end)}개월 · ` : '', count: 0, cells: [] });
  }
  const r = reacts?.get(m.id)?.counts;
  months.at(-1)!.cells.push({
    id: m.id,
    src: await signedMediaUrl(m.thumb_key),
    video: m.kind === 'video',
    day: dayFmt.format(new Date(m.taken_at)),
    ratio: ratioOf(m.width, m.height),
    hearts: r?.heart ?? 0,
    says: r?.comment ?? 0,
    length: m.kind === 'video' && m.duration_sec ? clock(Number(m.duration_sec)) : null,
  });
}
// 달 사진 수는 그 달 전체(서울 달 기준). 쪽 가운데 달은 칸 수가 곧 전체라, 쪽 경계에 걸칠 수 있는 첫 달(앞 쪽이 있을 때)·끝 달(다음 쪽이 있을 때)만 센다
const nextYM = (ym: string) => (ym.slice(5) === '12' ? `${Number(ym.slice(0, 4)) + 1}-01` : `${ym.slice(0, 4)}-${String(Number(ym.slice(5)) + 1).padStart(2, '0')}`);
await Promise.all(
  months.map(async (mo, i) => {
    mo.count = mo.cells.length;
    if (!((i === 0 && page.offset > 0) || (i === months.length - 1 && page.next))) return;
    mo.count = await b.countMedia(a.pass, { childId: picked?.id, takenFrom: `${mo.ym}-01T00:00:00+09:00`, takenBefore: `${nextYM(mo.ym)}-01T00:00:00+09:00` }).catch(() => mo.cells.length);
  }),
);
// 엇갈린 배열 자리: 휴대폰 2줄, 넓은 화면 4줄(CSS가 화면 폭에 맞는 쪽을 씀)
for (const mo of months) {
  const two = masonry(mo.cells.map((c) => c.ratio), 2);
  const four = masonry(mo.cells.map((c) => c.ratio), 4);
  mo.cells.forEach((c, i) => {
    c.at2 = `--c2:${two[i].col};--r2:${two[i].row};--s2:${two[i].span};--c4:${four[i].col};--r4:${four[i].row};--s4:${four[i].span}`;
  });
}
---

<Parent title="앨범 · 스위피" tab="home" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0} wide>
  {/* 위에 붙는 머리(디자인 ParentHomeBleed, 아이폰 사진 앱처럼 사진이 밑으로 흐리게 지나감). 아이를 고르면 수는 가족 전체라 숨김 */}
  <header class="sp-p__albumhead">
    <h1 class="sp-p__title sp-p__title--large">앨범</h1>
    {!picked && (a.home.photo_count ?? 0) + (a.home.video_count ?? 0) > 0 && (
      <p class="sp-p__albumhead-sub">{[['사진', a.home.photo_count ?? 0], ['영상', a.home.video_count ?? 0]].filter(([, n]) => +n > 0).map(([w, n]) => `${w} ${n.toLocaleString('ko-KR')}`).join(' · ')}</p>
    )}
  </header>
  {
    join && (
      <div class="sp-layer">
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box" open aria-labelledby="join-t" aria-describedby="join-d">
          <span class="sp-layer__emoji" aria-hidden="true">{EMOJI.sparkle.char}</span>
          <h2 class="sp-layer__title" id="join-t"><strong>{join.who}</strong>{ga(join.who)} {join.what}</h2>
          <p class="sp-layer__text" id="join-d">{agoLabel(join.at, now)} 신청했어요.{joins.length > 1 && ` 기다리는 사람이 ${joins.length}명 있어요.`}{join.expires && ' 3일 안에 확인하지 않으면 자동으로 취소돼요.'}</p>
          <form class="sp-layer__actions" method="post">
            <input type="hidden" name="at" value={joins[0].at} />
            <button class="sp-p__btn" type="submit" name="do" value="join-check" autofocus>확인하기</button>
            <button class="sp-p__btn sp-p__btn--quiet" type="submit" name="do" value="join-later">나중에</button>
          </form>
        </dialog>
      </div>
    )
  }
  {
    birthday && (
      <div class="sp-layer" hidden={birthdayLater} data-layer-later={birthdayLater ? '' : undefined}>
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box" open aria-labelledby="day-t" aria-describedby="day-d">
          <img class="sp-layer__kongi" src="/kongi.svg" width="96" height="96" alt="" />
          <h2 class="sp-layer__title" id="day-t">{birthday.title}<br />{birthday.what}</h2>
          <p class="sp-layer__text" id="day-d">오늘 찍은 사진을 올려서 가족과 함께 축하해요.</p>
          <form class="sp-layer__actions" method="post">
            <input type="hidden" name="day" value={dayKey} />
            <button class="sp-p__btn" type="submit" name="do" value="day-upload" autofocus>사진 올리기</button>
            <button class="sp-p__btn sp-p__btn--quiet" type="submit" name="do" value="day-close">닫기</button>
          </form>
        </dialog>
      </div>
    )
  }
  {
    storage && (
      <div class="sp-layer" hidden={storageLater} data-layer-later={storageLater ? '' : undefined}>
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box" open aria-labelledby="storage-t" aria-describedby="storage-d">
          <h2 class="sp-layer__title" id="storage-t">저장 공간이 {storage.full ? '다' : '거의'} 찼어요</h2>
          <meter class="sp-p__meter sp-layer__meter" min="0" max="100" low="80" high="95" optimum="0" value={pct} aria-label={`5GB 중 ${pct}% 사용`}>{pct}%</meter>
          <p class="sp-layer__text" id="storage-d">5GB 중 {sizeLabel(usedBytes)}를 쓰고 있어요. 5GB가 차면 새로 올리기만 멈추고, 가족은 계속 볼 수 있어요.</p>
          <form class="sp-layer__actions" method="post">
            <input type="hidden" name="level" value={storage.level} />
            <button class="sp-p__btn" type="submit" name="do" value="storage-view" autofocus>저장 용량 보기</button>
            <button class="sp-p__btn sp-p__btn--quiet" type="submit" name="do" value="storage-later">나중에</button>
          </form>
        </dialog>
      </div>
    )
  }
  {Astro.url.searchParams.get('done') === 'deleted' && <p class="sp-p__toast" tabindex="-1" autofocus={!join && !birthday && !storage}>지웠어요.</p>}
  {Astro.url.searchParams.get('joined') === '1' && <p class="sp-p__toast" tabindex="-1" autofocus={!join && !birthday && !storage}>이제 {callName(a.home.children?.[0]?.name ?? '아이')} 앨범을 함께 관리해요.</p>}
  {
    s && s.waiting > 0 && (
      <a class="sp-p__alert" href="/settings/family">
        <span class="sp-p__alert-text">{firstWait ? <><strong>{firstWait.display_name}</strong>{ga(firstWait.display_name)} {s.groupName(firstWait.group_id)} 앨범에 들어오려고 해요</> : s.pendingMembers.length === 0 ? <>새 휴대폰 <strong>{s.waiting}대</strong>가 들어오려고 해요</> : <><strong>{s.waiting}명</strong>이 들어오려고 해요</>}</span>
        <svg class="sp-p__icon-chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
      </a>
    )
  }
  {
    helpers.length > 0 && (
      <a class="sp-p__alert" href="/settings/family/sms">
        <span class="sp-p__alert-text"><strong>{helpers[0].display_name}</strong>{helpers.length > 1 ? ` 외 ${helpers.length - 1}명이` : ga(helpers[0].display_name)} 홈 화면에 두기를 부탁했어요</span>
        <svg class="sp-p__icon-chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
      </a>
    )
  }
  {
    kids.length > 1 && (
      <nav class="sp-p__seg" aria-label="아이 고르기">
        <a class="sp-p__seg-item" href="/home" aria-current={!picked ? 'page' : undefined}>전체</a>
        {kids.map((k) => (
          <a class="sp-p__seg-item" href={`/home?k=${encodeURIComponent(k.id)}`} aria-current={picked?.id === k.id ? 'page' : undefined}>{k.name}</a>
        ))}
      </nav>
    )
  }
  {
    items.length === 0 && cont ? null : items.length === 0 && picked ? (
      <p class="sp-p__lead">{callName(picked.name)} 사진은 아직 없어요.</p>
    ) : items.length === 0 ? (
      <section class="sp-p__empty" aria-labelledby="empty-title">
        <img class="sp-p__empty-kongi" src="/kongi.svg" width="128" height="128" alt="" />
        <h2 class="sp-p__empty-title" id="empty-title">{kid} 첫 사진을 올려 주세요</h2>
        <p class="sp-p__lead">올리고 카톡으로 보내면 조부모님이<br />설치 없이 바로 보실 수 있어요</p>
      </section>
    ) : (
      months.map((mo) => (
        <section class="sp-p__month" data-ym={mo.ym} aria-label={`${mo.label} ${mo.count}장`}>
          <div class="sp-p__month-head">
            <h2 class="sp-p__month-title">{mo.label}</h2>
            <p class="sp-p__month-count">{mo.age}사진 {mo.count}</p>
          </div>
          <ul class="sp-p__grid">
            {mo.cells.map((c) => (
              <li class="sp-p__cell" id={`c-${c.id}`} style={c.at2} data-ratio={c.ratio}>
                <a class="sp-p__cell-link" href={`/view/${c.id}${picked ? `?k=${encodeURIComponent(picked.id)}` : ''}`}>
                  <img
                    class="sp-p__cell-img"
                    src={c.src}
                    alt={`${c.day} ${c.video ? `영상${c.length ? ` ${c.length}` : ''}` : '사진'}${c.hearts ? `, 하트 ${c.hearts}개` : ''}${c.says ? `, 한마디 ${c.says}개` : ''}`}
                    loading="lazy"
                    decoding="async"
                  />
                  {(c.hearts > 0 || c.says > 0) && (
                    <span class="sp-p__cell-meta" aria-hidden="true">
                      {c.hearts > 0 && <span class="sp-p__cell-count"><span class="sp-p__cell-heart">♥</span>{c.hearts}</span>}
                      {c.says > 0 && (
                        <span class="sp-p__cell-count">
                          <svg class="sp-p__cell-say" width="14" height="14" viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v11H9l-5 4z" /></svg>
                          {c.says}
                        </span>
                      )}
                    </span>
                  )}
                  {c.length && <span class="sp-p__cell-length" aria-hidden="true">{c.length}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
  {/* 목록 끝(디자인 LoadMore): 다음 쪽 링크(스크립트가 보이기 전에 받아 붙임) 또는 이어 본 뒤 끝 */}
  {nextHref ? (
    <div class="sp-more" data-more>
      <a class="sp-more__btn" href={nextHref}>사진 더 보기</a>
    </div>
  ) : (
    page.more && (
      <p class="sp-more__end" data-more>
        <img class="sp-more__kongi" src="/kongi.svg" width="32" height="32" alt="" />처음 사진까지 모두 봤어요
      </p>
    )
  )}
</Parent>

<script>
  import { autoMore, keepSpot, relayout } from '../lib/more';

  // 다음 60장: 같은 달이면 그 달에 칸을 합치고, 아니면 달 묶음을 뒤에 붙인다(달 사진 수는 서버가 그 달 전체로 셈)
  autoMore((doc) => {
    const added: HTMLElement[] = [];
    for (const sec of doc.querySelectorAll<HTMLElement>('.sp-p__month')) {
      const last = [...document.querySelectorAll<HTMLElement>('.sp-p__month')].at(-1);
      if (!last) break;
      const ul = last.querySelector<HTMLElement>('.sp-p__grid');
      if (last.dataset.ym === sec.dataset.ym && ul) {
        for (const li of sec.querySelectorAll<HTMLElement>('.sp-p__cell')) added.push(ul.appendChild(document.importNode(li, true)));
        relayout(ul);
      } else {
        const node = document.importNode(sec, true);
        last.insertAdjacentElement('afterend', node);
        added.push(...node.querySelectorAll<HTMLElement>('.sp-p__cell'));
      }
    }
    return added;
  });
  keepSpot('.sp-p__cell-link');

  // 가운데 레이어(들어오기 신청·백일/생일·저장 공간): 스크립트가 있으면 모달로 올려(Esc·초점 가두기) 닫기·나중에는 그 자리에서 닫고 다음 것을 띄운다.
  // 다른 화면으로 가는 버튼(확인하기·사진 올리기·저장 용량 보기)은 지금처럼 폼으로 이동. 스크립트 없으면 모두 폼
  const LATER = new Set(['join-later', 'day-close', 'storage-later']);
  // 보이는 것 하나 → 숨겨 둔 것(백일/생일·저장 공간) 순서로 하나씩
  const all = [...document.querySelectorAll<HTMLElement>('.sp-layer')];
  const layers = all.filter((x) => !x.hidden).concat(all.filter((x) => x.hidden && x.hasAttribute('data-layer-later')));
  // dialog 모달을 모르는 옛 브라우저는 아무것도 건드리지 않는다(서버가 그린 대로 폼)
  const modalOk = typeof HTMLDialogElement !== 'undefined' && 'showModal' in HTMLDialogElement.prototype;
  // 차례가 아닌 레이어는 숨겨 둔다(서버는 열린 채 그림)
  if (modalOk) for (const w of layers) {
    w.hidden = true;
    w.querySelector('dialog')?.close();
  }
  const later = (box: HTMLDialogElement) => [...box.querySelectorAll<HTMLButtonElement>('button[name="do"]')].find((b) => LATER.has(b.value));
  const next = () => {
    const wrap = layers.shift();
    const box = wrap?.querySelector<HTMLDialogElement>('dialog');
    if (!wrap || !box) {
      // 다 닫으면 화면 제목으로(초점이 사라지지 않게)
      const h = document.querySelector<HTMLElement>('.sp-p__title');
      if (h) {
        h.tabIndex = -1;
        h.focus({ preventScroll: true });
      }
      return;
    }
    wrap.hidden = false;
    wrap.querySelector<HTMLElement>('.sp-layer__scrim')?.setAttribute('hidden', '');
    box.classList.add('sp-layer__modal');
    box.showModal();
    // Esc는 닫기·나중에와 같게(봤음을 적는다)
    box.addEventListener('cancel', (e) => {
      e.preventDefault();
      const b = later(box);
      b?.click(); // requestSubmit이 없는 사파리 15.4~15.6도 되게
    });
    box.addEventListener('submit', (e) => {
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!btn || !LATER.has(btn.value)) return;
      e.preventDefault();
      const body = new FormData(e.target as HTMLFormElement);
      body.append(btn.name, btn.value);
      // 바로 닫고 봤음은 뒤에서 적는다(keepalive: 곧바로 다른 화면으로 가도 끝까지 보냄). shortcut: 적기에 실패하면 다음에 열 때 다시 뜸(닫기라서 안내하지 않음)
      fetch(location.pathname, { method: 'POST', body, credentials: 'same-origin', headers: { 'x-sp-inplace': '1' }, keepalive: true }).catch(() => {});
      box.close();
      wrap.remove();
      next();
    });
  };
  if (layers.length && modalOk) next();
</script>
