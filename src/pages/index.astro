---
// 대표 첫 화면(디자인 Landing). 이미 들어온 기기면 앨범으로, 처음 온 사람(엄마아빠·검색)에겐 소개 한 장
import { SITE_ORIGIN } from 'astro:env/server';
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { currentPass, PARENT } from '../lib/pass';
import { isOpen } from '../lib/families';

// 홈 화면 아이콘(시작 주소 /)으로 연 부모는 부모 앨범으로
if (Astro.cookies.has(PARENT)) return Astro.redirect('/home');
// 출입증이 없으면 백엔드를 부르지 않는다(첫 방문·성능 검사에서 외부 호출 없음)
const pass = await currentPass(Astro.cookies);
if (pass) {
  const { families } = await getBackend().me(pass);
  if (families.some(isOpen)) return Astro.redirect('/album');
  if (families.length) return Astro.redirect('/wait');
}
const home = `${(SITE_ORIGIN || Astro.url.origin).replace(/\/$/, '')}/`;
// 문구(92, 카피라이팅 스킬 + 리서치): 지금 불편 → 바뀐 모습 → 시작 방법. 제품 사실만(지어낸 숫자·후기 없음), 디자인 Landing
const pains = ['단톡방에 올린 사진이 만료돼서 다시 보내 달라는 연락을 받았어요', '앱을 깔아 드렸는데 비밀번호를 잊으셔서 못 보세요', '시댁과 친정에 같은 사진을 따로따로 보내요'];
const steps = [
  { title: '사진 올리기', text: '폰에서 고르면 보기 좋은 크기로 줄여서 올려요. 영상도 돼요.' },
  { title: '카톡으로 링크 보내기', text: '외가·친가처럼 볼 사람을 나눠서 보낼 수 있어요.' },
  { title: '가족은 누르면 끝', text: '처음 한 번만 이름과 가족 비밀번호를 넣으면 다음부터는 바로 열려요.' },
];
// 좋은 점 3개는 소개 3장(/start)과 같은 그림
const feats = [
  { title: '할머니 휴대폰에 앱이 없어도 돼요', text: ['카톡 링크만 누르면 바로 열려요.', '글씨도 크게 키워서 볼 수 있어요.'] },
  { title: '누가 볼지는 엄마아빠가 정해요', text: ['외가·친가처럼 그룹을 나누고,', '처음 들어오는 사람은 승인해야 봐요.'] },
  { title: '하트와 한마디가 돌아와요', text: ['할머니가 남긴 하트와 한마디를 모아 보고,', '콩이도 아이 나이에 맞춰 함께 자라요.'] },
];
const faq = [
  { q: '조부모님 휴대폰에 앱을 깔아야 하나요?', a: '아니요. 카톡이나 문자로 받은 링크를 누르면 바로 열려요. 처음 한 번만 이름과 가족 비밀번호를 넣어요.' },
  { q: '링크만 있으면 아무나 볼 수 있나요?', a: '아니요. 처음 들어오는 사람은 엄마아빠가 승인해야 사진을 볼 수 있어요. 그룹마다 볼 수 있는 사진도 따로 정해요.' },
  { q: '사진은 얼마나 보관되나요?', a: '지우기 전까지 계속 남아요. 무료로 5GB까지 올릴 수 있고, 다 차면 새로 올리기만 멈추고 가족은 계속 볼 수 있어요.' },
  { q: '원본 화질로 올라가나요?', a: '앨범에서 보기 좋은 크기로 줄여서 올려요(영상은 1080p). 스위피는 원본을 따로 보관하지 않으니 원본은 폰에 남겨 두세요.' },
  { q: '돈이 드나요?', a: '무료로 시작할 수 있어요. 저장 공간 5GB까지 무료예요.' },
];
// 검색 결과에 질문·답이 보이게(구조화 데이터). '<'는 스크립트가 끊기지 않게 바꾼다
const faqLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }).replace(/</g, '\\u003c');
---

<Parent
  title="스위피 · 아기 사진을 카톡 링크로 조부모님과 함께 보는 가족 앨범"
  description="아기 사진을 올리고 카톡으로 링크만 보내면 할머니·할아버지는 앱 설치도 가입도 없이 바로 봐요. 외가·친가는 따로, 처음 오는 사람은 엄마아빠가 승인해요. 무료 5GB로 시작하세요."
  canonical={home}
>
  <header class="sp-p__brand sp-p__brand--landing">
    <img class="sp-p__brand-kongi sp-p__brand-kongi--sm" src="/kongi.svg" width="96" height="96" alt="" />
    <p class="sp-p__landing-name">스위피</p>
    <h1 class="sp-p__landing-title">아기 사진, 링크 하나면<br />할머니도 바로 봐요</h1>
    <p class="sp-p__brand-text">앱 설치도, 가입도 없이. 스위피에 올리고 카톡으로 링크만 보내세요. 사진은 사라지지 않고 가족 앨범에 쌓여요.</p>
    <div class="sp-p__landing-cta">
      <a class="sp-p__login" href="/login">무료로 시작하기</a>
      <p class="sp-p__fine">무료 5GB로 시작해요</p>
      <p class="sp-p__note sp-p__landing-family">가족에게 링크를 받으셨나요? 받은 링크를 눌러 주세요</p>
    </div>
  </header>
  <section class="sp-p__landing-sec" aria-labelledby="pain">
    <h2 class="sp-p__feature-title" id="pain">이런 적 있으세요?</h2>
    <ul class="sp-p__pains">
      {pains.map((p) => <li class="sp-p__pain">{p}</li>)}
    </ul>
  </section>
  <section class="sp-p__landing-sec" aria-labelledby="how">
    <h2 class="sp-p__feature-title" id="how">이렇게 써요</h2>
    <ol class="sp-p__steps">
      {
        steps.map((st, i) => (
          <li class="sp-p__step">
            <span class="sp-p__step-n" aria-hidden="true">{i + 1}</span>
            <span class="sp-p__step-text"><strong class="sp-p__step-title">{st.title}</strong>{st.text}</span>
          </li>
        ))
      }
    </ol>
  </section>
  {
    feats.map((f, i) => (
      <section class="sp-p__feature" aria-labelledby={`f${i + 1}`}>
        <div class="sp-p__intro-art" aria-hidden="true">
          {i === 0 ? (
            <div class="sp-p__mock">
              <div class="sp-p__mock-photo" />
              <p class="sp-p__mock-title">하린이 새 사진 12장</p>
              <p class="sp-p__mock-sub">설치 없이 바로 볼 수 있어요</p>
              <span class="sp-p__mock-btn">앨범 보기</span>
            </div>
          ) : i === 1 ? (
            <div class="sp-p__mock">
              <p class="sp-p__mock-sub">보낼 가족</p>
              <p class="sp-p__mock-chips"><span class="sp-p__mock-chip sp-p__mock-chip--on">✓ 외가</span><span class="sp-p__mock-chip">친가</span></p>
              <p class="sp-p__mock-row"><span class="sp-p__mock-av">큰</span><span class="sp-p__mock-who"><b>큰이모</b><br />들어오려고 해요</span><span class="sp-p__mock-ok">승인</span></p>
            </div>
          ) : (
            <div class="sp-p__mock">
              <img src="/kongi.svg" width="96" height="96" alt="" class="sp-p__mock-kongi" />
              <p class="sp-p__mock-line"><b>외할머니</b> 하트를 보냈어요</p>
              <p class="sp-p__mock-line"><b>외할아버지</b> "아이고 많이 컸네"</p>
            </div>
          )}
        </div>
        <h2 class="sp-p__feature-title" id={`f${i + 1}`}>{f.title}</h2>
        <p class="sp-p__intro-text">{f.text[0]}<br />{f.text[1]}</p>
      </section>
    ))
  }
  <section class="sp-p__landing-sec" aria-labelledby="faq">
    <h2 class="sp-p__feature-title" id="faq">자주 묻는 질문</h2>
    <div class="sp-p__faq">
      {
        faq.map((f, i) => (
          <details class="sp-p__faq-item" open={i === 0}>
            <summary class="sp-p__faq-q">{f.q}</summary>
            <p class="sp-p__faq-a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
  <section class="sp-p__landing-end" aria-labelledby="go">
    <h2 class="sp-p__feature-title" id="go">오늘 찍은 사진, 오늘 할머니께</h2>
    <a class="sp-p__login" href="/login">무료로 시작하기</a>
  </section>
  <footer class="sp-p__landing-foot">스위피 · sweepea.co.kr</footer>
  <script type="application/ld+json" is:inline set:html={faqLd} />
</Parent>
