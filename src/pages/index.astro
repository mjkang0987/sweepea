---
// 대표 첫 화면(디자인 Landing). 이미 들어온 기기면 앨범으로, 처음 온 사람(엄마아빠·검색)에겐 소개 한 장
import { SITE_ORIGIN } from 'astro:env/server';
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { currentPass, PARENT } from '../lib/pass';
import { isOpen } from '../lib/families';

// 홈 화면 아이콘(시작 주소 /)으로 연 부모는 부모 앨범으로
if (Astro.cookies.has(PARENT)) return Astro.redirect('/home');
// 출입증이 없으면 백엔드를 부르지 않는다(첫 방문·성능 검사에서 외부 호출 없음)
const pass = await currentPass(Astro.cookies);
if (pass) {
  const { families } = await getBackend().me(pass);
  if (families.some(isOpen)) return Astro.redirect('/album');
  if (families.length) return Astro.redirect('/wait');
}
const home = `${(SITE_ORIGIN || Astro.url.origin).replace(/\/$/, '')}/`;
// 소개 3장(/start)과 같은 문구·그림
const feats = [
  { title: '카톡으로 보내면 끝', text: ['가족은 앱 설치도, 가입도 없이', '링크만 누르면 바로 보세요'] },
  { title: '누가 볼지는 내가 정해요', text: ['외가·친가처럼 나눠 보낼 수 있고,', '처음 들어오는 사람은 내가 승인해요'] },
  { title: '하트와 한마디가 나에게 와요', text: ['사진은 사라지지 않고 쌓이고,', '콩이도 아이 나이에 맞춰 함께 자라요'] },
];
---

<Parent title="스위피 · 카톡으로 보내고 설치 없이 보는 가족 앨범" description="아이 사진을 카톡 링크로 보내면 조부모님은 앱 설치도 가입도 없이 바로 봐요. 누가 볼지는 엄마아빠가 정하고, 하트와 한마디가 돌아와요." canonical={home}>
  <section class="sp-p__brand sp-p__brand--landing" aria-labelledby="brand">
    <img class="sp-p__brand-kongi" src="/kongi.svg" width="128" height="128" alt="" />
    <h1 class="sp-p__brand-name" id="brand">스위피</h1>
    <p class="sp-p__brand-text">카톡으로 보내고, 설치 없이 보고,<br />사라지지 않는 가족 앨범</p>
    <div class="sp-p__landing-cta">
      <a class="sp-p__login" href="/login">시작하기</a>
      <p class="sp-p__note">가족에게 링크를 받으셨나요? 받은 링크를 눌러 주세요</p>
    </div>
  </section>
  {
    feats.map((f, i) => (
      <section class="sp-p__feature" aria-labelledby={`f${i + 1}`}>
        <div class="sp-p__intro-art" aria-hidden="true">
          {i === 0 ? (
            <div class="sp-p__mock">
              <div class="sp-p__mock-photo" />
              <p class="sp-p__mock-title">하린이 새 사진 12장</p>
              <p class="sp-p__mock-sub">설치 없이 바로 볼 수 있어요</p>
              <span class="sp-p__mock-btn">앨범 보기</span>
            </div>
          ) : i === 1 ? (
            <div class="sp-p__mock">
              <p class="sp-p__mock-sub">보낼 가족</p>
              <p class="sp-p__mock-chips"><span class="sp-p__mock-chip sp-p__mock-chip--on">✓ 외가</span><span class="sp-p__mock-chip">친가</span></p>
              <p class="sp-p__mock-row"><span class="sp-p__mock-av">큰</span><span class="sp-p__mock-who"><b>큰이모</b><br />들어오려고 해요</span><span class="sp-p__mock-ok">승인</span></p>
            </div>
          ) : (
            <div class="sp-p__mock">
              <img src="/kongi.svg" width="96" height="96" alt="" class="sp-p__mock-kongi" />
              <p class="sp-p__mock-line"><b>외할머니</b> 하트를 보냈어요</p>
              <p class="sp-p__mock-line"><b>외할아버지</b> "아이고 많이 컸네"</p>
            </div>
          )}
        </div>
        <h2 class="sp-p__feature-title" id={`f${i + 1}`}>{f.title}</h2>
        <p class="sp-p__intro-text">{f.text[0]}<br />{f.text[1]}</p>
      </section>
    ))
  }
  <div class="sp-p__landing-cta sp-p__landing-cta--end">
    <a class="sp-p__login" href="/login">시작하기</a>
  </div>
  <footer class="sp-p__landing-foot">스위피 · sweepea.co.kr</footer>
</Parent>
