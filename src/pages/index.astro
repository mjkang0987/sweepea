---
// 대표 첫 화면(디자인 Landing). 이미 들어온 기기면 앨범으로, 처음 온 사람(엄마아빠·검색)에겐 소개 한 장
import { SITE_ORIGIN } from 'astro:env/server';
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { currentPass, PARENT } from '../lib/pass';
import { isOpen } from '../lib/families';

// 홈 화면 아이콘(시작 주소 /)으로 연 부모는 부모 앨범으로
if (Astro.cookies.has(PARENT)) return Astro.redirect('/home');
// 출입증이 없으면 백엔드를 부르지 않는다(첫 방문·성능 검사에서 외부 호출 없음)
const pass = await currentPass(Astro.cookies);
if (pass) {
  const { families } = await getBackend().me(pass);
  if (families.some(isOpen)) return Astro.redirect('/album');
  if (families.length) return Astro.redirect('/wait');
}
const home = `${(SITE_ORIGIN || Astro.url.origin).replace(/\/$/, '')}/`;
// 한 장(92, 사용자 "한 장으로 설명되면 좋겠는데"): 제목에 검색어(아기 사진·할머니), 핵심 3줄, 시작하기, 가족 안내. 제품 사실만, 디자인 Landing
const points = ['할머니·할아버지는 앱 설치·가입 없이 링크로 바로 봐요', '외가·친가 따로, 처음 보는 이름은 엄마아빠가 확인해요', '하트와 한마디가 돌아오고, 사진은 사라지지 않아요'];
---

<Parent
  title="스위피 · 아기 사진을 카톡 링크로 조부모님과 함께 보는 가족 앨범"
  description="아기 사진을 올리고 카톡으로 링크만 보내면 할머니·할아버지는 앱 설치도 가입도 없이 바로 봐요. 외가·친가는 따로, 처음 보는 이름은 엄마아빠가 확인해요. 무료 5GB로 시작하세요."
  canonical={home}
>
  <section class="sp-p__brand" aria-labelledby="brand">
    <img class="sp-p__brand-kongi sp-p__brand-kongi--sm" src="/kongi.svg" width="88" height="88" alt="" />
    <p class="sp-p__landing-name">스위피</p>
    <h1 class="sp-p__landing-title" id="brand">아기 사진, 링크 하나면 <br />할머니도 바로 봐요</h1>
    <p class="sp-p__brand-text">사진을 올리고 카톡으로 링크만 보내세요</p>
    <ul class="sp-p__points">
      {
        points.map((pt) => (
          <li class="sp-p__point">
            <span class="sp-p__point-mark" aria-hidden="true">✓</span>
            {pt}
          </li>
        ))
      }
    </ul>
  </section>
  <div class="sp-p__bottom">
    <a class="sp-p__login" href="/login">무료로 시작하기</a>
    <p class="sp-p__fine sp-p__landing-fine">무료 5GB · 가족에게 링크를 받으셨다면 그 링크를 눌러 주세요</p>
  </div>
</Parent>
