---
// 접종·검진 일정(부모만): 다가오는 일정·지난 일정·완료. 체크하면 바로 완료한 날(오늘)이 기록된다(디자인, 스크립트 없으면 저장 버튼)
import Parent from '../../layouts/Parent.astro';
import AutoSave from '../../components/AutoSave.astro';
import Toast from '../../components/Toast.astro';
import { monthsOld } from '../../lib/age';
import { BackendError, getBackend } from '../../lib/backend';
import { monthDay } from '../../lib/kidHealth';
import { HEALTH_ITEMS, splitSchedule, type HealthState } from '../../lib/health';
import { loadParent, seoulToday } from '../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const kid = a.home.children?.find((k) => k.id === Astro.params.id);
if (!kid) return Astro.redirect('/home');
const b = getBackend();
const today = seoulToday();
// 들어온 곳(알림 탭 다가오는 일정·설정 › 아이)으로 돌아가기. 저장 뒤에도 이어지게 주소에 남긴다
const from = Astro.url.searchParams.get('from');
const here = `/health/${kid.id}${from === 'alerts' || from === 'settings' ? `?from=${from}&` : '?'}`;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const valid = new Set(HEALTH_ITEMS.map((i) => i.key));
  const shown = new Set(form.getAll('shown').map(String).filter((k) => valid.has(k)));
  const checked = new Set(form.getAll('done').map(String).filter((k) => shown.has(k)));
  // 화면을 그릴 때 체크돼 있던 것만 풀 수 있다(그 사이 다른 쪽에서 체크한 기록은 지우지 않게)
  const was = new Set(form.getAll('was').map(String).filter((k) => shown.has(k)));
  const before = new Set((await b.healthDone(a.pass, kid.id)).map((d) => d.item_key));
  // 바로 저장(스크립트)은 바꾼 칸 하나만 보낸다(toggle=키:on|off). 체크했다 바로 풀어도 마지막 선택대로, 다른 쪽 기록은 건드리지 않게
  const [tKey, tWant] = String(form.get('toggle') ?? '').split(':');
  const one = valid.has(tKey) && (tWant === 'on' || tWant === 'off');
  const add = one ? (tWant === 'on' && !before.has(tKey) ? [tKey] : []) : [...checked].filter((k) => !before.has(k));
  const remove = one ? (tWant === 'off' && before.has(tKey) ? [tKey] : []) : [...was].filter((k) => before.has(k) && !checked.has(k));
  try {
    await b.setHealthDone(a.pass, a.home.family_id!, kid.id, add, remove, today);
    return Astro.redirect(`${here}done=saved`, 303);
  } catch (e) {
    if (!(e instanceof BackendError)) throw e;
    return Astro.redirect(`${here}done=error`, 303);
  }
}
const doneRows = await b.healthDone(a.pass, kid.id);
const doneOn = new Map(doneRows.map((d) => [d.item_key, d.done_on]));
const { upcoming, past } = splitSchedule(kid.birth_date, today, doneOn);
const doneList = HEALTH_ITEMS.filter((i) => doneOn.has(i.key)).sort((x, y) => (doneOn.get(x.key)! < doneOn.get(y.key)! ? 1 : -1));
const stateText = (s: HealthState) => (s.kind === 'now' ? '지금 가능' : s.kind === 'late' ? '시기 지남' : `${monthDay(s.from)}부터`);
const KIND = { vaccine: '접종', checkup: '검진' };
const done = Astro.url.searchParams.get('done');
const back = from === 'alerts' ? { href: '/reactions', label: '알림', tab: 'alerts' as const } : from === 'settings' ? { href: '/settings/children', label: '아이', tab: 'settings' as const } : { href: '/home', label: '앨범', tab: 'home' as const };
---

<Parent title={`접종·검진 · ${kid.name}`} tab={back.tab} alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <div class="sp-p__nav">
    <a class="sp-p__back" href={back.href}>{back.label}</a>
    <h1 class="sp-p__nav-title">접종·검진</h1>
  </div>
  <h2 class="sp-p__title">{kid.name} · 생후 {monthsOld(kid.birth_date, today)}개월</h2>
  <p class="sp-p__lead">한 것을 체크하면 완료한 날이 기록돼요. 엄마아빠만 봐요.</p>
  {done === 'saved' && <Toast text="저장했어요." focus />}
  {done === 'error' && <Toast text="저장하지 못했어요. 다시 눌러 주세요." tone="error" focus />}
  <form class="sp-p__form" method="post" data-autosave id="health-form">
    <input type="hidden" name="toggle" value="" />
    <section class="sp-p__section" aria-labelledby="sec-next">
      <h2 class="sp-p__section-title" id="sec-next">다가오는 일정</h2>
      {upcoming.length === 0 && <p class="sp-p__hint sp-p__empty-note">6개월 안에는 없어요.</p>}
      <ul class="sp-p__list">
        {upcoming.map((x) => (
          <li>
            <label class="sp-p__health">
              <input type="hidden" name="shown" value={x.item.key} />
              <input class="sp-p__checkbox" type="checkbox" name="done" value={x.item.key} />
              <span class="sp-p__tag">{KIND[x.item.kind]}</span>
              <span class="sp-p__row-label sp-p__radio-text">
                <span class="sp-p__who-name">{x.item.name}</span>
                <span class="sp-p__hint">{x.item.age}</span>
              </span>
              <span class:list={['sp-p__health-when', x.state.kind === 'late' && 'sp-p__health-when--late']}>{stateText(x.state)}</span>
            </label>
          </li>
        ))}
      </ul>
    </section>
    {
      past.length > 0 && (
        <details class="sp-p__section sp-p__past" id="past">
          <summary class="sp-p__past-title"><h2 class="sp-p__section-title sp-p__past-h">지난 일정 {past.length}개 · 했으면 체크해 주세요</h2></summary>
          <ul class="sp-p__list">
            {past.map((x) => (
              <li>
                <label class="sp-p__health">
                  <input type="hidden" name="shown" value={x.item.key} />
                  <input class="sp-p__checkbox" type="checkbox" name="done" value={x.item.key} />
                  <span class="sp-p__tag">{KIND[x.item.kind]}</span>
                  <span class="sp-p__row-label sp-p__radio-text">
                    <span class="sp-p__who-name">{x.item.name}</span>
                    <span class="sp-p__hint">{x.item.age}</span>
                  </span>
                  <span class="sp-p__health-when sp-p__health-when--late">{x.state.kind === 'late' ? '시기 지남' : '권장 시기 지남'}</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      )
    }
    {
      doneList.length > 0 && (
        <section class="sp-p__section" aria-labelledby="sec-done">
          <h2 class="sp-p__section-title" id="sec-done">완료</h2>
          <ul class="sp-p__list">
            {doneList.map((i) => (
              <li>
                <label class="sp-p__health">
                  <input type="hidden" name="shown" value={i.key} />
                  <input type="hidden" name="was" value={i.key} />
                  <input class="sp-p__checkbox" type="checkbox" name="done" value={i.key} checked />
                  <span class="sp-p__tag">{KIND[i.kind]}</span>
                  <span class="sp-p__row-label sp-p__radio-text">
                    <span class="sp-p__who-name">{i.name}</span>
                    <span class="sp-p__hint">{i.age}</span>
                  </span>
                  <span class="sp-p__health-when">{monthDay(doneOn.get(i.key)!)}</span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <button class="sp-p__btn" type="submit" data-autosave-hide>저장</button>
  </form>
  <p class="sp-p__hint">국가 권장 시기 기준이에요. 실제 접종 기록은 질병관리청 예방접종도우미에서 확인하세요.</p>
  <AutoSave />
</Parent>

<script>
  // 바로 저장할 때 바꾼 칸을 알려 준다(AutoSave가 보내기 전에, 그래서 잡는 단계에서). 폼은 저장할 때마다 새것이라 문서에서 받는다
  document.addEventListener(
    'change',
    (e) => {
      const box = e.target as HTMLInputElement;
      if (box.name !== 'done' || box.form?.id !== 'health-form') return;
      const t = box.form.elements.namedItem('toggle') as HTMLInputElement | null;
      if (t) t.value = `${box.value}:${box.checked ? 'on' : 'off'}`;
    },
    true,
  );
</script>
