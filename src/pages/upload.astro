---
// 올리기 화면 자리(이슈 14). 지금은 안내만
import Parent from '../layouts/Parent.astro';
import { loadParent } from '../lib/parent';

const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
---

<Parent title="사진 올리기 · 스위피" tab="home">
  <h1 class="sp-p__title">사진 올리기</h1>
  <p class="sp-p__lead">올리기 화면은 곧 열려요.</p>
  <a class="sp-p__btn sp-p__btn--quiet" href="/home">앨범으로</a>
</Parent>
