---
// 올리기(부모): 고르기 → 기기에서 줄이기 → 아이·그룹 → 올리고 카톡으로 보내기. 부모 화면이라 JS를 쓴다
import Parent from '../layouts/Parent.astro';
import { getBackend } from '../lib/backend';
import { callName } from '../lib/ko';
import { loadParent } from '../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const { groups } = await getBackend().familyAdmin(a.pass);
const kids = a.home.children ?? [];
const kid = callName(kids[0]?.name ?? '아이');
---

<Parent title="사진 올리기 · 스위피" wide>
  <form class="sp-p__form" id="up-form" data-family={a.home.family_id} data-kid={kid} novalidate>
    <nav class="sp-p__bar sp-p__bar--title" aria-label="올리기">
      <a class="sp-p__back sp-p__back--cancel" href="/home">취소</a>
      <h1 class="sp-p__bar-title" id="up-title">사진 올리기</h1>
      <span class="sp-p__bar-space"></span>
    </nav>

    <noscript><p class="sp-p__error">올리기는 자바스크립트를 켜야 쓸 수 있어요.</p></noscript>

    <div class="sp-p__up-main">
    <label class="sp-p__pick" id="up-pick">
      <input class="sp-vh sp-p__pick-input" id="up-files" type="file" multiple accept="image/*,video/mp4,video/quicktime" />
      <span class="sp-p__pick-text">사진·영상 고르기</span>
    </label>
    <ul class="sp-p__upgrid" id="up-grid" aria-label="고른 사진" hidden></ul>
    <p class="sp-p__hint" id="up-cover-hint" hidden>테두리가 있는 사진이 카톡 카드 대표 사진(보낼 때 첫 장)이 돼요. 다른 사진을 눌러 바꿀 수 있어요.</p>
    </div>

    <div class="sp-p__up-side">

    <div class="sp-p__panel">
      {
        kids.length > 0 && (
          <fieldset class="sp-p__fieldset sp-p__panel-row">
            <legend class="sp-p__panel-label sp-p__panel-legend">아이</legend>
            <div class="sp-p__checks">
              {kids.map((c) => (
                <label class="sp-p__check">
                  <input class="sp-p__checkbox" type="checkbox" name="child" value={c.id} checked={kids.length === 1} />
                  {c.name}
                </label>
              ))}
            </div>
          </fieldset>
        )
      }
      <fieldset class="sp-p__fieldset sp-p__panel-row">
        <legend class="sp-p__panel-label sp-p__panel-legend">보여줄 그룹</legend>
        <div class="sp-p__checks">
          {
            groups.map((g) => (
              <label class="sp-p__check">
                <input class="sp-p__checkbox" type="checkbox" name="group" value={g.id} checked={g.include_by_default} />
                {g.name}
              </label>
            ))
          }
        </div>
      </fieldset>
      <p class="sp-p__panel-row sp-p__panel-line">
        <span class="sp-p__panel-label">크기</span>
        <span class="sp-p__row-value" id="up-size">고르면 보여요</span>
      </p>
    </div>
    <p class="sp-p__note sp-p__up-note">사진·영상은 앨범에서 보기 좋은 크기로 줄여서 올려요(영상은 1080p, 줄일 수 없으면 그대로). <strong class="sp-p__note-strong">스위피는 원본을 따로 보관하지 않으니 원본은 폰에서 지우지 마세요.</strong></p>

    <div class="sp-p__toast sp-p__toast--error sp-p__toast--live" id="up-alert" role="alert"></div>
    <p class="sp-p__toast sp-p__toast--live" id="up-status" role="status"></p>
    <div class="sp-p__up-progress" id="up-progress" hidden>
      <progress class="sp-p__progress" id="up-bar" max="100" value="0" aria-label="진행률"></progress>
      <p class="sp-p__hint" id="up-shrink-hint" hidden>영상을 보기 좋은 크기로 줄이고 있어요. 다 줄일 때까지 이 화면을 켜 두세요.</p>
    </div>

    <div class="sp-p__bottom" id="up-actions">
      <button class="sp-p__btn sp-p__btn--kakao" type="submit" value="share" disabled>올리고 카톡으로 보내기</button>
      <button class="sp-p__btn sp-p__btn--text" type="submit" value="only" disabled>보내지 않고 올리기만</button>
    </div>
    </div>
  </form>

  <section class="sp-p__card" id="up-done" aria-labelledby="up-done-title" hidden>
    <h2 class="sp-p__card-title" id="up-done-title" tabindex="-1">다 올렸어요</h2>
    <p class="sp-p__toast sp-p__toast--live" id="up-done-status" role="status"></p>
    <label class="sp-p__label" for="up-link">보낼 주소</label>
    <input class="sp-p__input" id="up-link" type="url" readonly />
    <button class="sp-p__btn sp-p__btn--kakao" type="button" id="up-share">카톡으로 보내기</button>
    <button class="sp-p__btn sp-p__btn--quiet" type="button" id="up-copy">주소 복사</button>
    <a class="sp-p__btn sp-p__btn--text" href="/home">앨범으로</a>
  </section>
  <section class="sp-p__card" id="up-noshare" aria-labelledby="up-noshare-title" hidden>
    <h2 class="sp-p__card-title" id="up-noshare-title" tabindex="-1">다 올렸는데 보낼 주소를 못 만들었어요</h2>
    <p class="sp-p__lead">사진은 앨범에 올라갔어요. 설정 > 가족에서 링크를 만들어 보내 주세요.</p>
    <a class="sp-p__btn" href="/home">앨범으로</a>
  </section>
</Parent>

<script>
  import { exifTakenAt, fitSize } from '../lib/exif';

  type Item = {
    kind: 'photo' | 'video';
    view: Blob;
    thumb: Blob;
    poster?: Blob;
    width: number;
    height: number;
    durationSec?: number;
    takenAt: string;
    takenAtSource: 'exif' | 'file';
    url: string;
    /** 올리기 중 만든 사진 행. 실패 뒤 다시 누르면 같은 행에 이어서 넣는다 */
    id?: string;
    done?: boolean;
    /** 칸 표시: 지금 올리는 중이거나 이번에 못 올림 */
    state?: 'sending' | 'fail';
  };
  const MB = 1024 * 1024;
  const MAX_ITEMS = 200;
  const VIDEO_TYPES = ['video/mp4', 'video/quicktime'];
  // 영상 원본은 이보다 크면 나눠 올린다(Worker 요청 한도 100MB), 한 편 최대 2GB(lib/media BIG_VIDEO)
  const SINGLE_MAX = 90 * MB;
  const VIDEO_MAX = 2048 * MB;
  // 영상은 폰에서 짧은 변 1080·5Mbps로 줄여 올린다(무료는 사본만, 원본은 폰에 남음)
  const SHRINK = { side: 1080, bitrate: 5e6 };
  // shortcut: 줄인 영상을 통째로 메모리에 두므로(아이폰은 탭이 꺼질 수 있음) 3분(약 110MB) 넘는 영상은 원본 그대로 나눠 올린다.
  // 긴 영상도 줄이려면 StreamTarget(fragmented)으로 만들면서 조각 올리기로 바로 흘려보낸다
  const SHRINK_MAX_SEC = 180;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('up-form');
  const input = $<HTMLInputElement>('up-files');
  const grid = $<HTMLUListElement>('up-grid');
  const status = $<HTMLParagraphElement>('up-status');
  const buttons = [...form.querySelectorAll<HTMLButtonElement>('#up-actions .sp-p__btn')];
  let items: Item[] = [];
  let cover = 0;
  let busy = false;
  let shrinking = false;
  // 줄이기가 마지막으로 진행된 때(멈춤 감시)
  let beat = 0;
  let lastMode = 'share';
  // 한 번 올리기 시작하면 아이·그룹을 고정(이어 올릴 때 묶음 안에서 공개 범위가 섞이지 않게)
  let locked: { groupIds: string[]; childIds: string[] } | null = null;
  const choices = [...form.querySelectorAll<HTMLInputElement>('.sp-p__checkbox')];
  const NO_GROUP = '보여줄 그룹을 하나 이상 골라 주세요.';

  // 상태 칸은 늘 있고(화면 읽기가 바로 읽게) 비었을 때만 CSS로 숨긴다
  const say = (text: string) => (status.textContent = text);
  // 못 올린 안내는 진행 글과 따로 빨간 칸에(role=alert). 고를 때 뺀 파일은 이름·이유 목록
  const alertBox = $('up-alert');
  const warn = (head = '', rows: string[] = []) => {
    if (!head) return alertBox.replaceChildren();
    const p = document.createElement('p');
    p.className = 'sp-p__up-alert-head';
    p.textContent = head;
    const ul = document.createElement('ul');
    ul.className = 'sp-p__up-alert-list';
    // 화면 읽기가 끝없이 읽지 않고 버튼이 밀려나지 않게 10줄까지
    for (const r of rows.length > 10 ? [...rows.slice(0, 9), `외 ${rows.length - 9}개`] : rows) {
      const li = document.createElement('li');
      li.className = 'sp-p__up-alert-item';
      li.textContent = r;
      ul.appendChild(li);
    }
    alertBox.replaceChildren(p, ...(rows.length ? [ul] : []));
  };
  const TAG = { done: '올림', sending: '올리는 중', fail: '못 올림' } as const;
  // 그룹을 고르면 '그룹을 골라 주세요'만 지운다(고를 때 뺀 파일 목록 같은 다른 안내는 둔다)
  for (const c of choices) if (c.name === 'group') c.addEventListener('change', () => alertBox.textContent === NO_GROUP && warn());
  // 줄이기·올리기 진행: 막대는 묶음 전체 기준. 퍼센트 글은 영상 하나의 진행(줄이기·나눠 올리기)일 때만
  // (사진은 '3 / 12'와 같은 말이라 빼 달라고 함)
  const bar = $<HTMLProgressElement>('up-bar');
  const prog = $('up-progress');
  // 화면 읽기가 계속 읽지 않게 글은 10% 단위·단계가 바뀔 때만, 막대는 늘
  const pct = (f: number) => Math.max(0, Math.min(100, Math.floor(f * 100)));
  const step = (text: string, frac: number, video?: number, tag = '') => {
    prog.hidden = false;
    bar.value = pct(frac);
    const v = video === undefined ? -1 : pct(video);
    const t = v < 0 ? text : `${text} · ${tag}${v === 100 ? 100 : Math.floor(v / 10) * 10}%`;
    if (status.textContent !== t) say(t);
  };

  // 캔버스 하나를 돌려쓴다(아이폰은 캔버스 메모리가 금방 찬다)
  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d')!;
  ctx.imageSmoothingQuality = 'high';
  async function draw(src: CanvasImageSource, w: number, h: number, max: number, q: number) {
    const s = fitSize(w, h, max);
    canvas.width = s.width;
    canvas.height = s.height;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(src, 0, 0, s.width, s.height);
    const blob = await new Promise<Blob>((ok, no) => canvas.toBlob((b) => (b ? ok(b) : no(new Error('encode'))), 'image/jpeg', q));
    return { blob, ...s };
  }
  /** 보기용을 그린 뒤 그 결과로 썸네일(원본을 두 번 그리지 않게) */
  async function viewAndThumb(src: CanvasImageSource, w: number, h: number, viewMax: number) {
    let small: ImageBitmap | undefined;
    try {
      const view = await draw(src, w, h, viewMax, 0.85);
      small = await createImageBitmap(view.blob);
      const thumb = await draw(small, small.width, small.height, 480, 0.8);
      return { view, thumb };
    } finally {
      small?.close();
      canvas.width = canvas.height = 0;
    }
  }

  async function photo(file: File): Promise<Item> {
    // 끌어다 놓기는 아무 파일이나 올 수 있다(종류를 모르는 파일은 열어 보고 판단)
    if (file.type && !file.type.startsWith('image/')) throw new Error('type');
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
    const { view, thumb } = await viewAndThumb(bmp, bmp.width, bmp.height, 2048);
    bmp.close();
    let exif: string | null = null;
    try {
      if (file.type === 'image/jpeg') exif = exifTakenAt(await file.slice(0, 128 * 1024).arrayBuffer());
    } catch {
      exif = null;
    }
    return {
      kind: 'photo', view: view.blob, thumb: thumb.blob, width: view.width, height: view.height,
      takenAt: exif ?? new Date(file.lastModified).toISOString(), takenAtSource: exif ? 'exif' : 'file',
      url: URL.createObjectURL(thumb.blob),
    };
  }

  /** 이벤트를 기다리되 오래 걸리면 포기(아이폰은 화면 밖 영상 이벤트가 안 올 때가 있다) */
  const wait = (el: HTMLVideoElement, ev: string, ms = 8000) =>
    new Promise<void>((ok, no) => {
      const done = () => (clearTimeout(timer), el.removeEventListener(ev, onOk), el.removeEventListener('error', onErr));
      const onOk = () => (done(), ok());
      const onErr = () => (done(), no(new Error('media')));
      const timer = setTimeout(() => (done(), no(new Error('timeout'))), ms);
      el.addEventListener(ev, onOk);
      el.addEventListener('error', onErr);
    });

  /** 영상을 줄인 mp4. 못 줄이거나(브라우저가 못 함·실패·소리나 화면이 빠짐) 줄일 필요가 없으면 null → 원본 그대로 */
  async function shrink(file: File, sec: number, progress: (p: number) => void) {
    if (typeof VideoEncoder !== 'function' || typeof VideoDecoder !== 'function' || !(sec > 0) || sec > SHRINK_MAX_SEC) return null;
    let input: import('mediabunny').Input | undefined;
    try {
      const mb = await import('mediabunny');
      input = new mb.Input({ source: new mb.BlobSource(file), formats: mb.ALL_FORMATS });
      const [video, audio] = await Promise.all([input.getPrimaryVideoTrack(), input.getPrimaryAudioTrack()]);
      if (!video) return null;
      const [w, h] = await Promise.all([video.getDisplayWidth(), video.getDisplayHeight()]);
      // 이미 작은 영상은 그대로(다시 줄이면 화질만 나빠진다)
      if (Math.min(w, h) <= SHRINK.side && (file.size * 8) / sec <= SHRINK.bitrate * 1.2) return null;
      const scale = Math.min(1, SHRINK.side / Math.min(w, h));
      const width = Math.round((w * scale) / 2) * 2, height = Math.round((h * scale) / 2) * 2;
      const output = new mb.Output({ format: new mb.Mp4OutputFormat({ fastStart: 'in-memory' }), target: new mb.BufferTarget() });
      const conv = await mb.Conversion.init({
        input, output, tracks: 'primary',
        // 가로·세로를 둘 다 정해 서버에 적는 크기와 실제 영상 크기를 맞춘다
        video: { width, height, fit: 'fill', codec: 'avc', bitrate: SHRINK.bitrate },
        audio: { codec: 'aac' },
      });
      if (!conv.isValid || conv.discardedTracks.some((d) => d.track === video || d.track === audio)) return null;
      beat = Date.now();
      conv.onProgress = (p) => ((beat = Date.now()), progress(p));
      // 인코더가 응답 없이 멈추면 그만두고 원본으로. 소리가 먼저 끝난 영상은 남은 화면을 만드는 동안 진행이 안 오르므로
      // 넉넉히(영상 길이의 3배, 최소 1분) 기다린다. 다른 앱에 다녀오면 다시 센다(visibilitychange)
      const limit = Math.max(60_000, sec * 3000);
      const dog = setInterval(() => Date.now() - beat > limit && void conv.cancel(), 5000);
      try {
        await conv.execute();
      } finally {
        clearInterval(dog);
      }
      const buf = output.target.buffer;
      if (!buf || buf.byteLength >= file.size) return null;
      return { blob: new Blob([buf], { type: 'video/mp4' }), width, height };
    } catch {
      return null;
    } finally {
      input?.dispose();
    }
  }

  async function video(file: File, progress: (p: number) => void): Promise<Item> {
    if (!VIDEO_TYPES.includes(file.type)) throw new Error('type');
    if (file.size > VIDEO_MAX) throw new Error('too_large');
    const v = document.createElement('video');
    v.muted = true;
    v.playsInline = true;
    // 첫 장면이 실제로 디코딩돼야 그릴 수 있다(아이폰은 metadata만으론 검은 화면)
    v.preload = 'auto';
    const src = URL.createObjectURL(file);
    try {
      v.src = src;
      await wait(v, 'loadeddata');
      v.currentTime = Math.min(0.1, v.duration / 2 || 0);
      await wait(v, 'seeked');
      const { view: poster, thumb } = await viewAndThumb(v, v.videoWidth, v.videoHeight, 1280);
      const { duration, videoWidth, videoHeight } = v;
      // 줄이는 동안 영상 칸이 같은 영상을 따로 풀고 있지 않게 비운다(아이폰 메모리)
      v.removeAttribute('src');
      v.load();
      const small = await shrink(file, duration, progress);
      return {
        kind: 'video', view: small?.blob ?? file, poster: poster.blob, thumb: thumb.blob,
        width: small?.width ?? videoWidth, height: small?.height ?? videoHeight,
        durationSec: Math.round(duration * 100) / 100,
        // shortcut: 영상은 파일 시각(아이폰은 내보낸 시각일 수 있음). 정확히 하려면 MP4 mvhd 생성 시각을 읽는다
        takenAt: new Date(file.lastModified).toISOString(), takenAtSource: 'file',
        url: URL.createObjectURL(thumb.blob),
      };
    } finally {
      URL.revokeObjectURL(src);
    }
  }

  /** 칸 상태(표시·버튼 이름)만 바꾼다. 올리는 동안은 칸을 새로 그리지 않고 이것만(아이폰에서 썸네일이 깜빡이지 않게) */
  function paint(i: number) {
    const li = grid.children[i];
    const b = li?.querySelector('.sp-p__upbtn');
    if (!li || !b) return;
    const it = items[i];
    const tag = it.done ? 'done' : it.state;
    b.setAttribute('aria-label', `${i + 1}번째 ${it.kind === 'video' ? '영상' : '사진'} 대표${tag ? `, ${TAG[tag]}` : ''}`);
    li.querySelector('.sp-p__uptag')?.remove();
    if (!tag) return;
    const t = document.createElement('span');
    t.className = `sp-p__uptag sp-p__uptag--${tag}`;
    t.setAttribute('aria-hidden', 'true');
    t.textContent = TAG[tag];
    li.appendChild(t);
  }

  function render(focus?: number) {
    grid.hidden = items.length === 0;
    $('up-cover-hint').hidden = items.length < 2;
    $('up-title').textContent = items.length ? `${items.some((i) => i.kind === 'video') ? '사진·영상' : '사진'} ${items.length}장` : '사진 올리기';
    grid.replaceChildren(
      ...items.map((it, i) => {
        const li = document.createElement('li');
        li.className = 'sp-p__upcell';
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'sp-p__upbtn';
        b.disabled = busy;
        // 눌림 상태는 aria-pressed가 말해 주므로 이름엔 대표 여부를 넣지 않는다
        b.setAttribute('aria-pressed', String(i === cover));
        b.addEventListener('click', () => {
          cover = i;
          render(i);
        });
        const img = document.createElement('img');
        img.className = 'sp-p__upimg';
        img.src = it.url;
        img.alt = '';
        b.appendChild(img);
        li.appendChild(b);
        return li;
      }),
    );
    items.forEach((_, i) => paint(i));
    if (focus !== undefined) grid.querySelectorAll<HTMLButtonElement>('.sp-p__upbtn')[focus]?.focus();
    const bytes = items.reduce((n, it) => n + it.view.size + it.thumb.size + (it.poster?.size ?? 0), 0);
    $('up-size').textContent = shrinking ? '줄이는 중' : items.length ? `보기 좋은 크기 · ${(bytes / MB).toFixed(1)}MB` : '고르면 보여요';
    buttons.forEach((b) => (b.disabled = busy || items.length === 0));
    input.disabled = busy || !!locked;
    choices.forEach((c) => (c.disabled = busy || !!locked));
  }

  // PC: 사진을 고르기 칸에 끌어다 놓아도 고른 것과 같게
  const pick = $<HTMLLabelElement>('up-pick');
  // 고르기 칸 밖에 떨어뜨려도 브라우저가 파일을 열고 이 화면을 떠나지 않게
  for (const t of ['dragover', 'drop']) window.addEventListener(t, (e) => e.preventDefault());
  const canDrop = () => !busy && !input.disabled;
  pick.addEventListener('dragover', (e) => {
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = canDrop() ? 'copy' : 'none';
    pick.classList.toggle('sp-p__pick--over', canDrop());
  });
  pick.addEventListener('dragleave', () => pick.classList.remove('sp-p__pick--over'));
  pick.addEventListener('drop', (e) => {
    e.preventDefault();
    pick.classList.remove('sp-p__pick--over');
    if (!e.dataTransfer?.files.length || !canDrop()) return;
    input.files = e.dataTransfer.files;
    input.dispatchEvent(new Event('change'));
  });
  // 줄이거나 올리는 동안 화면이 꺼지면 멈출 수 있어 켜 둔다(안 되는 브라우저는 그냥 둔다). 응답을 기다리지 않는다(헤드리스 등에서 끝나지 않을 수 있음)
  let awake: Promise<WakeLockSentinel | undefined> | undefined;
  const keepAwake = () => (awake = navigator.wakeLock?.request('screen').catch(() => undefined));
  const letSleep = () => {
    awake?.then((l) => l?.release()).catch(() => undefined);
    awake = undefined;
  };
  // 다른 앱에 다녀오면 브라우저가 풀어 버리므로 다시 건다
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') return;
    beat = Date.now();
    if (awake) keepAwake();
  });
  input.addEventListener('change', async () => {
    if (busy) return;
    const all = [...(input.files ?? [])];
    const files = all.slice(0, Math.max(0, MAX_ITEMS - items.length));
    const over = all.length - files.length;
    warn();
    if (!files.length) {
      input.value = '';
      warn(`한 묶음에 ${MAX_ITEMS}장까지라 고른 ${over}개를 뺐어요.`);
      return;
    }
    busy = true;
    shrinking = typeof VideoEncoder === 'function' && files.some((f) => f.type.startsWith('video/'));
    $('up-shrink-hint').hidden = !shrinking;
    render();
    if (shrinking) keepAwake();
    const skipped: string[] = [];
    for (const [i, f] of files.entries()) {
      const label = `${shrinking && f.type.startsWith('video/') ? '영상 ' : ''}줄이는 중… ${i + 1} / ${files.length}`;
      step(label, i / files.length);
      try {
        items.push(await (f.type.startsWith('video/') ? video(f, (p) => step(label, (i + p) / files.length, p)) : photo(f)));
        // 다 줄인 것부터 바로 보이게
        render();
      } catch (err) {
        const why = err instanceof Error && err.message === 'type' ? '지원하지 않는 형식' : err instanceof Error && err.message === 'too_large' ? '2GB 넘는 영상' : '열 수 없는 파일';
        skipped.push(`${f.name} · ${why}`);
      }
    }
    letSleep();
    prog.hidden = true;
    busy = false;
    shrinking = false;
    $('up-shrink-hint').hidden = true;
    say('');
    const count = skipped.length + over;
    if (over) skipped.push(`뒤의 ${over}개 · 한 묶음에 ${MAX_ITEMS}장까지`);
    if (count) warn(`${count}개는 올릴 수 없어서 뺐어요.`, skipped);
    input.value = '';
    render();
  });

  class HttpError extends Error {
    constructor(readonly status: number) {
      super(String(status));
    }
  }
  async function api<T>(url: string, init: RequestInit): Promise<T> {
    const r = await fetch(url, init);
    if (!r.ok) throw new HttpError(r.status);
    return r.json() as Promise<T>;
  }
  const put = async (id: string, part: string, blob: Blob, progress?: (done: number) => void) =>
    part === 'view' && blob.size > SINGLE_MAX
      ? putBig(id, blob, progress)
      : (await api<{ key: string }>(`/api/media/${id}/${part}`, { method: 'PUT', body: blob, headers: { 'content-type': blob.type || 'application/octet-stream' } })).key;

  // 큰 영상: 조각마다 보내고(실패한 조각은 두 번까지 다시) 끝에 합친다. 그만두면 올리던 조각은 버린다
  async function putBig(id: string, blob: Blob, progress?: (done: number) => void): Promise<string> {
    const url = `/api/media/${id}/multipart`;
    const json = { 'content-type': 'application/json' };
    const { key, uploadId, partSize } = await api<{ key: string; uploadId: string; partSize: number }>(url, {
      method: 'POST', headers: json, body: JSON.stringify({ action: 'create', type: blob.type, size: blob.size }),
    });
    try {
      const parts: { partNumber: number; etag: string }[] = [];
      for (let n = 1, at = 0; at < blob.size; n++, at += partSize) {
        const q = new URLSearchParams({ key, upload: uploadId, n: String(n) });
        for (let tries = 0; ; tries++) {
          try {
            const { etag } = await api<{ etag: string }>(`${url}?${q}`, { method: 'PUT', body: blob.slice(at, at + partSize), headers: { 'content-type': 'application/octet-stream' } });
            parts.push({ partNumber: n, etag });
            break;
          } catch (err) {
            if (tries >= 2 || (err instanceof HttpError && err.status !== 400 && err.status < 500)) throw err;
          }
        }
        progress?.(Math.min(1, (at + partSize) / blob.size));
      }
      return (await api<{ key: string }>(url, { method: 'POST', headers: json, body: JSON.stringify({ action: 'complete', key, uploadId, parts }) })).key;
    } catch (err) {
      fetch(url, { method: 'POST', headers: json, body: JSON.stringify({ action: 'abort', key, uploadId }) }).catch(() => {});
      throw err;
    }
  }

  // 오래된 사파리는 e.submitter가 없어 누른 버튼을 따로 기억한다
  buttons.forEach((b) => b.addEventListener('click', () => (lastMode = b.value)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy) return;
    const mode = (e.submitter as HTMLButtonElement | null)?.value ?? lastMode;
    const { groupIds, childIds } = locked ?? {
      groupIds: choices.filter((x) => x.name === 'group' && x.checked).map((x) => x.value),
      childIds: choices.filter((x) => x.name === 'child' && x.checked).map((x) => x.value),
    };
    if (!groupIds.length) return warn(NO_GROUP);
    warn();
    // 지난번 못 올림 표시는 지우고 다시(이어 올리는 동안 남은 칸이 실패로 보이지 않게)
    for (const it of items) if (it.state === 'fail') it.state = undefined;
    locked = { groupIds, childIds };
    busy = true;
    keepAwake();
    render();
    // 대표 사진을 맨 앞에(공유 묶음 첫 장 = 카톡 카드 대표)
    const order = [cover, ...items.keys()].filter((v, i, arr) => arr.indexOf(v) === i);
    // 남은 것의 크기로 퍼센트를 센다(다시 누르면 남은 것 기준으로 0%부터)
    const sizeOf = (it: Item) => it.view.size + it.thumb.size + (it.poster?.size ?? 0);
    const total = order.reduce((t, i) => t + (items[i].done ? 0 : sizeOf(items[i])), 0) || 1;
    let sent = 0;
    try {
      for (const [n, i] of order.entries()) {
        const it = items[i];
        if (it.done) continue;
        const label = `올리는 중… ${n + 1} / ${order.length}`;
        it.state = 'sending';
        paint(i);
        step(label, sent / total);
        it.id ??= (
          await api<{ id: string }>('/api/media', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              familyId: form.dataset.family, kind: it.kind, takenAt: it.takenAt, takenAtSource: it.takenAtSource,
              width: it.width, height: it.height, durationSec: it.durationSec, groupIds, childIds,
            }),
          })
        ).id;
        try {
          const keys: Record<string, string> = { view: await put(it.id, 'view', it.view, (p) => step(label, (sent + p * it.view.size) / total, p, '영상 ')) };
          step(label, (sent + it.view.size) / total);
          keys.thumb = await put(it.id, 'thumb', it.thumb);
          if (it.poster) keys.poster = await put(it.id, 'poster', it.poster);
          await api(`/api/media/${it.id}/done`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(keys) });
        } catch (err) {
          // 지난번에 완료까지 됐는데 응답만 못 받았으면: 이제 '올리는 중'이 아니라 404·409. 끝난 것으로 본다
          if (!(err instanceof HttpError && (err.status === 404 || err.status === 409))) throw err;
        }
        it.done = true;
        it.state = undefined;
        paint(i);
        sent += sizeOf(it);
        step(label, sent / total);
      }
    } catch (err) {
      letSleep();
      prog.hidden = true;
      busy = false;
      // 용량이 다 차면 남은 것도 못 올라가므로 모두 못 올림
      const full = err instanceof HttpError && err.status === 507;
      for (const it of items) if (it.state === 'sending' || (full && !it.done)) it.state = 'fail';
      render();
      say('');
      const n = items.filter((x) => x.done).length;
      return warn(
        err instanceof HttpError && err.status === 401
          ? '로그인이 끝났어요. 다시 로그인한 뒤 올려 주세요.'
          : err instanceof HttpError && err.status === 507
          ? `저장 용량 5GB가 다 찼어요. ${n}장까지 올렸어요. 가족은 지금까지 올린 사진을 계속 볼 수 있어요.`
          : `${err instanceof TypeError ? '인터넷 연결이 끊겼어요. ' : ''}${n}장까지 올렸어요. 다시 누르면 나머지를 이어서 올려요.`,
      );
    }
    letSleep();
    prog.hidden = true;
    if (mode !== 'share') return location.assign('/home');
    const ids = order.map((i) => items[i].id!);
    say('보낼 주소를 만드는 중…');
    try {
      const { url } = await api<{ url: string }>('/api/shares', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ groupIds, mediaIds: ids }),
      });
      form.hidden = true;
      const done = $('up-done');
      done.hidden = false;
      $<HTMLInputElement>('up-link').value = url;
      $('up-done-title').focus();
      const text = `${form.dataset.kid} 새 사진 ${ids.length}장이에요. 누르면 바로 볼 수 있어요.`;
      const tell = (t: string) => ($('up-done-status').textContent = t);
      const copy = (what: string, ok: string) =>
        navigator.clipboard
          ? navigator.clipboard.writeText(what).then(() => tell(ok), () => tell('복사하지 못했어요. 주소 칸을 길게 눌러 복사해 주세요.'))
          : tell('주소 칸을 길게 눌러 복사해 주세요.');
      $('up-share').addEventListener('click', () => {
        // 휴대폰 공유 창(카톡 포함). 카카오 카드 공유는 앱 키를 받은 뒤
        if (navigator.share) navigator.share({ text, url }).catch(() => undefined);
        else copy(`${text}\n${url}`, '주소를 복사했어요. 카톡에 붙여 넣어 주세요.');
      });
      $('up-copy').addEventListener('click', () => copy(url, '주소를 복사했어요.'));
    } catch {
      form.hidden = true;
      $('up-noshare').hidden = false;
      $('up-noshare-title').focus();
    }
  });
</script>
