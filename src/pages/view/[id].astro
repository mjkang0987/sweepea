---
// 엄빠 크게 보기: 조부모와 같은 화면(반응·한마디 남기기·저장) + 사진 정보 수정 버튼. 순서는 앨범과 같음(아이를 골랐으면 ?k=)
import Family from '../../layouts/Family.astro';
import Viewer from '../../components/Viewer.astro';
import { EMOJI_SPRITE } from '../../lib/emoji';
import { applyReactPost, dayLabel, loadReacts } from '../../lib/album';
import { getBackend } from '../../lib/backend';
import { UUID } from '../../lib/media';
import { callName } from '../../lib/ko';
import { loadParent } from '../../lib/parent';
import { signedMediaUrl } from '../../lib/signed';

Astro.response.headers.set('cache-control', 'private, no-store');
const id = Astro.params.id ?? '';
if (!UUID.test(id)) return Astro.redirect('/home');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const b = getBackend();
const kids = a.home.children ?? [];
const picked = kids.length > 1 ? kids.find((x) => x.id === Astro.url.searchParams.get('k')) : undefined;
const kq = picked ? `?k=${encodeURIComponent(picked.id)}` : '';
// 반응·한마디: 부모 계정으로. 돌아갈 곳은 이 화면 주소만
if (Astro.request.method === 'POST') {
  const pass = a.pass;
  const back = /^\/view\/[0-9a-f-]{36}(\?[A-Za-z0-9=&%._-]*)?(#[A-Za-z0-9_-]+)?$/;
  const ops = { react: (m: string, k: Parameters<typeof b.parentReact>[2], on: boolean) => b.parentReact(pass, m, k, on), comment: (m: string, t: string) => b.parentComment(pass, m, t) };
  return Astro.redirect(await applyReactPost(Astro.request, id, ops, back, `/view/${id}${kq}`), 303);
}
// shortcut: 앨범과 같이 최근 200장 안에서만 넘김
const items = await b.listMedia(a.pass, { limit: 200, childId: picked?.id });
const i = items.findIndex((m) => m.id === id);
if (i < 0) return Astro.redirect(`/home${kq}`);
const m = items[i];
const prev = items[i - 1];
const next = items[i + 1];
const what = m.kind === 'video' ? '영상' : '사진';
const label = `${dayLabel(m.taken_at)} ${what}`;
const src = await signedMediaUrl(m.view_key);
const poster = m.poster_key ? await signedMediaUrl(m.poster_key) : undefined;
const reacts = await loadReacts(a.pass, [m.id]);
const here = `/view/${m.id}${kq}`;
const say = Astro.url.searchParams.get('say');
const sayHere = Astro.url.searchParams.get('sm') === m.id || !Astro.url.searchParams.get('sm') ? say : null;
// 아이를 안 골랐고 여럿이면 사진의 아이를 모르니 '아이'로
const child = picked ? callName(picked.name) : kids.length === 1 ? callName(kids[0].name) : '아이';
const saveName = `sweepea-${m.taken_at.slice(0, 10)}.${m.kind === 'video' ? 'mp4' : 'jpg'}`;
const view = (x: { id: string }) => `/view/${x.id}${kq}`;
---

<Family title={`${label} · ${i + 1} / ${items.length}`} wide>
  <Fragment set:html={EMOJI_SPRITE} />
  <Viewer
    m={m}
    label={label}
    src={src}
    poster={poster}
    pos={i + 1}
    total={items.length}
    closeHref={`/home${kq}`}
    save={{ href: src, name: saveName, label }}
    prev={prev && { href: view(prev), video: prev.kind === 'video' }}
    next={next && { href: view(next), video: next.kind === 'video' }}
    reacts={reacts}
    action={`/view/${m.id}`}
    here={here}
    child={child}
    say={sayHere}
    sentText="보냈어요. 가족도 볼 수 있어요."
  >
    <a class="sp-v__edit sp-v__hide" href={`/photo/${m.id}${kq}`}>
      <svg class="sp-v__edit-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg>
      사진 정보 수정
    </a>
  </Viewer>
</Family>
