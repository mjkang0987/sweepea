---
// 아이 목록: 이름·생일·생후 개월, 고치기, 아이 추가
import Parent from '../../../layouts/Parent.astro';
import AutoSave from '../../../components/AutoSave.astro';
import Toast from '../../../components/Toast.astro';
import { birthLabel, monthsOld } from '../../../lib/age';
import { BackendError, getBackend } from '../../../lib/backend';
import { loadParent, seoulToday } from '../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const kids = a.home.children ?? [];
if (Astro.request.method === 'POST') {
  const on = (await Astro.request.formData()).get('health') === '1';
  try {
    await getBackend().setShowHealth(a.pass, kids.map((k) => k.id), on);
    return Astro.redirect('/settings/children?done=health', 303);
  } catch (e) {
    if (!(e instanceof BackendError)) throw e;
    return Astro.redirect('/settings/children?done=error', 303);
  }
}
const showHealth = kids.some((k) => k.show_health);
const today = seoulToday();
const done = Astro.url.searchParams.get('done');
const doneText: Record<string, string> = { added: '아이를 추가했어요.', saved: '고쳤어요.', health: '저장했어요.', error: '저장하지 못했어요. 다시 눌러 주세요.' };
---

<Parent title="아이 · 설정" tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <div class="sp-p__nav">
    <a class="sp-p__back" href="/settings">설정</a>
    <h1 class="sp-p__nav-title">아이</h1>
  </div>
  {done && doneText[done] && <Toast text={doneText[done]} tone={done === 'error' ? 'error' : 'ok'} focus />}
  <ul class="sp-p__list">
    {
      kids.map((k) => (
        <li>
          <a class="sp-p__row sp-p__row--tall" href={`/settings/children/${k.id}`}>
            <span class="sp-p__kid-box" aria-hidden="true"><img class="sp-p__kid-box-img" src="/kongi.svg" width="32" height="32" alt="" /></span>
            <span class="sp-p__row-label sp-p__radio-text">
              <span class="sp-p__who-name">{k.name}</span>
              <span class="sp-p__hint">{birthLabel(k.birth_date)} · 생후 {monthsOld(k.birth_date, today)}개월</span>
            </span>
            <span class="sp-p__row-action">고치기<span class="sp-vh"> ({k.name})</span></span>
          </a>
        </li>
      ))
    }
  </ul>
  <a class="sp-p__btn sp-p__btn--quiet sp-p__btn--add sp-p__add" href="/settings/children/new"><span aria-hidden="true">+</span>아이 추가</a>
  <section class="sp-p__section" aria-labelledby="sec-health">
    <h2 class="sp-p__section-title" id="sec-health">접종·검진</h2>
    <form class="sp-p__form sp-p__form--fit" method="post" data-autosave>
      <ul class="sp-p__rows" role="list">
        <li>
          <label class="sp-p__rows-item sp-p__rows-item--check">
            <span class="sp-p__radio-text">
              <span class="sp-p__who-name">앨범에 접종·검진 일정 보기</span>
              <span class="sp-p__hint" id="health-note">부모 앨범 위 아이 카드에 다음 일정이 보여요. 가족 화면에는 보이지 않아요</span>
            </span>
            <input class="sp-p__checkbox" type="checkbox" name="health" value="1" checked={showHealth} aria-describedby="health-note" />
          </label>
        </li>
      </ul>
      <button class="sp-p__btn sp-p__btn--quiet" type="submit" data-autosave-hide>저장</button>
    </form>
  </section>
  <AutoSave />
</Parent>
