---
// 계정: 로그인 제공자·부모 호칭, 로그아웃, 탈퇴하기(한 번 더 확인 + 확인 체크)
import Parent from '../../layouts/Parent.astro';
import { BackendError, getBackend } from '../../lib/backend';
import { goodbyeHref, loadParent, logoutParent, PROVIDER_NAMES } from '../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('agree') !== '1') return Astro.redirect('/settings/account?confirm=delete&e=agree#confirm', 303);
  try {
    const at = await getBackend().requestDelete(a.pass);
    await logoutParent(Astro.cookies);
    return Astro.redirect(goodbyeHref(at), 303);
  } catch (err) {
    if (!(err instanceof BackendError)) throw err;
    return Astro.redirect(`/settings/account?confirm=${err.status === 402 ? 'subscribed' : 'error'}#confirm`, 303);
  }
}
const provider = PROVIDER_NAMES[a.home.provider ?? ''];
const who = `${a.home.children?.[0]?.name ?? ''} ${a.home.role === 'dad' ? '아빠' : '엄마'}`.trim();
const confirm = Astro.url.searchParams.get('confirm');
const photos = a.home.photo_count ?? 0;
const videos = a.home.video_count ?? 0;
const what = videos ? `사진 ${photos.toLocaleString('ko-KR')}장·영상 ${videos.toLocaleString('ko-KR')}개와` : `사진 ${photos.toLocaleString('ko-KR')}장과`;
const agreeError = Astro.url.searchParams.get('e') === 'agree';
const day = (iso: string) => new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' }).format(new Date(iso));
const planUntil = a.home.plan_until ? day(a.home.plan_until) : null;
---

<Parent title={confirm === 'delete' ? '정말 탈퇴할까요? · 계정' : '계정 · 설정'} tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <nav class="sp-p__bar" aria-label="뒤로">
    <a class="sp-p__back" href="/settings">설정</a>
  </nav>
  <h1 class="sp-p__title">계정</h1>
  <div class="sp-p__card">
    <p class="sp-p__who-name">{who}</p>
    <p class="sp-p__hint">{provider ? `${provider}로 로그인` : '로그인됨'}</p>
  </div>
  {
    confirm === 'delete' && !planUntil ? (
      <section class="sp-p__card sp-p__card--warn" id="confirm" aria-labelledby="confirm-title">
        <h2 class="sp-p__card-title" id="confirm-title" tabindex="-1" autofocus>정말 탈퇴할까요?</h2>
        <p class="sp-p__lead">가족 화면은 바로 닫히고, <strong>3일 뒤</strong> {what} 가족·아이 정보가 모두 지워져요. 3일 안에 다시 로그인하면 되살릴 수 있어요.</p>
        <form class="sp-p__form" method="post">
          {agreeError && <p class="sp-p__error" role="alert" id="agree-err">'모두 지워지는 것을 확인했어요'를 체크해야 탈퇴할 수 있어요.</p>}
          <label class="sp-p__check sp-p__check--plain">
            <input class="sp-p__checkbox" type="checkbox" name="agree" value="1" required aria-invalid={agreeError ? 'true' : undefined} aria-describedby={agreeError ? 'agree-err' : undefined} />
            모두 지워지는 것을 확인했어요
          </label>
          <div class="sp-p__pair">
            <a class="sp-p__btn sp-p__btn--quiet" href="/settings/account">취소</a>
            <button class="sp-p__btn sp-p__btn--danger-strong" type="submit">탈퇴하기</button>
          </div>
        </form>
      </section>
    ) : confirm === 'subscribed' || confirm === 'delete' ? (
      <section class="sp-p__card sp-p__card--warn" id="confirm" aria-labelledby="confirm-title">
        <h2 class="sp-p__card-title" id="confirm-title" tabindex="-1" autofocus>구독 중이에요</h2>
        <p class="sp-p__lead">탈퇴해도 결제는 자동으로 멈추지 않아요. 아직 해지하지 않았다면 App Store나 Google Play에서 가족 플랜 구독을 먼저 해지해 주세요. {planUntil ? `구독 기간이 끝나는 ${planUntil} 뒤에 탈퇴할 수 있어요.` : '구독 기간이 끝난 뒤에 탈퇴할 수 있어요.'}</p>
        <a class="sp-p__btn sp-p__btn--quiet" href="/settings/account">닫기</a>
      </section>
    ) : (
      <>
        {confirm === 'error' && <p class="sp-p__toast sp-p__toast--error" role="alert" tabindex="-1" autofocus>처리하지 못했어요. 다시 눌러 주세요.</p>}
        <form class="sp-p__account-out" method="post" action="/logout">
          <button class="sp-p__btn sp-p__btn--quiet" type="submit">로그아웃</button>
        </form>
        <p class="sp-p__hint">로그아웃해도 사진과 가족은 그대로예요. 탈퇴하면 3일 뒤 모두 지워져요.</p>
        <a class="sp-p__btn sp-p__btn--text sp-p__btn--danger-text" href={`/settings/account?confirm=${planUntil ? 'subscribed' : 'delete'}#confirm`}>탈퇴하기</a>
      </>
    )
  }
</Parent>
