---
// 계정: 로그인 제공자·부모 호칭, 로그아웃. 탈퇴는 다음 이슈
import Parent from '../../layouts/Parent.astro';
import { loadParent, PROVIDER_NAMES } from '../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const provider = PROVIDER_NAMES[a.home.provider ?? ''];
const who = `${a.home.children?.[0]?.name ?? ''} ${a.home.role === 'dad' ? '아빠' : '엄마'}`.trim();
---

<Parent title="계정 · 설정" tab="settings">
  <nav class="sp-p__bar" aria-label="뒤로">
    <a class="sp-p__back" href="/settings"><span aria-hidden="true">‹ </span>설정</a>
  </nav>
  <h1 class="sp-p__title">계정</h1>
  <div class="sp-p__card">
    <p class="sp-p__who-name">{who}</p>
    <p class="sp-p__hint">{provider ? `${provider}로 로그인` : '로그인됨'}</p>
  </div>
  <form class="sp-p__account-out" method="post" action="/logout">
    <button class="sp-p__btn sp-p__btn--quiet" type="submit">로그아웃</button>
  </form>
  <p class="sp-p__hint">로그아웃해도 사진과 가족은 그대로예요. 다시 로그인하면 이어서 쓸 수 있어요.</p>
</Parent>
