---
// 그룹 상세: 이름·새 사진 기본 포함, 비밀번호(힌트)·바꾸기, 주소 보내기, 구성원, 주소 다시 만들기.
// 스크립트가 있으면 주소 보내기·다시 만들기도 이 화면에서(링크 카드를 이 화면에, 다시 만들기는 확인 레이어. 디자인 GroupLinkCard·GroupResetLayer)
import Parent from '../../../../../layouts/Parent.astro';
import AutoSave from '../../../../../components/AutoSave.astro';
import Toast from '../../../../../components/Toast.astro';
import { seenLabel } from '../../../../../lib/age';
import { BackendError, getBackend } from '../../../../../lib/backend';
import { loadParent } from '../../../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const b = getBackend();
const admin = await b.familyAdmin(a.pass);
const g = admin.groups.find((x) => x.id === Astro.params.id);
if (!g) return Astro.redirect('/settings/family/groups');
const here = `/settings/family/groups/${g.id}`;
let name = g.name;
let include = g.include_by_default;
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim();
  include = form.get('include') === '1';
  if (name.length < 1 || name.length > 12) error = '그룹 이름을 1~12자로 써 주세요.';
  else {
    try {
      await b.updateGroup(a.pass, g.id, { name, include_by_default: include });
      return Astro.redirect(`${here}?done=saved`, 303);
    } catch (e) {
      if (!(e instanceof BackendError)) throw e;
      error = e.status === 409 ? '같은 이름의 그룹이 있어요. 다른 이름을 써 주세요.' : '저장하지 못했어요. 다시 눌러 주세요.';
    }
  }
}
const now = Date.now();
const people = admin.members
  .filter((m) => m.group_id === g.id && (m.status === 'active' || (m.status === 'pending' && m.pending_until && Date.parse(m.pending_until) > now)))
  .map((m) => {
    const ds = admin.devices.filter((d) => d.member_id === m.id && d.status === 'active');
    const last = ds.map((d) => d.last_seen_at).sort().at(-1);
    const daysLeft = m.pending_until ? Math.max(1, Math.ceil((Date.parse(m.pending_until) - now) / 86_400_000)) : 0;
    return {
      ...m,
      up: ds.length > 0 && ds.every((d) => d.can_upload),
      note: m.status === 'pending' ? `확인 기다림 · ${daysLeft}일 남음` : last ? seenLabel(last, now) : '아직 안 들어옴',
    };
  });
const done = Astro.url.searchParams.get('done');
const doneText: Record<string, string> = { saved: '저장했어요.', password: '비밀번호를 바꿨어요. 이미 들어온 휴대폰은 그대로 봐요.' };
---

<Parent title={error ? `다시 확인해 주세요 · ${g.name}` : `${g.name} · 그룹`} tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <div class="sp-p__nav">
    <a class="sp-p__back" href="/settings/family/groups">그룹</a>
    <h1 class="sp-p__nav-title">{g.name}</h1>
  </div>
  {done && doneText[done] && <Toast text={doneText[done]} focus />}
  {/* 디자인: 이름 칸 + 한 묶음(기본 포함 체크 · 비밀번호 › · 주소 보내기 ›). 이름·체크는 바꾸면 바로 저장 */}
  <form class="sp-p__form sp-p__form--fit" id="g-form" method="post" data-autosave>
    {error && <p class="sp-p__error" role="alert" id="g-err">{error}</p>}
    <div class="sp-p__field">
      <label class="sp-p__label" for="name">그룹 이름</label>
      <input class="sp-p__input sp-p__input--filled" id="name" name="name" type="text" required maxlength="12" autocomplete="off" value={name} aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'g-err' : undefined} />
    </div>
    <button class="sp-p__btn sp-p__btn--quiet" type="submit" data-autosave-hide>저장</button>
  </form>
  <ul class="sp-p__rows" role="list">
    <li>
      <label class="sp-p__rows-item sp-p__rows-item--check">
        <span class="sp-p__radio-text">
          <span class="sp-p__who-name">새 사진에 기본으로 포함</span>
          <span class="sp-p__hint" id="include-note">사진 올릴 때 이 그룹이 미리 체크돼요</span>
        </span>
        <input class="sp-p__checkbox" type="checkbox" name="include" value="1" form="g-form" checked={include} aria-describedby="include-note" />
      </label>
    </li>
    <li>
      <a class="sp-p__rows-item sp-p__rows-item--link" href={`${here}/password`}>
        <span class="sp-p__radio-text">
          <span class="sp-p__who-name">비밀번호</span>
          <span class="sp-p__hint">{g.password_hint ? `힌트 · ${g.password_hint}` : '힌트 없음'}</span>
        </span>
        <span class="sp-p__chev" aria-hidden="true">›</span>
      </a>
    </li>
    <li>
      <form method="post" action="/settings/family">
        <button class="sp-p__rows-item sp-p__rows-item--link sp-p__rows-button" type="submit" name="do" value={`share:${g.id}`}>
          <span class="sp-p__radio-text">
            <span class="sp-p__who-name">{g.name} 주소 카톡으로 보내기</span>
            <span class="sp-p__hint">새로 들어오는 사람은 보낸 뒤 3일 안에</span>
          </span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </button>
      </form>
    </li>
  </ul>

  <section class="sp-p__section" aria-labelledby="sec-people">
    <h2 class="sp-p__section-title" id="sec-people">구성원 · {people.length}명</h2>
    {people.length === 0 && <p class="sp-p__hint sp-p__empty-note">아직 들어온 사람이 없어요.</p>}
    {
      people.length > 0 && (
        <ul class="sp-p__list">
          {people.map((m) => (
            <li>
              <a class="sp-p__row" href={m.status === 'active' ? `/settings/family/member/${m.id}` : '/settings/family'}>
                <span class="sp-p__row-label">{m.display_name}</span>
                {m.up && <span class="sp-p__tag">올리기</span>}
                <span class="sp-p__row-value">{m.note}</span>
                <span class="sp-p__chev" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <form class="sp-p__account-out" method="post" action="/settings/family">
    <button class="sp-p__btn sp-p__btn--text sp-p__btn--danger-text" type="submit" name="do" value={`reset:${g.id}`} aria-haspopup="dialog" data-ask>주소 다시 만들기 (예전 주소는 바로 막혀요)</button>
  </form>
  {/* 스크립트로 여는 확인(스크립트 없으면 설정 > 가족의 확인 레이어로) */}
  <dialog class="sp-layer__box sp-layer__modal" id="grp-ask" data-autosave-keep aria-labelledby="grp-ask-t" aria-describedby="grp-ask-d">
    <h2 class="sp-layer__title" id="grp-ask-t">{g.name} 주소를 다시 만들까요?</h2>
    <p class="sp-layer__text" id="grp-ask-d">예전 주소는 바로 막히고 새 주소를 만들어요. 이미 들어온 휴대폰은 그대로 봐요. 이 그룹이 같이 들어간 다른 링크도 막혀요.</p>
    <form class="sp-layer__actions" method="post" action="/settings/family">
      <input type="hidden" name="confirm" value="1" />
      <button class="sp-p__btn sp-p__btn--danger-strong" type="submit" name="do" value={`reset:${g.id}`}>다시 만들기</button>
      <button class="sp-p__btn sp-p__btn--quiet" type="submit" formmethod="dialog" value="cancel" autofocus>취소</button>
    </form>
  </dialog>
  <AutoSave />
</Parent>

<script>
  import { revealCopy, wireCopy } from '../../../../../lib/copy';
  // 주소 보내기·다시 만들기를 이 화면에서: 보내고 돌아온 설정 > 가족 화면의 링크 카드(#link)를 가져와 목록 아래에 붙인다.
  // 다시 만들기는 먼저 확인 레이어. 스크립트 없거나 옛 브라우저면 지금처럼 설정 > 가족으로
  const root = document.querySelector<HTMLElement>('.sp-p');
  const first = document.getElementById('grp-ask') as HTMLDialogElement | null;
  if (root && first && typeof first.showModal === 'function') {
    const area: HTMLElement = root;
    let card: Element | null = null;
    let busy = false;
    const place = () => {
      if (!card || card.isConnected) return;
      area.querySelector('.sp-p__rows')?.insertAdjacentElement('afterend', card); // after는 Worker 타입과 겹쳐 타입 검사가 막음
    };
    const say = (text: string, error = false) => {
      const region = document.getElementById(error ? 'as-urgent' : 'as-live');
      if (!region) return;
      region.textContent = '';
      setTimeout(() => (region.textContent = text), 50);
    };
    wireCopy((t) => say(t));
    const toast = (src: Element | null, text: string) => {
      area.querySelector('.sp-toast')?.remove();
      const p = src ? (document.importNode(src, true) as HTMLElement) : document.createElement('p');
      if (!src) {
        p.className = 'sp-toast sp-toast--error';
        p.innerHTML = '<span class="sp-toast__text"></span>';
        p.firstElementChild!.textContent = text;
      }
      p.removeAttribute('role');
      p.removeAttribute('tabindex');
      p.removeAttribute('autofocus');
      area.insertBefore(p, area.firstChild); // prepend는 Worker 타입(HTMLRewriter)과 겹쳐 타입 검사가 막음
      say(p.textContent?.trim() ?? text, p.classList.contains('sp-toast--error'));
    };
    // 확인 레이어는 이름을 저장해 화면이 갈리면 새것(새 이름)이라 그때마다 찾아 붙인다
    const getAsk = () => document.getElementById('grp-ask') as HTMLDialogElement;
    const bind = (ask: HTMLDialogElement) => {
      bound = ask;
      // 어두운 바깥을 누르면 닫기, 연 버튼이 바뀌었으면 새 버튼으로 초점
      ask.addEventListener('click', (e) => {
        if (e.target !== ask) return;
        const r = ask.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) ask.close();
      });
      ask.addEventListener('close', () => {
        if (!document.activeElement || document.activeElement === document.body) area.querySelector<HTMLElement>('[data-ask]')?.focus({ preventScroll: true });
      });
    };
    let bound: HTMLDialogElement = first;
    bind(first);
    // 이름·기본 포함을 저장해 화면이 갈리면 링크 카드를 다시 붙이고 새 확인 레이어를 잇는다
    area.addEventListener('autosave:drawn', () => {
      place();
      // 열려 있던 레이어는 AutoSave가 그대로 두므로 새것일 때만 잇는다
      const ask = getAsk();
      if (ask && ask !== bound) bind(ask);
    });
    document.addEventListener('submit', async (e) => {
      const form = e.target as HTMLFormElement;
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!area.contains(form) || form.method !== 'post' || new URL(form.action).pathname !== '/settings/family' || !btn?.name) return;
      e.preventDefault();
      const ask = getAsk();
      if (btn.hasAttribute('data-ask')) return ask.showModal();
      if (form.closest('dialog') === ask) ask.close();
      if (busy) return; // 보내는 중 두 번 만들지 않게
      busy = true;
      const body = new FormData(form);
      body.append(btn.name, btn.value);
      try {
        const r = await fetch(form.action, { method: 'POST', body, credentials: 'same-origin' });
        if (!r.ok) throw new Error(String(r.status));
        const url = new URL(r.url);
        // 로그인이 끝난 경우 등은 그 화면으로
        if (url.pathname !== '/settings/family') return location.assign(url.href);
        const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
        const next = doc.getElementById('link');
        if (!next) return toast(doc.querySelector('.sp-toast'), '처리하지 못했어요. 다시 눌러 주세요.');
        area.querySelector('.sp-toast')?.remove();
        card?.remove();
        card = document.importNode(next, true);
        place();
        revealCopy(card);
        const title = document.getElementById('link-title');
        title?.focus({ preventScroll: true });
        title?.scrollIntoView({ block: 'nearest' });
        say(title?.textContent?.trim() ?? '');
      } catch {
        toast(null, '처리하지 못했어요. 다시 눌러 주세요.');
      } finally {
        busy = false;
      }
    });
  }
</script>
