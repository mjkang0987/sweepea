---
// 그룹 비밀번호 바꾸기: 새 비밀번호·힌트. 이미 들어온 기기는 그대로
import Parent from '../../../../../layouts/Parent.astro';
import { BackendError, getBackend } from '../../../../../lib/backend';
import { loadParent, pinError } from '../../../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const b = getBackend();
const g = (await b.familyAdmin(a.pass)).groups.find((x) => x.id === Astro.params.id);
if (!g) return Astro.redirect('/settings/family/groups');
let hint = g.password_hint ?? '';
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '').trim();
  hint = String(form.get('hint') ?? '').trim().slice(0, 30);
  error = pinError(password, hint);
  if (!error) {
    try {
      await b.setGroupPassword(a.pass, g.id, password, hint || null);
      return Astro.redirect(`/settings/family/groups/${g.id}?done=password`, 303);
    } catch (e) {
      if (!(e instanceof BackendError)) throw e;
      error = '바꾸지 못했어요. 다시 눌러 주세요.';
    }
  }
}
---

<Parent title={error ? '다시 확인해 주세요 · 비밀번호 바꾸기' : `비밀번호 바꾸기 · ${g.name}`} tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <div class="sp-p__nav">
    <a class="sp-p__back" href={`/settings/family/groups/${g.id}`}>{g.name}</a>
    <h1 class="sp-p__nav-title">비밀번호 바꾸기</h1>
  </div>
  <form class="sp-p__form" method="post">
    {error && <p class="sp-p__error" role="alert" id="pw-err">{error}</p>}
    <div class="sp-p__field">
      <label class="sp-p__label" for="pw">새 비밀번호 (숫자 4자리)</label>
      <input class="sp-p__input sp-p__input--pin" id="pw" name="password" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required autocomplete="off" aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'pw-err' : undefined} />
    </div>
    <div class="sp-p__field">
      <label class="sp-p__label" for="hint">힌트</label>
      <input class="sp-p__input" id="hint" name="hint" type="text" maxlength="30" autocomplete="off" value={hint} aria-describedby="hint-note" />
      <p class="sp-p__hint" id="hint-note">비밀번호를 물을 때 같이 보여요. 비밀번호 자체는 쓰지 마세요.</p>
    </div>
    <p class="sp-p__card sp-p__lead">이미 들어온 휴대폰은 그대로 봐요. 새로 들어올 때만 새 비밀번호를 물어요.</p>
    <div class="sp-p__bottom sp-p__savebar">
      <button class="sp-p__btn" type="submit">저장</button>
    </div>
  </form>
</Parent>
