---
// 구성원 상세: 사진 올리기 허용(이 사람의 승인된 기기에만), 내 가족 아님·내보내기(한 번 더 확인)
import Parent from '../../../../layouts/Parent.astro';
import { getBackend } from '../../../../lib/backend';
import { handleFamilyPost } from '../../../../lib/familyAdmin';
import { loadParent } from '../../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
if (Astro.request.method === 'POST') return Astro.redirect(await handleFamilyPost(Astro.request, Astro.cookies), 303);
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const admin = await getBackend().familyAdmin(a.pass);
const m = admin.members.find((x) => x.id === Astro.params.id && x.status === 'active');
if (!m) return Astro.redirect('/settings/family');
const group = admin.groups.find((g) => g.id === m.group_id)?.name ?? '가족';
const devices = admin.devices.filter((d) => d.member_id === m.id && d.status === 'active');
// 허용은 기기마다라 새 휴대폰은 꺼진 채로 들어온다. 모든 휴대폰이 켜져 있어야 '켜짐'으로 보인다
const canUpload = devices.length > 0 && devices.every((d) => d.can_upload);
const done = Astro.url.searchParams.get('done');
const doneText: Record<string, string> = {
  'upload-on': '이제 사진을 올릴 수 있어요.',
  'upload-off': '사진 올리기를 껐어요.',
  gone: '들어와 있는 휴대폰이 없어요. 휴대폰으로 들어온 뒤에 켤 수 있어요.',
  error: '처리하지 못했어요. 다시 눌러 주세요.',
};
---

<Parent title={`${m.display_name} · 가족`} tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <nav class="sp-p__bar" aria-label="뒤로">
    <a class="sp-p__back" href="/settings/family">가족</a>
  </nav>
  <div class="sp-p__who">
    <span class="sp-p__avatar sp-p__avatar--large" aria-hidden="true">{(m.display_name.split(' ').at(-1) ?? m.display_name).slice(0, 1)}</span>
    <div>
      <h1 class="sp-p__title">{m.display_name}</h1>
      <p class="sp-p__hint">{group} · 휴대폰 {devices.length}대</p>
    </div>
  </div>
  {done && doneText[done] && <p class:list={['sp-p__toast', ['gone', 'error'].includes(done) && 'sp-p__toast--error']} tabindex="-1" autofocus>{doneText[done]}</p>}

  <form class="sp-p__panel" method="post">
    <div class="sp-p__panel-row sp-p__panel-line">
      <span>
        <span class="sp-p__who-name" id="up-label">사진 올리기 허용</span>
        <span class="sp-p__hint sp-p__block" id="up-what">모든 그룹 사진을 보고 올릴 수 있어요. 설정과 승인은 못 해요.</span>
      </span>
      <button class="sp-p__switch" type="submit" name="do" value={`upload:${m.id}:${canUpload ? 'off' : 'on'}`} role="switch" aria-checked={canUpload ? 'true' : 'false'} aria-labelledby="up-label" aria-describedby="up-what up-note" disabled={devices.length === 0}></button>
    </div>
  </form>
  <p class="sp-p__hint" id="up-note">{devices.length === 0 ? '들어와 있는 휴대폰이 없어요. 휴대폰으로 들어온 뒤에 켤 수 있어요.' : '지금 들어와 있는 휴대폰에만 적용돼요. 새 휴대폰으로 들어오면 꺼진 채로 보이니 다시 켜 주세요.'}</p>

  <form class="sp-p__bottom" method="post" action="/settings/family">
    <button class="sp-p__btn sp-p__btn--text sp-p__btn--danger-text" type="submit" name="do" value={`member:${m.id}:rejected`}>내 가족 아님 · 내보내기<span class="sp-vh"> {m.display_name}</span></button>
  </form>
</Parent>
