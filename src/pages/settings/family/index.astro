---
// 설정 > 가족: 승인 기다리는 사람·새 기기, 가족 그룹과 링크 만들기. 폼 POST(PRG), 스크립트가 있으면 페이지 이동 없이 그 자리에서
import Parent from '../../../layouts/Parent.astro';
import Toast from '../../../components/Toast.astro';
import { getBackend } from '../../../lib/backend';
import { handleFamilyPost, LINK_COOKIE, shareUrl, smsHref, summarize } from '../../../lib/familyAdmin';
import { callName } from '../../../lib/ko';
import { loadParent } from '../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
if (Astro.request.method === 'POST') return Astro.redirect(await handleFamilyPost(Astro.request, Astro.cookies), 303);
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const admin = await getBackend().familyAdmin(a.pass);
const s = summarize(admin);
const kid = callName(a.home.children?.[0]?.name ?? '아이');
const q = Astro.url.searchParams;
// 방금 만든 링크(잠깐 쓰는 쿠키, 한 번 보여 주고 지움)
const [linkCode, linkGid] = (Astro.cookies.get(LINK_COOKIE)?.value ?? '').split(':');
Astro.cookies.delete(LINK_COOKIE, { path: '/settings' });
const link = /^[A-Za-z0-9]{8}$/.test(linkCode ?? '') ? shareUrl(Astro.url.origin, linkCode) : null;
const linkGroup = s.groupName(linkGid ?? null);
// 되돌릴 수 없는 동작 확인
const [cKind, cId, cStatus] = (q.get('confirm') ?? '').split(':');
// 확인 레이어 글(서버 레이어·스크립트 레이어 같이 씀)
const deviceName = (d: (typeof s.pendingDevices)[number]) => d.requested_name ?? s.memberName(d.requested_member_id ?? d.member_id) ?? '이름 없는';
const GONE_TEXT = '그 휴대폰은 다시 들어올 수 없어요. 되돌릴 수 없어요.';
const askReject = (name: string) => ({ title: `${name} 거절할까요?`, text: GONE_TEXT, ok: '거절' });
const askRevoke = (name: string) => ({ title: `${name} 휴대폰을 내 가족 아님으로 할까요?`, text: GONE_TEXT, ok: '내 가족 아님' });
const askData = (a: { title: string; text: string; ok: string }) => ({ 'data-ask-title': a.title, 'data-ask-text': a.text, 'data-ask-ok': a.ok, 'aria-haspopup': 'dialog' as const });
const cName =
  cKind === 'member' ? admin.members.find((m) => m.id === cId && m.status !== 'rejected')?.display_name :
  cKind === 'reset' ? admin.groups.find((g) => g.id === cId)?.name :
  cKind === 'device' ? (() => { const d = s.pendingDevices.find((x) => x.id === cId); return d && deviceName(d); })() : undefined;
const cActive = cKind === 'member' && admin.members.some((m) => m.id === cId && m.status === 'active');
const confirmAsk = cName && ((cKind === 'member' && cStatus === 'rejected') || (cKind === 'device' && cStatus === 'revoked') || cKind === 'reset');
const ask = !confirmAsk ? null :
  cKind === 'reset' ? { title: `${cName} 주소를 다시 만들까요?`, text: '예전 주소는 바로 막히고 새 주소를 만들어요. 이미 들어온 휴대폰은 그대로 봐요. 이 그룹이 같이 들어간 다른 링크도 막혀요.', ok: '다시 만들기' } :
  cKind === 'device' ? askRevoke(cName) :
  cActive ? { title: `${cName} 내보낼까요?`, text: '이 사람의 휴대폰은 더 이상 들어올 수 없고, 남긴 반응과 한마디는 가족 화면에서 빠져요. 반응·한마디 기록이 남아 있으면 같은 이름은 다시 쓸 수 없어요. 그룹 비밀번호를 아는 사람이면 다른 이름으로 다시 요청할 수 있지만 승인해야 들어와요.', ok: '내보내기' } :
  askReject(cName);
// 확인하려던 대상이 그새 처리됐으면 '이미 처리됨'으로
const done = q.get('done') ?? (q.get('confirm') ? 'pending-check' : null);
const shownDone = done === 'pending-check' ? (confirmAsk ? null : 'gone') : done;
const doneText: Record<string, string> = {
  'member-active': '승인했어요. 이제 가족 앨범을 다 볼 수 있어요.',
  'member-rejected': '처리했어요. 그 사람의 휴대폰은 이제 들어올 수 없어요.',
  'device-active': '승인했어요.',
  'device-revoked': '내 가족이 아니라고 표시했어요. 그 휴대폰은 들어올 수 없어요.',
  gone: '이미 처리됐거나 기간이 지난 요청이에요.',
  conflict: '같은 이름이 승인을 기다리고 있거나 그 이름이 없어졌어요. 먼저 그 이름을 정리해 주세요.',
  error: '처리하지 못했어요. 다시 눌러 주세요.',
};
const when = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Seoul' });
const groupMembers = (gid: string) => admin.members.filter((m) => m.group_id === gid && m.status === 'active');
---

<Parent title="가족 · 설정" tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <div class="sp-p__nav">
    <a class="sp-p__back" href="/settings">설정</a>
    <h1 class="sp-p__nav-title">가족</h1>
  </div>
  {shownDone && doneText[shownDone] && <Toast text={doneText[shownDone]} tone={['error', 'gone', 'conflict'].includes(shownDone) ? 'error' : 'ok'} focus />}
  {/* 스크립트로 바꾼 결과를 읽어 주는 늘 있는 알림 칸 */}
  <p class="sp-vh" id="fam-live" role="status"></p>
  <p class="sp-vh" id="fam-urgent" role="alert"></p>
  {/* 되돌릴 수 없는 동작 확인(디자인 FamilyRejectLayer·FamilyRevokeLayer). 스크립트가 없을 때 ?confirm=으로 연 채 그린다 */}
  {
    ask && (
      <div class="sp-layer" id="confirm" data-cancel={cKind === 'reset' ? `/settings/family/groups/${cId}` : cActive ? `/settings/family/member/${cId}` : '/settings/family'}>
        <div class="sp-layer__scrim" aria-hidden="true"></div>
        <dialog class="sp-layer__box" open aria-labelledby="confirm-t" aria-describedby="confirm-d">
          <h2 class="sp-layer__title" id="confirm-t">{ask.title}</h2>
          <p class="sp-layer__text" id="confirm-d">{ask.text}</p>
          <form class="sp-layer__actions" method="post" action="/settings/family">
            <input type="hidden" name="confirm" value="1" />
            <button class="sp-p__btn sp-p__btn--danger-strong" type="submit" name="do" value={q.get('confirm')}>{ask.ok}</button>
            <a class="sp-p__btn sp-p__btn--quiet" href={cKind === 'reset' ? `/settings/family/groups/${cId}` : cActive ? `/settings/family/member/${cId}` : '/settings/family'} autofocus>취소</a>
          </form>
        </dialog>
      </div>
    )
  }
  {/* 스크립트로 여는 확인 레이어: 누른 버튼의 data-ask-* 글로 채운다. 취소는 브라우저 기본(method=dialog) */}
  <dialog class="sp-layer__box sp-layer__modal" id="fam-ask" aria-labelledby="ask-t" aria-describedby="ask-d">
    <h2 class="sp-layer__title" id="ask-t"></h2>
    <p class="sp-layer__text" id="ask-d"></p>
    <form class="sp-layer__actions" method="post" action="/settings/family">
      <input type="hidden" name="confirm" value="1" />
      <button class="sp-p__btn sp-p__btn--danger-strong" type="submit" name="do" value=""></button>
      <button class="sp-p__btn sp-p__btn--quiet" type="submit" formmethod="dialog" value="cancel" autofocus>취소</button>
    </form>
  </dialog>

  <a class="sp-p__cta" href="/settings/family/sms">
    <span class="sp-p__cta-title">문자로 공유하기</span>
    <span class="sp-p__cta-sub">조부모 폰 홈 화면에 스위피 두기 · 처음 한 번만</span>
    <span class="sp-p__chev" aria-hidden="true">›</span>
  </a>

  {
    link && (
      <section class="sp-p__card" id="link" aria-labelledby="link-title">
        <h2 class="sp-p__card-title" id="link-title" tabindex="-1">{linkGroup} 링크를 만들었어요</h2>
        <label class="sp-p__label" for="link-url">주소</label>
        <input class="sp-p__input" id="link-url" type="url" readonly value={link} />
        <a class="sp-p__btn" href={smsHref(`${kid} 사진 보시라고 주소 보내요. 누르면 바로 볼 수 있어요.\n${link}`)}>문자로 보내기</a>
        <button class="sp-p__btn sp-p__btn--quiet" type="button" data-copy="link-url" hidden>주소 복사</button>
        <p class="sp-p__hint">3일 안에는 새 이름으로도 들어올 수 있어요. 이미 등록된 이름은 언제든 들어와요.</p>
      </section>
    )
  }

  <section class="sp-p__section" aria-labelledby="sec-wait">
    <h2 class="sp-p__section-title" id="sec-wait" tabindex="-1">승인 기다리는 사람 · {s.pendingMembers.length}</h2>
    {s.pendingMembers.length === 0 && <p class="sp-p__hint sp-p__empty-note">지금은 없어요.</p>}
    {
      s.pendingMembers.map((m) => (
        <article class="sp-p__card" aria-labelledby={`pm-${m.id}`}>
          <div class="sp-p__who">
            <span class="sp-p__avatar" aria-hidden="true">{m.display_name.slice(0, 1)}</span>
            <div>
              <h3 class="sp-p__who-name" id={`pm-${m.id}`}>{m.display_name}</h3>
              <p class="sp-p__hint">{s.groupName(m.group_id)} 링크로 직접 입력 · {when.format(new Date(m.created_at))}</p>
            </div>
          </div>
          <p class="sp-p__lead">승인 전에는 받은 사진만 볼 수 있어요. 3일 안에 승인하지 않으면 자동으로 취소돼요.</p>
          <form class="sp-p__pair" method="post" action="/settings/family">
            <button class="sp-p__btn sp-p__btn--quiet" type="submit" name="do" value={`member:${m.id}:rejected`} {...askData(askReject(m.display_name))}>거절<span class="sp-vh"> {m.display_name}</span></button>
            <button class="sp-p__btn" type="submit" name="do" value={`member:${m.id}:active`}>{s.groupName(m.group_id) === '가족' ? '' : `${s.groupName(m.group_id)} 가족으로 `}승인<span class="sp-vh"> {m.display_name}</span></button>
          </form>
        </article>
      ))
    }
  </section>

  {
    s.pendingDevices.length > 0 && (
      <section class="sp-p__section" aria-labelledby="sec-dev">
        <h2 class="sp-p__section-title" id="sec-dev" tabindex="-1">새로 들어온 기기 · {s.pendingDevices.length}</h2>
        {s.pendingDevices.map((d) => {
          const name = d.requested_name ?? s.memberName(d.requested_member_id ?? d.member_id) ?? '이름 없음';
          return (
            <article class="sp-p__card" aria-labelledby={`pd-${d.id}`}>
              <h3 class="sp-p__who-name" id={`pd-${d.id}`}>{name} · 새 휴대폰</h3>
              <p class="sp-p__hint">확인을 기다리는 새 휴대폰이에요 · {when.format(new Date(d.created_at))}</p>
              <form class="sp-p__pair" method="post" action="/settings/family">
                <button class="sp-p__btn sp-p__btn--danger" type="submit" name="do" value={`device:${d.id}:revoked`} {...askData(askRevoke(deviceName(d)))}>내 가족 아님<span class="sp-vh"> {name}</span></button>
                <button class="sp-p__btn" type="submit" name="do" value={`device:${d.id}:active`}>승인<span class="sp-vh"> {name}</span></button>
              </form>
            </article>
          );
        })}
      </section>
    )
  }

  <section class="sp-p__section" aria-labelledby="sec-groups">
    <div class="sp-p__group-head">
      <h2 class="sp-p__section-title" id="sec-groups"><a class="sp-p__section-link" href="/settings/family/groups">가족 그룹<span class="sp-vh"> 관리</span><svg class="sp-p__icon-chev" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg></a></h2>
    </div>
    <ul class="sp-p__list">
      {
        admin.groups.map((g) => (
          <li class="sp-p__group">
            <div class="sp-p__group-head">
              <h3 class="sp-p__who-name">{g.name}</h3>
              <form method="post" action="/settings/family">
                <button class="sp-p__chip" type="submit" name="do" value={`share:${g.id}`}>링크 만들기<span class="sp-vh"> ({g.name})</span></button>
              </form>
            </div>
            {groupMembers(g.id).length === 0 ? (
              <p class="sp-p__hint">아직 들어온 사람이 없어요</p>
            ) : (
              <ul class="sp-p__members">
                {groupMembers(g.id).map((m) => {
                  const mine = admin.devices.filter((d) => d.member_id === m.id && d.status === 'active');
                  const up = mine.length > 0 && mine.every((d) => d.can_upload);
                  return (
                    <li>
                      <a class="sp-p__member" href={`/settings/family/member/${m.id}`}>
                        <span class="sp-p__row-label">{m.display_name}</span>
                        {up && <span class="sp-p__tag">올리기</span>}
                        <span class="sp-p__chev" aria-hidden="true">›</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Parent>

<script>
  import { wireCopy } from '../../../lib/copy';
  wireCopy((t) => {
    const live = document.getElementById('fam-live');
    if (live) live.textContent = t;
  });
</script>

<script>
  import { revealCopy } from '../../../lib/copy';
  // 그 자리에서: 이 화면 폼은 fetch로 보내고 돌아온 화면의 내용·탭 배지만 갈아 끼운다(하얀 깜빡임·스크롤 처음으로 없이).
  // 거절·내 가족 아님은 먼저 확인 레이어. 스크립트가 없거나 옛 브라우저면 지금처럼 폼 → 페이지 이동
  const root = document.querySelector<HTMLElement>('.sp-p');
  const live = document.getElementById('fam-live');
  const urgent = document.getElementById('fam-urgent');
  const box = document.getElementById('fam-ask') as HTMLDialogElement | null;
  if (root && live && urgent && box && typeof box.showModal === 'function') {
    const area: HTMLElement = root;
    const ask: HTMLDialogElement = box;
    let queue = Promise.resolve();
    let focusId = '';
    let pending = 0;
    // 뒤 요청을 기다리느라 그리지 않은 응답(뒤 요청이 실패하면 이걸 그린다)
    let skipped = '';
    // 새로 그린 토스트는 늘 있는 알림 칸으로 읽힌다(새로 넣은 role 요소는 화면 읽기가 놓칠 수 있어서)
    const say = (t: Element | null) => {
      if (!t) return;
      t.removeAttribute('role');
      const region = t.classList.contains('sp-toast--error') ? urgent : live;
      region.textContent = '';
      setTimeout(() => (region.textContent = t.textContent?.trim() ?? ''), 50);
    };
    const fail = () => {
      area.querySelector('.sp-toast')?.remove();
      const p = document.createElement('p');
      p.className = 'sp-toast sp-toast--error';
      p.innerHTML = '<span class="sp-toast__text">처리하지 못했어요. 다시 눌러 주세요.</span>';
      area.insertBefore(p, area.firstChild); // prepend는 Worker 타입(HTMLRewriter)과 겹쳐 타입 검사가 막음
      say(p);
    };
    const openAsk = (title: string, text: string, ok: string, value: string, cancel = '') => {
      ask.querySelector('#ask-t')!.textContent = title;
      ask.querySelector('#ask-d')!.textContent = text;
      const b = ask.querySelector<HTMLButtonElement>('button[name="do"]')!;
      b.value = value;
      b.textContent = ok;
      ask.dataset.cancel = cancel;
      ask.showModal();
    };
    // 결과 안내가 붙은 주소(?done=)는 떼어 새로 고침해도 다시 뜨지 않게
    if (new URLSearchParams(location.search).has('done')) history.replaceState(history.state, '', location.pathname);
    // 다른 화면(구성원 내보내기·그룹 주소 다시 만들기)에서 ?confirm=으로 온 확인은 같은 모달로 올린다(Esc·초점 가두기). 취소하면 원래 화면으로
    const server = area.querySelector<HTMLElement>('#confirm');
    if (server) {
      const go = server.querySelector<HTMLButtonElement>('button[name="do"]')!;
      openAsk(server.querySelector('#confirm-t')?.textContent ?? '', server.querySelector('#confirm-d')?.textContent ?? '', go.textContent ?? '', go.value, server.dataset.cancel);
      server.remove();
    }
    ask.addEventListener('close', () => {
      const back = ask.dataset.cancel;
      ask.dataset.cancel = '';
      if (back) return location.assign(back);
      // 레이어를 연 버튼이 그새 새 화면으로 바뀌었으면 같은 일을 하는 새 버튼(없으면 그 칸 제목)으로 초점을 돌려준다
      if (document.activeElement && document.activeElement !== document.body) return;
      const v = ask.querySelector<HTMLButtonElement>('button[name="do"]')!.value;
      const to = [...area.querySelectorAll<HTMLButtonElement>('button[name="do"]')].find((x) => x.value === v && !ask.contains(x)) ?? document.getElementById(focusId);
      to?.focus({ preventScroll: true });
    });
    // 어두운 바깥을 누르면 닫기(사진 지우기 레이어와 같게)
    ask.addEventListener('click', (e) => {
      if (e.target !== ask) return;
      const r = ask.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) ask.close();
    });
    const draw = (html: string, want: string) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const from = doc.querySelector('.sp-p');
      if (!from) return location.reload();
      // 알림 칸·확인 레이어는 그대로 둔다(열려 있는 확인 레이어가 사라지지 않게)
      const keep = new Set(['fam-live', 'fam-urgent', 'fam-ask']);
      area.replaceChildren(...[...from.childNodes].filter((n) => !(n instanceof Element && keep.has(n.id))).map((n) => document.importNode(n, true)), live, urgent, ask);
      area.removeAttribute('aria-busy');
      revealCopy(area);
      // ?confirm=·?done=을 떼어 새로 고침해도 확인·안내가 다시 뜨지 않게
      if (location.search) history.replaceState(history.state, '', location.pathname);
      const tabs = doc.querySelector('.sp-p__tabs');
      if (tabs) document.querySelector('.sp-p__tabs')?.replaceWith(document.importNode(tabs, true));
      // 확인 레이어를 새로 열어 둔 동안은 초점을 건드리지 않는다
      if (!ask.open) {
        const target = document.getElementById(want) ?? area.querySelector<HTMLElement>('.sp-p__nav-title');
        if (target && !target.hasAttribute('tabindex') && !target.matches('a, button')) target.tabIndex = -1;
        target?.focus({ preventScroll: true });
      }
      say(area.querySelector('.sp-toast'));
    };
    document.addEventListener('submit', (e) => {
      const form = e.target as HTMLFormElement;
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!area.contains(form) || form.method !== 'post' || new URL(form.action).pathname !== '/settings/family') return;
      // 누른 버튼을 모르는 옛 브라우저는 원래대로(버튼 값이 곧 할 일)
      if (!btn?.name) return;
      if (btn.dataset.askTitle) {
        e.preventDefault();
        focusId = btn.closest('section')?.querySelector('h2')?.id ?? '';
        openAsk(btn.dataset.askTitle, btn.dataset.askText ?? '', btn.dataset.askOk ?? '', btn.value);
        return;
      }
      e.preventDefault();
      const body = new FormData(form);
      body.append(btn.name, btn.value);
      // 링크를 만들면(다시 만들기 포함) 새 링크 카드로, 확인 레이어에서 보냈으면 레이어를 연 버튼의 칸으로, 아니면 누른 버튼의 칸으로
      const fromAsk = form.closest('dialog') === ask;
      if (fromAsk) {
        ask.dataset.cancel = '';
        ask.close();
      } else focusId = btn.closest('section')?.querySelector('h2')?.id ?? '';
      const want = /^(share|reset):/.test(btn.value) ? 'link-title' : focusId;
      live.textContent = '';
      urgent.textContent = '';
      btn.disabled = true; // 보내는 중 두 번 누르지 않게(응답이 새 화면으로 바꾼다)
      area.setAttribute('aria-busy', 'true');
      pending++;
      queue = queue.then(async () => {
        let html = '';
        let url: URL;
        try {
          const r = await fetch(form.action, { method: 'POST', body, credentials: 'same-origin' });
          if (!r.ok) throw new Error(String(r.status));
          url = new URL(r.url);
          html = await r.text();
        } catch {
          pending--;
          btn.disabled = false;
          if (!pending) {
            // 앞 요청이 성공했는데 그리지 않았으면 그 화면을 먼저 그린다(처리된 카드가 남지 않게)
            if (skipped) draw(skipped, want);
            else area.removeAttribute('aria-busy');
            skipped = '';
            if (!fromAsk && btn.isConnected) btn.focus({ preventScroll: true });
          }
          return fail();
        }
        // 로그인이 끝나 다른 화면이 온 경우 등은 그 화면으로
        if (url.pathname !== '/settings/family') return location.assign(url.href);
        // 뒤에 누른 게 있으면 그리지 않는다(마지막 응답이 최신 화면을 그림)
        if (--pending) return void (skipped = html);
        skipped = '';
        draw(html, want);
      });
      queue = queue.catch(() => location.reload());
    });
  }
</script>
