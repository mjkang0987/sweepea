---
// 설정 > 가족: 승인 기다리는 사람·새 기기, 가족 그룹과 링크 만들기. JS 없이 폼 POST(PRG)
import Parent from '../../../layouts/Parent.astro';
import { getBackend } from '../../../lib/backend';
import { handleFamilyPost, LINK_COOKIE, shareUrl, smsHref, summarize } from '../../../lib/familyAdmin';
import { callName } from '../../../lib/ko';
import { loadParent } from '../../../lib/parent';

Astro.response.headers.set('cache-control', 'private, no-store');
if (Astro.request.method === 'POST') return Astro.redirect(await handleFamilyPost(Astro.request, Astro.cookies), 303);
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const admin = await getBackend().familyAdmin(a.pass);
const s = summarize(admin);
const kid = callName(a.home.children?.[0]?.name ?? '아이');
const q = Astro.url.searchParams;
// 방금 만든 링크(잠깐 쓰는 쿠키, 한 번 보여 주고 지움)
const [linkCode, linkGid] = (Astro.cookies.get(LINK_COOKIE)?.value ?? '').split(':');
Astro.cookies.delete(LINK_COOKIE, { path: '/settings' });
const link = /^[A-Za-z0-9]{8}$/.test(linkCode ?? '') ? shareUrl(Astro.url.origin, linkCode) : null;
const linkGroup = s.groupName(linkGid ?? null);
// 되돌릴 수 없는 동작 확인
const [cKind, cId, cStatus] = (q.get('confirm') ?? '').split(':');
const cName =
  cKind === 'member' ? admin.members.find((m) => m.id === cId && m.status !== 'rejected')?.display_name :
  cKind === 'device' ? (() => { const d = s.pendingDevices.find((x) => x.id === cId); return d && (d.requested_name ?? s.memberName(d.requested_member_id ?? d.member_id) ?? '새 휴대폰'); })() : undefined;
const confirmAsk = cName && ((cKind === 'member' && cStatus === 'rejected') || (cKind === 'device' && cStatus === 'revoked'));
// 확인하려던 대상이 그새 처리됐으면 '이미 처리됨'으로
const done = q.get('done') ?? (q.get('confirm') ? 'pending-check' : null);
const shownDone = done === 'pending-check' ? (confirmAsk ? null : 'gone') : done;
const doneText: Record<string, string> = {
  'member-active': '승인했어요. 이제 가족 앨범을 다 볼 수 있어요.',
  'member-rejected': '내보냈어요. 그 사람의 휴대폰은 다시 들어올 수 없어요.',
  'device-active': '승인했어요.',
  'device-revoked': '내 가족이 아니라고 표시했어요. 그 휴대폰은 들어올 수 없어요.',
  gone: '이미 처리됐거나 기간이 지난 요청이에요.',
  conflict: '같은 이름이 승인을 기다리고 있거나 그 이름이 없어졌어요. 먼저 그 이름을 정리해 주세요.',
  error: '처리하지 못했어요. 다시 눌러 주세요.',
};
const when = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Seoul' });
const groupMembers = (gid: string) => admin.members.filter((m) => m.group_id === gid && m.status === 'active');
---

<Parent title="가족 · 설정" tab="settings">
  <nav class="sp-p__bar" aria-label="뒤로">
    <a class="sp-p__back" href="/settings"><span aria-hidden="true">‹ </span>설정</a>
  </nav>
  <h1 class="sp-p__title">가족</h1>
  {/* 결과는 페이지가 열릴 때 바로 읽히게 초점을 옮긴다(JS 없이 autofocus) */}
  {shownDone && doneText[shownDone] && <p class:list={['sp-p__toast', ['error', 'gone', 'conflict'].includes(shownDone) && 'sp-p__toast--error']} tabindex="-1" autofocus>{doneText[shownDone]}</p>}
  {
    confirmAsk && (
      <section class="sp-p__card sp-p__card--warn" id="confirm" aria-labelledby="confirm-title">
        <h2 class="sp-p__card-title" id="confirm-title" tabindex="-1" autofocus>{cKind === 'member' ? `${cName} 거절할까요?` : `${cName} 휴대폰을 내 가족 아님으로 할까요?`}</h2>
        <p class="sp-p__lead">그 휴대폰은 다시 들어올 수 없어요. 되돌릴 수 없어요.</p>
        <form class="sp-p__pair" method="post" action="/settings/family">
          <a class="sp-p__btn sp-p__btn--quiet" href="/settings/family">취소</a>
          <input type="hidden" name="confirm" value="1" />
          <button class="sp-p__btn sp-p__btn--danger-strong" type="submit" name="do" value={q.get('confirm')}>{cKind === 'member' ? '거절' : '내 가족 아님'}</button>
        </form>
      </section>
    )
  }

  <a class="sp-p__cta" href="/settings/family/sms">
    <span class="sp-p__cta-title">문자로 공유하기</span>
    <span class="sp-p__cta-sub">조부모 폰 홈 화면에 스위피 두기 · 처음 한 번만</span>
    <span class="sp-p__chev" aria-hidden="true">›</span>
  </a>

  {
    link && (
      <section class="sp-p__card" id="link" aria-labelledby="link-title">
        <h2 class="sp-p__card-title" id="link-title">{linkGroup} 링크를 만들었어요</h2>
        <label class="sp-p__label" for="link-url">주소(길게 눌러 복사)</label>
        <input class="sp-p__input" id="link-url" type="url" readonly value={link} />
        <a class="sp-p__btn" href={smsHref(`${kid} 사진 보시라고 주소 보내요. 누르면 바로 볼 수 있어요.\n${link}`)}>문자로 보내기</a>
        <p class="sp-p__hint">3일 안에는 새 이름으로도 들어올 수 있어요. 이미 등록된 이름은 언제든 들어와요.</p>
      </section>
    )
  }

  <section class="sp-p__section" aria-labelledby="sec-wait">
    <h2 class="sp-p__section-title" id="sec-wait">승인 기다리는 사람 · {s.pendingMembers.length}</h2>
    {s.pendingMembers.length === 0 && <p class="sp-p__hint sp-p__empty-note">지금은 없어요.</p>}
    {
      s.pendingMembers.map((m) => (
        <article class="sp-p__card" aria-labelledby={`pm-${m.id}`}>
          <div class="sp-p__who">
            <span class="sp-p__avatar" aria-hidden="true">{m.display_name.slice(0, 1)}</span>
            <div>
              <h3 class="sp-p__who-name" id={`pm-${m.id}`}>{m.display_name}</h3>
              <p class="sp-p__hint">{s.groupName(m.group_id)} 링크로 직접 입력 · {when.format(new Date(m.created_at))}</p>
            </div>
          </div>
          <p class="sp-p__lead">승인 전에는 받은 사진만 볼 수 있어요. 3일 안에 승인하지 않으면 자동으로 취소돼요.</p>
          <form class="sp-p__pair" method="post" action="/settings/family">
            <button class="sp-p__btn sp-p__btn--quiet" type="submit" name="do" value={`member:${m.id}:rejected`}>거절<span class="sp-vh"> {m.display_name}</span></button>
            <button class="sp-p__btn" type="submit" name="do" value={`member:${m.id}:active`}>{s.groupName(m.group_id) === '가족' ? '' : `${s.groupName(m.group_id)} 가족으로 `}승인<span class="sp-vh"> {m.display_name}</span></button>
          </form>
        </article>
      ))
    }
  </section>

  {
    s.pendingDevices.length > 0 && (
      <section class="sp-p__section" aria-labelledby="sec-dev">
        <h2 class="sp-p__section-title" id="sec-dev">새로 들어온 기기 · {s.pendingDevices.length}</h2>
        {s.pendingDevices.map((d) => {
          const name = d.requested_name ?? s.memberName(d.requested_member_id ?? d.member_id) ?? '이름 없음';
          return (
            <article class="sp-p__card" aria-labelledby={`pd-${d.id}`}>
              <h3 class="sp-p__who-name" id={`pd-${d.id}`}>{name} · 새 휴대폰</h3>
              <p class="sp-p__hint">확인을 기다리는 새 휴대폰이에요 · {when.format(new Date(d.created_at))}</p>
              <form class="sp-p__pair" method="post" action="/settings/family">
                <button class="sp-p__btn sp-p__btn--danger" type="submit" name="do" value={`device:${d.id}:revoked`}>내 가족 아님<span class="sp-vh"> {name}</span></button>
                <button class="sp-p__btn" type="submit" name="do" value={`device:${d.id}:active`}>승인<span class="sp-vh"> {name}</span></button>
              </form>
            </article>
          );
        })}
      </section>
    )
  }

  <section class="sp-p__section" aria-labelledby="sec-groups">
    <h2 class="sp-p__section-title" id="sec-groups">가족 그룹</h2>
    <ul class="sp-p__list">
      {
        admin.groups.map((g) => (
          <li class="sp-p__group">
            <div class="sp-p__group-head">
              <h3 class="sp-p__who-name">{g.name}</h3>
              <form method="post" action="/settings/family">
                <button class="sp-p__chip" type="submit" name="do" value={`share:${g.id}`}>링크 만들기<span class="sp-vh"> ({g.name})</span></button>
              </form>
            </div>
            {groupMembers(g.id).length === 0 ? (
              <p class="sp-p__hint">아직 들어온 사람이 없어요</p>
            ) : (
              <ul class="sp-p__members">
                {groupMembers(g.id).map((m) => {
                  const up = admin.devices.some((d) => d.member_id === m.id && d.status === 'active' && d.can_upload);
                  return (
                    <li>
                      <a class="sp-p__member" href={`/settings/family/member/${m.id}`}>
                        <span class="sp-p__row-label">{m.display_name}</span>
                        {up && <span class="sp-p__tag">올리기</span>}
                        <span class="sp-p__chev" aria-hidden="true">›</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Parent>
