---
// 설정: 가족, 가족도 사진 저장하기, 저장 용량, 로그아웃. 아이·글자 크기·계정은 다음 이슈
import Parent from '../../layouts/Parent.astro';
import { getBackend } from '../../lib/backend';
import { handleFamilyPost, sizeLabel, summarize } from '../../lib/familyAdmin';
import { loadParent, PROVIDER_NAMES } from '../../lib/parent';
import { version } from '../../../package.json';

Astro.response.headers.set('cache-control', 'private, no-store');
if (Astro.request.method === 'POST') return Astro.redirect(await handleFamilyPost(Astro.request, Astro.cookies), 303);
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const admin = await getBackend().familyAdmin(a.pass);
const s = summarize(admin);
const h = a.home;
const allowed = !!h.download_allowed;
const used = sizeLabel(h.storage_used_bytes ?? 0);
const kids = (h.children ?? []).map((c) => c.name).join(', ');
const SIZE_LABEL = { relation: '관계에 맞춰', base: '모두 기본', large: '모두 크게', xlarge: '모두 아주 크게' };
const done = Astro.url.searchParams.get('done');
const doneText: Record<string, string> = {
  'download-on': '이제 가족 화면에 저장 버튼이 보여요.',
  'download-off': '가족 사진 저장을 껐어요.',
  gone: '가족방을 찾지 못했어요. 새로 고친 뒤 다시 눌러 주세요.',
  error: '처리하지 못했어요. 다시 눌러 주세요.',
};
---

<Parent title="설정 · 스위피" tab="settings" alerts={a.home.new_activity ?? 0} waiting={a.home.waiting ?? 0}>
  <h1 class="sp-p__title sp-p__title--large">설정</h1>
  {done && doneText[done] && <p class:list={['sp-p__toast', ['error', 'gone'].includes(done) && 'sp-p__toast--error']} tabindex="-1" autofocus>{doneText[done]}</p>}
  <section class="sp-p__section" aria-labelledby="sec-family">
    <h2 class="sp-p__section-title" id="sec-family">가족과 아이</h2>
    <ul class="sp-p__list">
      <li>
        <a class="sp-p__row" href="/settings/family">
          <span class="sp-p__row-label">가족</span>
          <span class="sp-p__row-value">
            {s.waiting > 0 && <span class="sp-p__badge">승인 {s.waiting}</span>}
            그룹 {admin.groups.length} · 기기 {s.activeDevices}
          </span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </a>
      </li>
      <li>
        <a class="sp-p__row" href="/settings/children">
          <span class="sp-p__row-label">아이</span>
          <span class="sp-p__row-value">{kids}</span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </a>
      </li>
    </ul>
  </section>
  <section class="sp-p__section" aria-labelledby="sec-share">
    <h2 class="sp-p__section-title" id="sec-share">보기와 공유</h2>
    <ul class="sp-p__list sp-p__list--gap">
      <li>
        <a class="sp-p__row" href="/settings/text-size">
          <span class="sp-p__row-label">가족 화면 글자 크기</span>
          <span class="sp-p__row-value">{SIZE_LABEL[h.text_size_mode ?? 'relation']}</span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </a>
      </li>
    </ul>
    <form class="sp-p__panel" method="post">
      <div class="sp-p__panel-row sp-p__panel-line">
        <span>
          <span class="sp-p__who-name" id="dl-label">가족도 사진 저장하기</span>
          <span class="sp-p__hint sp-p__block" id="dl-what">크게 보기 화면에 저장 버튼이 생겨요. 끄면 버튼만 사라지고, 화면에 보이는 사진을 길게 눌러 저장하는 건 막지 못해요.</span>
        </span>
        <button class="sp-p__switch" type="submit" name="do" value={`download:${h.family_id}:${allowed ? 'off' : 'on'}`} role="switch" aria-checked={allowed ? 'true' : 'false'} aria-labelledby="dl-label" aria-describedby="dl-what"></button>
      </div>
    </form>
  </section>
  <section class="sp-p__section" aria-labelledby="sec-account">
    <h2 class="sp-p__section-title" id="sec-account">계정</h2>
    <ul class="sp-p__list">
      <li>
        <a class="sp-p__row" href="/settings/account">
          <span class="sp-p__row-label">{PROVIDER_NAMES[h.provider ?? ''] ?? '로그인'} 계정</span>
          <span class="sp-p__row-value">{`${h.children?.[0]?.name ?? ''} ${h.role === 'dad' ? '아빠' : '엄마'}`.trim()}</span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </a>
      </li>
      <li>
        <a class="sp-p__row" href="/settings/storage">
          <span class="sp-p__row-label">저장 용량</span>
          <span class="sp-p__row-value">{used} / 5GB</span>
          <span class="sp-p__chev" aria-hidden="true">›</span>
        </a>
      </li>
    </ul>
  </section>
  <p class="sp-p__version">스위피 {version}</p>
</Parent>
