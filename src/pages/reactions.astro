---
// 부모 최근 반응: 승인된 가족이 남긴 반응·한마디만(새 것 먼저). 승인 대기·설치 부탁은 앨범 위 띠. 열면 '새 반응'을 읽음으로
import Parent from '../layouts/Parent.astro';
import { agoLabel } from '../lib/age';
import { getBackend } from '../lib/backend';
import { EMOJI } from '../lib/emoji';
import { hasBatchim } from '../lib/ko';
import { loadParent } from '../lib/parent';
import { signedMediaUrl } from '../lib/signed';

Astro.response.headers.set('cache-control', 'private, no-store');
const a = await loadParent(Astro.cookies);
if ('redirect' in a) return Astro.redirect(a.redirect);
const b = getBackend();
const act = await b.parentActivity(a.pass);
const now = Date.now();
const rows = await Promise.all(
  (act?.items ?? []).map(async (x) => ({
    ...x,
    isNew: act ? Date.parse(x.at) > Date.parse(act.seen_at) : false,
    thumb: x.thumb_key ? await signedMediaUrl(x.thumb_key) : null,
    text: x.type === 'comment' ? `"${x.body}"` : (() => { const l = x.kind ? EMOJI[x.kind].label : '반응'; return `${l}${hasBatchim(l) ? '을' : '를'} 보냈어요`; })(),
  })),
);
// 다 그린 뒤에 읽음 표시(읽은 시각까지만)
if (act) await b.markActivitySeen(a.pass, act.read_at);
const fresh = rows.filter((r) => r.isNew);
const old = rows.filter((r) => !r.isNew);
---

<Parent title="알림 · 스위피" tab="alerts" alerts={0} waiting={a.home.waiting ?? 0}>
  <h1 class="sp-p__title sp-p__title--large">알림</h1>
  <p class="sp-p__lead">가족이 남긴 하트와 말이에요. 앱이 나오면 알림으로도 알려 드릴게요.</p>
  {
    [
      { id: 'sec-new', title: `새 반응 · ${fresh.length}`, list: fresh },
      { id: 'sec-old', title: '지난 반응', list: old },
    ]
      .filter((g) => g.list.length > 0)
      .map((g) => (
        <section class="sp-p__section" aria-labelledby={g.id}>
          <h2 class="sp-p__section-title" id={g.id}>{g.title}</h2>
          <ul class="sp-p__list">
            {g.list.map((r) => (
              <li>
                <a class="sp-p__row sp-p__row--tall" href={`/photo/${r.media_id}`}>
                  {r.thumb ? <img class="sp-p__thumb" src={r.thumb} alt="" width="48" height="48" loading="lazy" /> : <span class="sp-p__thumb" aria-hidden="true"></span>}
                  <span class="sp-p__row-label sp-p__radio-text">
                    <span><strong>{r.who}</strong> {r.text}</span>
                    <span class="sp-p__hint">{agoLabel(r.at, now)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
  {rows.length === 0 && <p class="sp-p__note">아직 반응이 없어요. 사진을 올리고 카톡으로 보내 보세요.</p>}
</Parent>
